#version 460
#extension GL_GOOGLE_include_directive : require

// Bloom and soft glow: the bright pass the denoiser's final pass wrote, and the finished frame
// it left in the filter image, are blurred at quarter resolution with a separable Gaussian,
// horizontally in pass 0 straight from the full-resolution sources, then vertically in pass 1.

layout(local_size_x = 8, local_size_y = 8) in;

#include "frame.glsl"
layout(push_constant) uniform Push {
  int pass;
  int step;
  int last;
  int passes;
} pc;
layout(set = 0, binding = 17, rgba16f) uniform readonly image2D filterA;
layout(set = 0, binding = 18, rgba16f) uniform readonly image2D filterB;
layout(set = 0, binding = 28, rgba16f) uniform readonly image2D bloomSource;
layout(set = 0, binding = 29, rgba16f) uniform image2D bloomA;
layout(set = 0, binding = 30, rgba16f) uniform image2D bloomB;
layout(set = 0, binding = 34, rgba16f) uniform image2D diffuseA;
layout(set = 0, binding = 35, rgba16f) uniform image2D diffuseB;

// The finished frame sits in whichever filter image the last denoiser pass (parity in step) wrote.
vec3 finished(ivec2 q) {
  return ((pc.step & 1) == 0 ? imageLoad(filterA, q) : imageLoad(filterB, q)).rgb;
}

const int RADIUS = 6;
const float WEIGHTS[7] = float[7](0.1329, 0.1257, 0.1063, 0.0805, 0.0545, 0.0330, 0.0179);
// The soft glow uses its own Gaussian of adjustable width over this many taps a side; wider
// blurs stride further apart rather than adding taps.
const int SOFT_RADIUS = 12;

float softSigma() {
  return max(u.material.w, 0.5);
}

int softStride() {
  return max(1, int(ceil(3.0 * softSigma() / float(SOFT_RADIUS))));
}

float softWeight(int i) {
  float x = float(i * softStride());
  float s = softSigma();
  return exp(-x * x / (2.0 * s * s));
}

void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  ivec2 full = ivec2(u.misc.zw);
  ivec2 quarter = (full + 3) / 4;
  if (q.x >= quarter.x || q.y >= quarter.y) {
    return;
  }
  vec3 bright = vec3(0.0);
  vec3 soft = vec3(0.0);
  if (pc.pass == 0) {
    ivec2 centre = q * 4 + 1;
    for (int i = -RADIUS; i <= RADIUS; ++i) {
      ivec2 s = clamp(centre + ivec2(i * 4, 0), ivec2(0), full - 1);
      // Four rows average the quarter cell vertically as the horizontal taps run.
      vec3 brightColumn = vec3(0.0);
      for (int r = 0; r < 4; ++r) {
        brightColumn += imageLoad(bloomSource, clamp(ivec2(s.x, q.y * 4 + r), ivec2(0), full - 1)).rgb;
      }
      bright += WEIGHTS[abs(i)] * brightColumn * 0.25;
    }
    imageStore(bloomA, q, vec4(bright, 1.0));
    // The soft copy takes its own horizontal pass at its own width.
    soft = vec3(0.0);
    float total = 0.0;
    int stride = softStride();
    for (int i = -SOFT_RADIUS; i <= SOFT_RADIUS; ++i) {
      float w = softWeight(i);
      ivec2 s = clamp(centre + ivec2(i * stride * 4, 0), ivec2(0), full - 1);
      vec3 column = vec3(0.0);
      for (int r = 0; r < 4; ++r) {
        column += finished(clamp(ivec2(s.x, q.y * 4 + r), ivec2(0), full - 1));
      }
      soft += w * column * 0.25;
      total += w;
    }
    imageStore(diffuseA, q, vec4(soft / total, 1.0));
  } else {
    for (int i = -RADIUS; i <= RADIUS; ++i) {
      ivec2 s = clamp(q + ivec2(0, i), ivec2(0), quarter - 1);
      bright += WEIGHTS[abs(i)] * imageLoad(bloomA, s).rgb;
    }
    imageStore(bloomB, q, vec4(bright, 1.0));
    float total = 0.0;
    int stride = softStride();
    for (int i = -SOFT_RADIUS; i <= SOFT_RADIUS; ++i) {
      float w = softWeight(i);
      ivec2 s = clamp(q + ivec2(0, i * stride), ivec2(0), quarter - 1);
      soft += w * imageLoad(diffuseA, s).rgb;
      total += w;
    }
    imageStore(diffuseB, q, vec4(soft / total, 1.0));
  }
}
