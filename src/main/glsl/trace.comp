#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;
layout(std430, set = 0, binding = 2) readonly buffer StaticPos { float v[]; } staticPos;
layout(std430, set = 0, binding = 3) readonly buffer StaticCol { uint c[]; } staticCol;
layout(std430, set = 0, binding = 4) readonly buffer DynPos { float v[]; } dynPos;
layout(std430, set = 0, binding = 5) readonly buffer DynCol { uint c[]; } dynCol;
layout(std140, set = 0, binding = 6) uniform Frame {
  vec4 cam;     // camera position, zoom
  vec4 r0;      // inverse rotation rows: view direction to world direction
  vec4 r1;
  vec4 r2;
  vec4 prevCam; // previous camera position, previous zoom
  vec4 p0;      // previous forward rotation rows: world to view
  vec4 p1;
  vec4 p2;
  vec4 sun;     // unit vector toward the sun, intensity
  vec4 sky;     // sky radiance, ambient floor
  vec4 params;  // sun angular radius (radians), exposure, history frames, dynamic history frames
  uvec4 misc;   // frame, flags, width, height
  vec4 extra;   // skybox rotation (radians), flat background colour rgb
  vec4 denoise; // luminance, normal and position sigmas, unused
  vec4 sunColor; // rgb tint of the direct light, unused
  vec4 path;     // diffuse bounce count, lens aperture radius, focus distance, wave strength
  vec4 motion;   // shutter fraction, game cycle for texture scrolling, texture relief, unused
  vec4 weather;  // cloud cover, fog amount, rain, snow
  vec4 weather2; // ground wetness, snow cover, wind velocity x and z in world units per second
  vec4 fog;      // fog colour in display space, lightning flash
  vec4 weather3; // seconds, swamp mist density, mist grid side length, mist grid tile offset
} u;
layout(set = 0, binding = 12) uniform sampler2D skybox;
// This pass writes one irradiance sample per pixel plus the albedo, normal and position the
// resolve and denoise passes need; the albedo is multiplied back in at the very end.
layout(set = 0, binding = 10, rgba32f) uniform writeonly image2D currPos;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D sampleImage;
layout(set = 0, binding = 13, rgba8) uniform writeonly image2D albedoImage;
layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D normalImage;
layout(std430, set = 0, binding = 19) readonly buffer StaticTex { uint t[]; } staticTex;
layout(std430, set = 0, binding = 20) readonly buffer StaticUv { float v[]; } staticUv;
layout(std430, set = 0, binding = 21) readonly buffer DynTex { uint t[]; } dynTex;
layout(std430, set = 0, binding = 22) readonly buffer DynUv { float v[]; } dynUv;
layout(set = 0, binding = 23) uniform sampler2DArray gameTextures;
layout(std430, set = 0, binding = 24) readonly buffer TexAnim { vec2 v[]; } texAnim;
layout(std430, set = 0, binding = 25) readonly buffer WaterTypes { vec4 v[]; } waterTypes;

const uint FLAG_CULL = 1u;
const uint FLAG_SHADOWS = 2u;
const uint FLAG_PATTERN = 4u;
const uint FLAG_RESET_HISTORY = 8u;
const uint FLAG_TEXTURES = 16u;
const uint FLAG_ANTIALIAS = 64u;
const uint FLAG_WATER = 128u;
const uint WATER_BIT = 0x80000000u;
const uint FLAG_SKYBOX = 32u;
const uint DYN_BIT = 0x800000u;
const float RAY_EPS = 0.25;
// Instance masks: opaque geometry and translucent geometry, so a ray can ignore the latter.
const uint MASK_OPAQUE = 0x1u;
// Water surfaces carry their own bit so shadow rays pass through them to the bed beneath.
const uint MASK_SHADOW = 0x3u;
const uint MASK_ALL = 0xFFu;
const float FAR = 1.0e6;
const float TWO_PI = 6.28318530718;

struct Hit {
  float t;
  vec3 surface; // exact hit point, stored for reprojection
  vec3 p;       // hit point nudged along the normal, origin for secondary rays
  vec3 n;       // shading normal, tilted by texture relief where enabled
  vec3 gn;      // geometric normal, used for ray offsets and the denoiser
  vec3 albedo;
  bool dyn;
  bool translucent; // the accepted surface itself is translucent
  bool covered;     // translucent geometry lies between the ray origin and the accepted surface
  bool water;
  uint waterType;   // index into the water type table, 0 when not water
};

// Water appearance per type, four vec4s each as packed by WaterType.table().
struct WaterType {
  vec3 surface;
  bool isFlat;
  bool foam;
  vec3 foamColor;
  float duration;
  vec3 depth;
  float opacity;
  float specularStrength;
  float specularGloss;
  float normalStrength;
  float fresnelAmount;
};

WaterType waterType(uint index) {
  vec4 a = waterTypes.v[index * 4u];
  vec4 b = waterTypes.v[index * 4u + 1u];
  vec4 c = waterTypes.v[index * 4u + 2u];
  vec4 d = waterTypes.v[index * 4u + 3u];
  WaterType t;
  t.surface = a.rgb;
  uint flags = uint(a.w);
  t.isFlat = (flags & 1u) != 0u;
  t.foam = (flags & 2u) != 0u;
  t.foamColor = b.rgb;
  t.duration = b.w;
  t.depth = c.rgb;
  t.opacity = c.w;
  t.specularStrength = d.x;
  t.specularGloss = d.y;
  t.normalStrength = d.z;
  t.fresnelAmount = d.w;
  return t;
}

vec3 vertex(bool dyn, uint index) {
  uint o = index * 3u;
  if (dyn) {
    return vec3(dynPos.v[o], dynPos.v[o + 1u], dynPos.v[o + 2u]);
  }
  return vec3(staticPos.v[o], staticPos.v[o + 1u], staticPos.v[o + 2u]);
}

vec3 unpack(uint c) {
  return vec3(float(c & 0xFFu), float((c >> 8) & 0xFFu), float((c >> 16) & 0xFFu)) / 255.0;
}

uint pcgHash(uint v) {
  uint state = v * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

float rand(inout uint seed) {
  seed = pcgHash(seed);
  return float(seed) / 4294967296.0;
}

void basis(vec3 n, out vec3 t, out vec3 b) {
  t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
  b = cross(n, t);
}

vec3 cosineDirection(vec3 n, inout uint seed) {
  float u1 = rand(seed);
  float u2 = rand(seed);
  float r = sqrt(u1);
  float phi = TWO_PI * u2;
  vec3 t, b;
  basis(n, t, b);
  return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

vec3 coneDirection(vec3 d, float angle, inout uint seed) {
  float u1 = rand(seed);
  float u2 = rand(seed);
  float cosTheta = 1.0 - u1 * (1.0 - cos(angle));
  float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
  float phi = TWO_PI * u2;
  vec3 t, b;
  basis(d, t, b);
  return normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + d * cosTheta);
}

float opacity(bool dyn, uint face) {
  uint c = dyn ? dynCol.c[face] : staticCol.c[face];
  return float(c >> 24) / 255.0;
}

vec2 cornerUv(bool dyn, uint o) {
  return dyn ? vec2(dynUv.v[o], dynUv.v[o + 1u]) : vec2(staticUv.v[o], staticUv.v[o + 1u]);
}

// Interpolated texture coordinates of a face at given barycentrics, including scrolling.
vec2 faceUv(bool dyn, uint face, vec2 bary, uint tex) {
  uint o = face * 6u;
  vec2 uv0 = cornerUv(dyn, o);
  vec2 uv1 = cornerUv(dyn, o + 2u);
  vec2 uv2 = cornerUv(dyn, o + 4u);
  vec2 uv = uv0 * (1.0 - bary.x - bary.y) + uv1 * bary.x + uv2 * bary.y;
  // Scrolling textures move one 128th of a texture per client cycle per unit of speed.
  return uv + texAnim.v[tex - 1u] * (u.motion.y / 128.0);
}

float texHeight(vec2 uv, float layer) {
  return dot(texture(gameTextures, vec3(uv, layer)).rgb, vec3(0.299, 0.587, 0.114));
}

// Texture relief: texel brightness stands in for height, and its gradient along the face's
// tangent directions tilts the shading normal. Heights are in world units, so a texture
// stretched across a large face gets proportionally gentler slopes.
vec3 bumpNormal(vec3 n, vec3 v0, vec3 v1, vec3 v2, bool dyn, uint face, vec2 uv, float layer, float strength) {
  uint o = face * 6u;
  vec2 uv0 = cornerUv(dyn, o);
  vec2 d1 = cornerUv(dyn, o + 2u) - uv0;
  vec2 d2 = cornerUv(dyn, o + 4u) - uv0;
  float det = d1.x * d2.y - d1.y * d2.x;
  if (abs(det) < 1e-6) {
    return n;
  }
  vec3 e1 = v1 - v0;
  vec3 e2 = v2 - v0;
  vec3 t = (e1 * d2.y - e2 * d1.y) / det;
  vec3 b = (e2 * d1.x - e1 * d2.x) / det;
  float texel = 1.0 / 128.0;
  float dhdu = (texHeight(uv + vec2(texel, 0.0), layer) - texHeight(uv - vec2(texel, 0.0), layer)) / (2.0 * texel);
  float dhdv = (texHeight(uv + vec2(0.0, texel), layer) - texHeight(uv - vec2(0.0, texel), layer)) / (2.0 * texel);
  // The full brightness range stands for this many world units of height at full strength.
  float amplitude = strength * 24.0;
  vec3 grad = (dhdu * t / dot(t, t) + dhdv * b / dot(b, b)) * amplitude;
  grad -= n * dot(grad, n);
  return normalize(n - grad);
}

// Translucent geometry is built without the opaque flag, so only its triangles show up as
// candidates here. Textured candidates with a hole at the hit point are skipped; the rest are
// accepted with probability equal to their opacity, which the accumulation turns into an alpha
// blend, and shadow rays get proportional occlusion the same way.
// Returns the distance of the nearest translucent candidate seen, whether accepted or not.
float resolveCandidates(rayQueryEXT rq, inout uint seed) {
  float nearest = FAR;
  while (rayQueryProceedEXT(rq)) {
    uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false));
    bool dyn = (custom & DYN_BIT) != 0u;
    uint face = (custom & 0x7FFFFFu) + uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
    uint texField = dyn ? dynTex.t[face] : staticTex.t[face];
    uint tex = texField & 0xFFFFu;
    if (tex != 0u && (texField & WATER_BIT) == 0u && (u.misc.y & FLAG_TEXTURES) != 0u) {
      vec2 uv = faceUv(dyn, face, rayQueryGetIntersectionBarycentricsEXT(rq, false), tex);
      if (texture(gameTextures, vec3(uv, float(tex - 1u))).a < 0.5) {
        continue;
      }
    }
    nearest = min(nearest, rayQueryGetIntersectionTEXT(rq, false));
    if (rand(seed) < opacity(dyn, face)) {
      rayQueryConfirmIntersectionEXT(rq);
    }
  }
  return nearest;
}

bool occluded(vec3 origin, vec3 dir, inout uint seed) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT, MASK_SHADOW, origin, RAY_EPS, dir, FAR);
  resolveCandidates(rq, seed);
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

bool trace(vec3 origin, vec3 dir, float tMin, uint rayFlags, uint mask, inout uint seed, out Hit hit) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, rayFlags, mask, origin, tMin, dir, FAR);
  float nearestTranslucent = resolveCandidates(rq, seed);
  if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
    return false;
  }
  hit.t = rayQueryGetIntersectionTEXT(rq, true);
  hit.covered = nearestTranslucent <= hit.t;
  uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
  uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
  hit.dyn = (custom & DYN_BIT) != 0u;
  uint face = (custom & 0x7FFFFFu) + prim;

  vec3 v0 = vertex(hit.dyn, face * 3u);
  vec3 v1 = vertex(hit.dyn, face * 3u + 1u);
  vec3 v2 = vertex(hit.dyn, face * 3u + 2u);
  vec3 n = normalize(cross(v1 - v0, v2 - v0));
  if (dot(n, dir) > 0.0) {
    n = -n;
  }
  hit.n = n;
  hit.gn = n;
  hit.surface = origin + dir * hit.t;
  hit.p = hit.surface + n * RAY_EPS;
  uint packed = hit.dyn ? dynCol.c[face] : staticCol.c[face];
  hit.albedo = unpack(packed);
  hit.translucent = (packed >> 24) != 0xFFu;

  // Textured faces: interpolate the face's UVs with the hit barycentrics and sample the
  // texture; fully transparent texels fall back to the face's flat colour.
  uint texField = hit.dyn ? dynTex.t[face] : staticTex.t[face];
  hit.water = (texField & WATER_BIT) != 0u && (u.misc.y & FLAG_WATER) != 0u;
  hit.waterType = hit.water ? (texField >> 16) & 0xFFu : 0u;
  uint tex = texField & 0xFFFFu;
  if (tex != 0u && !hit.water && (u.misc.y & FLAG_TEXTURES) != 0u) {
    vec2 uv = faceUv(hit.dyn, face, rayQueryGetIntersectionBarycentricsEXT(rq, true), tex);
    vec4 texel = texture(gameTextures, vec3(uv, float(tex - 1u)));
    hit.albedo = mix(hit.albedo, texel.rgb, texel.a);
    if (u.motion.z > 0.0) {
      hit.n = bumpNormal(n, v0, v1, v2, hit.dyn, face, uv, float(tex - 1u), u.motion.z);
    }
  }
  return true;
}

// Scene space has north along +z, east along +x and up along -y.
vec2 skyUv(vec3 d) {
  float az = atan(d.x, d.z) + u.extra.x;
  return vec2(az / TWO_PI + 0.5, acos(clamp(-d.y, -1.0, 1.0)) / 3.14159265359);
}

// Cloud cover greys and dims the sky towards a uniform overcast.
vec3 overcast(vec3 c) {
  float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
  return mix(c, vec3(l), 0.85 * u.weather.x) * (1.0 - 0.45 * u.weather.x);
}

// Sky radiance used to light surfaces: the skybox or flat colour, scaled by the sky intensity.
vec3 skyRadiance(vec3 d) {
  vec3 c = (u.misc.y & FLAG_SKYBOX) == 0u ? u.sky.rgb : texture(skybox, skyUv(d)).rgb * u.sky.rgb;
  return overcast(c) + vec3(2.0 * u.fog.w);
}

// What the camera sees where no geometry is: the sky at its painted colours, shown as-is,
// under the cloud cover, with fog thickening towards the horizon and lightning whitening it.
vec3 skyBackground(vec3 d) {
  vec3 c = (u.misc.y & FLAG_SKYBOX) == 0u ? u.extra.yzw : texture(skybox, skyUv(d)).rgb;
  c = overcast(c);
  float horizon = 1.0 - clamp(-d.y * 4.0, 0.0, 1.0);
  c = mix(c, u.fog.rgb, clamp(u.weather.y, 0.0, 1.0) * horizon);
  return c + vec3(0.8 * u.fog.w);
}

// Animated wave normal for a water surface; up is -y. Strength scales the slopes and
// duration stretches the animation, as 117 HD's water types define them.
vec3 waterNormal(vec3 p, float strength, float duration) {
  float t = float(u.misc.x) / (50.0 * max(duration, 0.05));
  float s = 1.0 / 90.0;
  float dx = cos(p.x * s + t * 1.3) + 0.6 * cos((p.x * 0.7 + p.z * 0.9) * s * 1.7 - t * 0.9) + 0.35 * cos((p.x * 1.3 - p.z * 0.4) * s * 3.1 + t * 2.1);
  float dz = cos(p.z * s * 1.2 - t * 1.1) + 0.6 * cos((-p.x * 0.8 + p.z * 0.6) * s * 1.9 + t * 1.4) + 0.35 * cos((p.x * 0.5 + p.z * 1.4) * s * 2.7 - t * 1.7);
  return normalize(vec3(-dx * strength, -1.0, -dz * strength));
}

vec3 directSun(Hit hit, vec3 sunDir, bool shadows, inout uint seed);

// 117 HD's water adapted to traced reflections. The surface is its type's own colour under
// the scene light plus a specular sun highlight and foam along the shore, shown over the bed
// seen through the surface at an opacity that rises with Fresnel and foam. The reflection of
// the scene stands in for 117 HD's sky gradient, and flat types hide the bed entirely.
vec3 shadeWater(Hit hit, vec3 dir, vec3 sunDir, bool shadows, inout uint seed) {
  WaterType wt = waterType(hit.waterType);
  vec3 wn = waterNormal(hit.surface, wt.normalStrength * u.path.w, wt.duration);
  float viewDot = clamp(dot(-dir, wn), 0.0, 1.0);
  float finalFresnel = clamp(mix(0.4, 1.0, (1.0 - viewDot) * 1.2), 0.0, 1.0);

  float ndl = max(dot(wn, sunDir), 0.0);
  float lit = (shadows && ndl > 0.0 && occluded(hit.p, sunDir, seed)) ? 0.0 : 1.0;
  vec3 reflectDir = reflect(dir, wn);
  if (dot(reflectDir, hit.gn) < 0.0) {
    reflectDir = reflect(reflectDir, hit.gn);
  }
  float spec = pow(clamp(dot(reflectDir, sunDir), 1e-10, 1.0), wt.specularGloss) * wt.specularStrength;
  vec3 specular = u.sunColor.rgb * (u.sun.w * lit * spec);
  vec3 composite = vec3(u.sky.w) + u.sunColor.rgb * (u.sun.w * ndl * lit) + 0.5 * skyRadiance(wn) * max(-wn.y, 0.0) + vec3(2.0 * u.fog.w);

  vec3 reflection;
  Hit mirror;
  if (trace(hit.p, reflectDir, RAY_EPS, gl_RayFlagsNoneEXT, MASK_ALL, seed, mirror)) {
    reflection = mirror.albedo * (vec3(u.sky.w) + directSun(mirror, sunDir, shadows, seed) + 0.5 * skyRadiance(mirror.n));
  } else {
    reflection = skyBackground(reflectDir);
  }
  vec3 base = wt.surface * (composite + reflection * max(wt.specularStrength, 0.2));
  base = mix(base, reflection, wt.fresnelAmount * finalFresnel);

  // The bed through the surface, tinted towards the depth colour and then to black as it deepens.
  vec3 under = vec3(0.0);
  float bedDepth = 0.0;
  bool sawBed = false;
  if (!wt.isFlat) {
    vec3 refracted = refract(dir, wn, 1.0 / 1.33);
    Hit bed;
    if (dot(refracted, refracted) > 0.0 && trace(hit.surface - hit.gn * RAY_EPS, refracted, RAY_EPS, gl_RayFlagsNoneEXT, MASK_OPAQUE, seed, bed)) {
      sawBed = true;
      bedDepth = max(bed.surface.y - hit.surface.y, 0.0);
      under = bed.albedo * (vec3(u.sky.w) + directSun(bed, sunDir, shadows, seed));
      if (bedDepth < 150.0) {
        under *= mix(vec3(1.0), wt.depth, bedDepth / 150.0);
      } else if (bedDepth < 500.0) {
        under *= mix(wt.depth, vec3(0.0), (bedDepth - 150.0) / 350.0);
      } else {
        under = vec3(0.0);
      }
    }
  }

  // Foam where the bed is shallow, broken up by a slow ripple.
  float foamAmount = 0.0;
  if (wt.foam && sawBed) {
    float t = float(u.misc.x) / (50.0 * wt.duration);
    float ripple = 0.55 + 0.25 * sin(hit.surface.x * 0.11 + t) + 0.2 * sin(hit.surface.z * 0.13 - t * 0.7);
    float shore = min(1.0 - clamp(bedDepth / 70.0, 0.0, 1.0), 0.8);
    foamAmount = clamp(pow(1.0 - (1.0 - shore) / 0.7, 3.0), 0.0, 1.0) * ripple;
  }
  base = mix(base, wt.foamColor * composite, foamAmount) + specular / 3.0;

  float alpha = max(wt.opacity, max(foamAmount, max(finalFresnel, length(specular) / 3.0)));
  if (wt.isFlat || !sawBed) {
    return mix(wt.depth * composite, base, alpha);
  }
  return mix(under, base, alpha);
}

// Irradiance from the sun at a hit, before the albedo.
vec3 directSun(Hit hit, vec3 sunDir, bool shadows, inout uint seed) {
  float ndl = max(dot(hit.n, sunDir), 0.0);
  if (ndl <= 0.0 || u.sun.w <= 0.0) {
    return vec3(0.0);
  }
  if (shadows && occluded(hit.p, sunDir, seed)) {
    return vec3(0.0);
  }
  return u.sunColor.rgb * (u.sun.w * ndl);
}

void main() {
  uvec2 px = gl_GlobalInvocationID.xy;
  uint w = u.misc.z;
  uint h = u.misc.w;
  if (px.x >= w || px.y >= h) {
    return;
  }

  uint flags = u.misc.y;
  if ((flags & FLAG_PATTERN) != 0u) {
    float phase = 0.5 + 0.5 * sin(float(u.misc.x) * 0.05);
    float checker = (((px.x >> 5) + (px.y >> 5)) & 1u) == 0u ? 1.0 : 0.6;
    imageStore(outImage, ivec2(px), vec4(vec3(float(px.x) / float(w), float(px.y) / float(h), phase) * checker, 1.0));
    return;
  }

  uint seed = pcgHash(px.x * 1973u + px.y * 9277u + u.misc.x * 26699u);

  // Motion blur: each ray uses the camera at a random moment inside the shutter interval,
  // interpolated between the previous and current frame.
  vec3 camPos = u.cam.xyz;
  float zoom = u.cam.w;
  vec3 row0 = u.r0.xyz;
  vec3 row1 = u.r1.xyz;
  vec3 row2 = u.r2.xyz;
  if (u.motion.x > 0.0 && (flags & FLAG_RESET_HISTORY) == 0u) {
    float tau = 1.0 - rand(seed) * u.motion.x;
    camPos = mix(u.prevCam.xyz, camPos, tau);
    zoom = mix(u.prevCam.w, zoom, tau);
    // The previous inverse rotation is the transpose of the stored forward rotation.
    row0 = normalize(mix(vec3(u.p0.x, u.p1.x, u.p2.x), row0, tau));
    row1 = normalize(mix(vec3(u.p0.y, u.p1.y, u.p2.y), row1, tau));
    row2 = normalize(mix(vec3(u.p0.z, u.p1.z, u.p2.z), row2, tau));
  }
  // Antialiasing: a random point in the pixel each frame, averaged by the accumulation.
  vec2 jitter = (flags & FLAG_ANTIALIAS) != 0u ? vec2(rand(seed), rand(seed)) : vec2(0.5);
  vec3 viewDir = vec3((float(px.x) + jitter.x - float(w) * 0.5) / zoom, (float(px.y) + jitter.y - float(h) * 0.5) / zoom, 1.0);
  vec3 dir = normalize(vec3(dot(row0, viewDir), dot(row1, viewDir), dot(row2, viewDir)));
  vec3 origin = camPos;

  uint primaryFlags = (flags & FLAG_CULL) != 0u ? gl_RayFlagsCullBackFacingTrianglesEXT : gl_RayFlagsNoneEXT;

  Hit hit;
  if (!trace(origin, dir, 1.0, primaryFlags, MASK_ALL, seed, hit)) {
    imageStore(sampleImage, ivec2(px), vec4(skyBackground(dir), 0.0));
    imageStore(albedoImage, ivec2(px), vec4(1.0));
    imageStore(normalImage, ivec2(px), vec4(0.0));
    imageStore(currPos, ivec2(px), vec4(0.0, 0.0, 0.0, -1.0));
    return;
  }

  bool shadows = (flags & FLAG_SHADOWS) != 0u;
  vec3 sunDir = u.params.x > 0.0 ? coneDirection(u.sun.xyz, u.params.x, seed) : u.sun.xyz;

  // Weather settles on static, up-facing surfaces: snow whitens them, rain darkens them and
  // adds a sheen once it has soaked in.
  float upFacing = smoothstep(0.3, 0.8, -hit.gn.y);
  bool wetPixel = false;
  if (!hit.dyn && !hit.water && !hit.translucent && upFacing > 0.0) {
    if (u.weather2.y > 0.0) {
      hit.albedo = mix(hit.albedo, vec3(0.85), u.weather2.y * upFacing);
    }
    if (u.weather2.x > 0.0 && u.weather2.y < 0.5) {
      wetPixel = true;
      hit.albedo *= 1.0 - 0.4 * u.weather2.x * upFacing;
    }
  }
  vec3 light = vec3(u.sky.w) + directSun(hit, sunDir, shadows, seed);

  // Diffuse path: cosine-weighted bounces, each attenuated by the albedo it passed through,
  // gathering direct light at every vertex and sky light where the path escapes.
  int bounces = int(u.path.x);
  vec3 throughput = vec3(1.0);
  Hit current = hit;
  for (int b = 0; b < bounces; ++b) {
    vec3 bounceDir = cosineDirection(current.n, seed);
    // A relief-tilted normal can send the bounce under the real surface.
    if (dot(bounceDir, current.gn) < 0.0) {
      bounceDir = reflect(bounceDir, current.gn);
    }
    Hit next;
    if (!trace(current.p, bounceDir, RAY_EPS, gl_RayFlagsNoneEXT, MASK_ALL, seed, next)) {
      light += throughput * skyRadiance(bounceDir);
      break;
    }
    throughput *= next.albedo;
    light += throughput * (vec3(u.sky.w) + directSun(next, sunDir, shadows, seed));
    current = next;
  }
  // Water: a Fresnel blend of the lit body colour and a mirror reflection off animated waves,
  // plus the sun's glint. Stored like a translucent pixel and with a short history.
  bool waterPixel = false;
  if (hit.water) {
    light = shadeWater(hit, dir, sunDir, shadows, seed);
    hit.albedo = vec3(1.0);
    waterPixel = true;
  } else if (wetPixel) {
    // Wet ground reflects like a thin film: a Fresnel blend at a fraction of the strength.
    float cosI = clamp(dot(-dir, hit.n), 0.0, 1.0);
    float fresnel = (0.02 + 0.98 * pow(1.0 - cosI, 5.0)) * 0.5 * u.weather2.x * upFacing;
    vec3 reflectDir = reflect(dir, hit.n);
    if (dot(reflectDir, hit.gn) < 0.0) {
      reflectDir = reflect(reflectDir, hit.gn);
    }
    vec3 reflection;
    Hit mirror;
    if (trace(hit.p, reflectDir, RAY_EPS, gl_RayFlagsNoneEXT, MASK_ALL, seed, mirror)) {
      reflection = mirror.albedo * (vec3(u.sky.w) + directSun(mirror, sunDir, shadows, seed) + 0.5 * skyRadiance(mirror.n));
    } else {
      reflection = skyBackground(reflectDir);
    }
    float glint = pow(max(dot(reflectDir, u.sun.xyz), 0.0), 600.0);
    light = mix(hit.albedo * light, reflection, fresnel) + u.sunColor.rgb * (u.sun.w * fresnel * glint * 4.0);
    hit.albedo = vec3(1.0);
  }

  // The G-buffer for reprojection and denoising describes a stable surface. A pixel whose
  // stochastic primary hit landed on translucent geometry uses the opaque surface behind it
  // instead, and stores its full colour with a unit albedo so the blend is filtered as a whole.
  Hit stable = hit;
  vec3 sample_ = light;
  if (hit.covered && !waterPixel) {
    if (hit.translucent) {
      Hit solid;
      if (trace(origin, dir, 1.0, primaryFlags, MASK_OPAQUE, seed, solid)) {
        stable = solid;
      }
    }
    sample_ = hit.albedo * light;
    hit.albedo = vec3(1.0);
  }
  // w of the position is the hit distance; the sign of the sample's alpha marks dynamic geometry
  // and its magnitude is the view angle cosine, both used by the later passes.
  float cosine = max(abs(dot(stable.n, dir)), 0.01);
  imageStore(sampleImage, ivec2(px), vec4(sample_, (stable.dyn || waterPixel) ? -cosine : cosine));
  imageStore(albedoImage, ivec2(px), vec4(hit.albedo, 1.0));
  imageStore(normalImage, ivec2(px), vec4(stable.gn, 0.0));
  imageStore(currPos, ivec2(px), vec4(stable.surface, stable.t));
}
