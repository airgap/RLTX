#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;
layout(std430, set = 0, binding = 2) readonly buffer StaticPos { float v[]; } staticPos;
layout(std430, set = 0, binding = 3) readonly buffer StaticCol { uint c[]; } staticCol;
layout(std430, set = 0, binding = 4) readonly buffer DynPos { float v[]; } dynPos;
layout(std430, set = 0, binding = 5) readonly buffer DynCol { uint c[]; } dynCol;
layout(std140, set = 0, binding = 6) uniform Frame {
  vec4 cam;     // camera position, zoom
  vec4 r0;      // inverse rotation rows: view direction to world direction
  vec4 r1;
  vec4 r2;
  vec4 prevCam; // previous camera position, previous zoom
  vec4 p0;      // previous forward rotation rows: world to view
  vec4 p1;
  vec4 p2;
  vec4 sun;     // unit vector toward the sun, intensity
  vec4 sky;     // sky radiance, ambient floor
  vec4 params;  // sun angular radius (radians), exposure, history frames, dynamic history frames
  uvec4 misc;   // frame, flags, width, height
  vec4 extra;   // skybox rotation (radians), flat background colour rgb
  vec4 denoise; // luminance, normal and position sigmas, unused
  vec4 sunColor; // rgb tint of the direct light, unused
  vec4 path;     // diffuse bounce count, lens aperture radius, focus distance, wave strength
  vec4 motion;   // shutter fraction, game cycle for texture scrolling, texture relief, unused
  vec4 weather;  // cloud cover, fog amount, rain, snow
  vec4 weather2; // ground wetness, snow cover, accumulated wind displacement x and z in world units
  vec4 fog;      // fog colour in display space, lightning flash
  vec4 weather3; // seconds, swamp mist density, mist grid side length, mist grid tile offset
  vec4 mistColor;
  vec4 post;     // vignette, bloom, render distance in world units, fade share
  vec4 post2;    // film grain, chromatic aberration, aerial perspective, sine of the real sun's elevation
  vec4 lights;   // local light count, local light strength scale, default sheen strength, default sheen exponent
  vec4 material; // emissive glow scale, glossy reflections flag, terrain relief, soft glow sigma
  vec4 post3;
  vec4 wind;     // wind velocity x and z, angular radius of the sky's light disc
  vec4 skyAmbient;
  vec4 eye;      // the character's eye position, and how dark what they cannot see is drawn
  vec4 guide;
  vec4 marks;    // ground marker count, marker glow scale, NPC rim glow scale
  vec4 highlight[16]; // linear colours the faces of highlighted NPCs index
  vec4 season;   // season 0 none to 4 winter, progress, falling leaves, blossom petals
  vec4 star0;    // columns of the equatorial to world rotation for the star map; star brightness in w
  vec4 star1;
  vec4 star2;
  vec4 night;    // direction to the sun while the moon lights the scene, moon illuminated fraction
  vec4 ground;   // footprint count, footprint strength, water surface height over the camera, latitude
  vec4 horizon[8]; // fog colour by eighth of the compass, from north through east
} u;
layout(set = 0, binding = 12) uniform sampler2D skybox;
layout(set = 0, binding = 41) uniform sampler2D starMap;
layout(set = 0, binding = 42) uniform sampler2D skyLut;
layout(std430, set = 0, binding = 43) readonly buffer Prints { vec4 v[]; } prints;
// This pass writes one irradiance sample per pixel plus the albedo, normal and position the
// resolve and denoise passes need; the albedo is multiplied back in at the very end.
layout(set = 0, binding = 10, rgba32f) uniform writeonly image2D currPos;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D sampleImage;
layout(set = 0, binding = 13, rgba8) uniform writeonly image2D albedoImage;
layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D normalImage;
layout(std430, set = 0, binding = 19) readonly buffer StaticTex { uint t[]; } staticTex;
layout(std430, set = 0, binding = 20) readonly buffer StaticUv { float v[]; } staticUv;
layout(std430, set = 0, binding = 21) readonly buffer DynTex { uint t[]; } dynTex;
layout(std430, set = 0, binding = 22) readonly buffer DynUv { float v[]; } dynUv;
layout(set = 0, binding = 23) uniform sampler2DArray gameTextures;
layout(std430, set = 0, binding = 24) readonly buffer TexAnim { vec2 v[]; } texAnim;
layout(std430, set = 0, binding = 25) readonly buffer WaterTypes { vec4 v[]; } waterTypes;
// Local lights: position and radius, then colour premultiplied by strength.
layout(std430, set = 0, binding = 32) readonly buffer Lights { vec4 v[]; } localLights;
// Per vanilla texture id: specular strength, gloss exponent, emissive, brightness.
layout(std430, set = 0, binding = 33) readonly buffer Materials { vec4 v[]; } materials;
// The ground grid: height, mist coverage, puddle coverage per vertex of the lowest plane.
layout(std430, set = 0, binding = 26) readonly buffer MistGrid { vec4 v[]; } groundGrid;
// Tile heights of the top-level scene, plane-major then x then y, for smooth terrain normals.
layout(std430, set = 0, binding = 36) readonly buffer Heights { float v[]; } tileHeights;
// Rain runoff per ground vertex: water depth, flow x, flow z.
layout(std430, set = 0, binding = 37) readonly buffer Runoff { vec4 v[]; } runoff;

const uint FLAG_CULL = 1u;
const uint FLAG_SHADOWS = 2u;
const uint FLAG_PATTERN = 4u;
const uint FLAG_RESET_HISTORY = 8u;
const uint FLAG_TEXTURES = 16u;
const uint FLAG_ANTIALIAS = 64u;
const uint FLAG_WATER = 128u;
const uint FLAG_PROCEDURAL_SKY = 256u;
const uint FLAG_CLOUDS = 512u;
const uint FLAG_CLOUD_SHADOWS = 1024u;
const uint FLAG_CAUSTICS = 2048u;
const uint FLAG_RAIN_RIPPLES = 4096u;
const uint FLAG_PUDDLES = 8192u;
const uint FLAG_TERRAIN_TEXTURES = 16384u;
const uint FLAG_SMOOTH_TERRAIN = 32768u;
const uint FLAG_RUNOFF = 65536u;
const uint FLAG_STILL = 1048576u;
const uint FLAG_THIN_LENS = 2097152u;
const uint FLAG_PHYSICAL_SKY = 8388608u;
const uint FLAG_UNDERWATER = 33554432u;
const uint FLAG_RAINBOWS = 134217728u;
const uint WATER_BIT = 0x80000000u;
const uint TERRAIN_BIT = 0x40000000u;
const uint FLAME_BIT = 0x20000000u;
const uint FLAG_SKYBOX = 32u;
const uint DYN_BIT = 0x800000u;
const float RAY_EPS = 0.25;
// Instance masks: opaque geometry and translucent geometry, so a ray can ignore the latter.
const uint MASK_OPAQUE = 0x1u;
// Water surfaces carry their own bit so shadow rays pass through them to the bed beneath.
const uint MASK_SHADOW = 0x3u;
const uint MASK_ALL = 0xFFu;
const float FAR = 1.0e6;
const float TWO_PI = 6.28318530718;

struct Hit {
  float t;
  vec3 surface; // exact hit point, stored for reprojection
  vec3 p;       // hit point nudged along the normal, origin for secondary rays
  vec3 n;       // shading normal, tilted by texture relief where enabled
  vec3 gn;      // geometric normal, used for ray offsets and the denoiser
  vec3 albedo;
  bool dyn;
  bool translucent; // the accepted surface itself is translucent
  bool covered;     // translucent geometry lies between the ray origin and the accepted surface
  bool water;
  uint waterType;   // index into the water type table, 0 when not water
  vec4 material;    // specular strength, gloss exponent, emissive, brightness or ground normal layer plus one
  bool terrain;     // untextured terrain face carrying a ground detail id
  bool flame;       // a flame face of a light-bearing object
  uint highlight;   // index into the highlight palette, 0 for none
};

// A texture's material, or the global sheen for faces whose texture defines no specular.
vec4 materialOf(uint tex) {
  vec4 m = tex == 0u ? vec4(0.0, 0.0, 0.0, 1.0) : materials.v[min(tex - 1u, 271u)];
  if (m.x <= 0.0) {
    m.x = u.lights.z;
    m.y = u.lights.w;
  }
  return m;
}

vec3 smoothTerrainNormal(vec3 p, vec3 fallback);

// Specular highlight of a light with a Blinn-Phong lobe, as 117 HD shades it.
vec3 specularOf(vec4 material, vec3 n, vec3 viewDir, vec3 lightDir, vec3 lightColor) {
  if (material.x <= 0.0) {
    return vec3(0.0);
  }
  vec3 reflected = reflect(-lightDir, n);
  float vDotR = clamp(dot(viewDir, reflected), 1e-6, 1.0);
  return lightColor * (pow(vDotR, material.y) * material.x);
}

// Water appearance per type, four vec4s each as packed by WaterType.table().
struct WaterType {
  vec3 surface;
  bool isFlat;
  bool foam;
  vec3 foamColor;
  float duration;
  vec3 depth;
  float opacity;
  float specularStrength;
  float specularGloss;
  float normalStrength;
  float fresnelAmount;
};

WaterType waterType(uint index) {
  vec4 a = waterTypes.v[index * 4u];
  vec4 b = waterTypes.v[index * 4u + 1u];
  vec4 c = waterTypes.v[index * 4u + 2u];
  vec4 d = waterTypes.v[index * 4u + 3u];
  WaterType t;
  t.surface = a.rgb;
  uint flags = uint(a.w);
  t.isFlat = (flags & 1u) != 0u;
  t.foam = (flags & 2u) != 0u;
  t.foamColor = b.rgb;
  t.duration = b.w;
  t.depth = c.rgb;
  t.opacity = c.w;
  t.specularStrength = d.x;
  t.specularGloss = d.y;
  t.normalStrength = d.z;
  t.fresnelAmount = d.w;
  return t;
}

vec3 vertex(bool dyn, uint index) {
  uint o = index * 3u;
  if (dyn) {
    return vec3(dynPos.v[o], dynPos.v[o + 1u], dynPos.v[o + 2u]);
  }
  return vec3(staticPos.v[o], staticPos.v[o + 1u], staticPos.v[o + 2u]);
}

vec3 unpack(uint c) {
  return vec3(float(c & 0xFFu), float((c >> 8) & 0xFFu), float((c >> 16) & 0xFFu)) / 255.0;
}

uint pcgHash(uint v) {
  uint state = v * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

float rand(inout uint seed) {
  seed = pcgHash(seed);
  return float(seed) / 4294967296.0;
}

void basis(vec3 n, out vec3 t, out vec3 b) {
  t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
  b = cross(n, t);
}

vec3 cosineDirection(vec3 n, inout uint seed) {
  float u1 = rand(seed);
  float u2 = rand(seed);
  float r = sqrt(u1);
  float phi = TWO_PI * u2;
  vec3 t, b;
  basis(n, t, b);
  return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

vec3 coneDirection(vec3 d, float angle, inout uint seed) {
  float u1 = rand(seed);
  float u2 = rand(seed);
  float cosTheta = 1.0 - u1 * (1.0 - cos(angle));
  float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
  float phi = TWO_PI * u2;
  vec3 t, b;
  basis(d, t, b);
  return normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + d * cosTheta);
}

float opacity(bool dyn, uint face) {
  uint c = dyn ? dynCol.c[face] : staticCol.c[face];
  return float(c >> 24) / 255.0;
}

vec2 cornerUv(bool dyn, uint o) {
  return dyn ? vec2(dynUv.v[o], dynUv.v[o + 1u]) : vec2(staticUv.v[o], staticUv.v[o + 1u]);
}

// Interpolated texture coordinates of a face at given barycentrics, including scrolling.
vec2 faceUv(bool dyn, uint face, vec2 bary, uint tex) {
  uint o = face * 6u;
  vec2 uv0 = cornerUv(dyn, o);
  vec2 uv1 = cornerUv(dyn, o + 2u);
  vec2 uv2 = cornerUv(dyn, o + 4u);
  vec2 uv = uv0 * (1.0 - bary.x - bary.y) + uv1 * bary.x + uv2 * bary.y;
  // Scrolling textures move one 128th of a texture per client cycle per unit of speed.
  return uv + texAnim.v[tex - 1u] * (u.motion.y / 128.0);
}

float texHeight(vec2 uv, float layer) {
  return dot(texture(gameTextures, vec3(uv, layer)).rgb, vec3(0.299, 0.587, 0.114));
}

// Texture relief: texel brightness stands in for height, and its gradient along the face's
// tangent directions tilts the shading normal. Heights are in world units, so a texture
// stretched across a large face gets proportionally gentler slopes.
vec3 bumpNormal(vec3 n, vec3 v0, vec3 v1, vec3 v2, bool dyn, uint face, vec2 uv, float layer, float strength) {
  uint o = face * 6u;
  vec2 uv0 = cornerUv(dyn, o);
  vec2 d1 = cornerUv(dyn, o + 2u) - uv0;
  vec2 d2 = cornerUv(dyn, o + 4u) - uv0;
  float det = d1.x * d2.y - d1.y * d2.x;
  if (abs(det) < 1e-6) {
    return n;
  }
  vec3 e1 = v1 - v0;
  vec3 e2 = v2 - v0;
  vec3 t = (e1 * d2.y - e2 * d1.y) / det;
  vec3 b = (e2 * d1.x - e1 * d2.x) / det;
  float texel = 1.0 / 128.0;
  float dhdu = (texHeight(uv + vec2(texel, 0.0), layer) - texHeight(uv - vec2(texel, 0.0), layer)) / (2.0 * texel);
  float dhdv = (texHeight(uv + vec2(0.0, texel), layer) - texHeight(uv - vec2(0.0, texel), layer)) / (2.0 * texel);
  // The full brightness range stands for this many world units of height at full strength.
  float amplitude = strength * 24.0;
  vec3 grad = (dhdu * t / dot(t, t) + dhdv * b / dot(b, b)) * amplitude;
  grad -= n * dot(grad, n);
  return normalize(n - grad);
}

// Translucent geometry is built without the opaque flag, so only its triangles show up as
// candidates here. Textured candidates with a hole at the hit point are skipped; the rest are
// accepted with probability equal to their opacity, which the accumulation turns into an alpha
// blend, and shadow rays get proportional occlusion the same way.
// Returns the distance of the nearest translucent candidate seen, whether accepted or not.
float resolveCandidates(rayQueryEXT rq, inout uint seed) {
  float nearest = FAR;
  while (rayQueryProceedEXT(rq)) {
    uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false));
    bool dyn = (custom & DYN_BIT) != 0u;
    uint face = (custom & 0x7FFFFFu) + uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
    uint texField = dyn ? dynTex.t[face] : staticTex.t[face];
    uint tex = texField & 0xFFFFu;
    if (tex != 0u && (texField & WATER_BIT) == 0u && (u.misc.y & FLAG_TEXTURES) != 0u) {
      vec2 uv = faceUv(dyn, face, rayQueryGetIntersectionBarycentricsEXT(rq, false), tex);
      if (texture(gameTextures, vec3(uv, float(tex - 1u))).a < 0.5) {
        continue;
      }
    }
    nearest = min(nearest, rayQueryGetIntersectionTEXT(rq, false));
    if (rand(seed) < opacity(dyn, face)) {
      rayQueryConfirmIntersectionEXT(rq);
    }
  }
  return nearest;
}

bool occluded(vec3 origin, vec3 dir, inout uint seed) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT, MASK_SHADOW, origin, RAY_EPS, dir, FAR);
  resolveCandidates(rq, seed);
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

bool occludedWithin(vec3 origin, vec3 dir, float tMax) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT, MASK_SHADOW, origin, RAY_EPS, dir, tMax);
  rayQueryProceedEXT(rq);
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// Irradiance from the local lights at a hit, before the albedo: 117 HD's falloff, squared
// distance fraction from the light's edge, with a shadow ray to each light in range. Their
// specular highlights towards the viewer accumulate separately as radiance.
vec3 directLocalSpecular(Hit hit, vec3 viewDir, inout vec3 specular) {
  int count = int(u.lights.x);
  vec3 sum = vec3(0.0);
  for (int i = 0; i < count; ++i) {
    vec4 pr = localLights.v[i * 2];
    vec3 toLight = pr.xyz - hit.p;
    float d2 = dot(toLight, toLight);
    if (d2 >= pr.w * pr.w) {
      continue;
    }
    float d = sqrt(d2);
    vec3 l = toLight / d;
    float ndl = dot(hit.n, l);
    if (ndl <= 0.0 || occludedWithin(hit.p, l, d - 2.0)) {
      continue;
    }
    float falloff = 1.0 - d / pr.w;
    vec3 color = localLights.v[i * 2 + 1].rgb * (falloff * falloff * u.lights.y);
    sum += color * ndl;
    specular += specularOf(hit.material, hit.n, viewDir, l, color);
  }
  return sum;
}

vec3 directLocal(Hit hit) {
  vec3 unused = vec3(0.0);
  return directLocalSpecular(hit, vec3(0.0), unused);
}

bool trace(vec3 origin, vec3 dir, float tMin, float tMax, uint rayFlags, uint mask, inout uint seed, out Hit hit) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, rayFlags, mask, origin, tMin, dir, tMax);
  float nearestTranslucent = resolveCandidates(rq, seed);
  if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
    return false;
  }
  hit.t = rayQueryGetIntersectionTEXT(rq, true);
  hit.covered = nearestTranslucent <= hit.t;
  uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
  uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
  hit.dyn = (custom & DYN_BIT) != 0u;
  uint face = (custom & 0x7FFFFFu) + prim;

  vec3 v0 = vertex(hit.dyn, face * 3u);
  vec3 v1 = vertex(hit.dyn, face * 3u + 1u);
  vec3 v2 = vertex(hit.dyn, face * 3u + 2u);
  vec3 n = normalize(cross(v1 - v0, v2 - v0));
  if (dot(n, dir) > 0.0) {
    n = -n;
  }
  hit.n = n;
  hit.gn = n;
  hit.surface = origin + dir * hit.t;
  hit.p = hit.surface + n * RAY_EPS;
  uint packed = hit.dyn ? dynCol.c[face] : staticCol.c[face];
  hit.albedo = unpack(packed);
  hit.translucent = (packed >> 24) != 0xFFu;

  // Textured faces: interpolate the face's UVs with the hit barycentrics and sample the
  // texture; fully transparent texels fall back to the face's flat colour.
  uint texField = hit.dyn ? dynTex.t[face] : staticTex.t[face];
  hit.water = (texField & WATER_BIT) != 0u && (u.misc.y & FLAG_WATER) != 0u;
  hit.waterType = hit.water ? (texField >> 16) & 0xFFu : 0u;
  uint tex = texField & 0xFFFFu;
  hit.material = materialOf(tex);
  hit.terrain = (texField & TERRAIN_BIT) != 0u;
  hit.flame = (texField & FLAME_BIT) != 0u;
  hit.highlight = (texField >> 24) & 0xFu;
  if (hit.terrain) {
    if ((u.misc.y & FLAG_SMOOTH_TERRAIN) != 0u) {
      // The three vertex colours ride in the UV slots as raw bits.
      vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
      uint o = face * 6u;
      vec3 c0 = unpack(floatBitsToUint(hit.dyn ? dynUv.v[o] : staticUv.v[o]));
      vec3 c1 = unpack(floatBitsToUint(hit.dyn ? dynUv.v[o + 1u] : staticUv.v[o + 1u]));
      vec3 c2 = unpack(floatBitsToUint(hit.dyn ? dynUv.v[o + 2u] : staticUv.v[o + 2u]));
      hit.albedo = c0 * (1.0 - bary.x - bary.y) + c1 * bary.x + c2 * bary.y;
      vec3 smooth_ = smoothTerrainNormal(hit.surface, n);
      hit.n = dot(smooth_, dir) > 0.0 ? n : smooth_;
    }
    if ((u.misc.y & FLAG_TERRAIN_TEXTURES) != 0u && tex != 0u) {
      // Ground detail tiles in world space, one repeat per tile; it modulates the tile's colour.
      vec2 uv = hit.surface.xz / 128.0;
      hit.albedo *= texture(gameTextures, vec3(uv, float(tex - 1u))).rgb * 2.0;
      if (hit.material.w > 0.0 && u.material.z > 0.0) {
        vec3 tn = texture(gameTextures, vec3(uv, hit.material.w - 1.0)).rgb * 2.0 - 1.0;
        hit.n = normalize(hit.n + (vec3(1.0, 0.0, 0.0) * tn.x + vec3(0.0, 0.0, 1.0) * tn.y) * (0.8 * u.material.z));
      }
    }
  } else if (tex != 0u && !hit.water && (u.misc.y & FLAG_TEXTURES) != 0u) {
    vec2 uv = faceUv(hit.dyn, face, rayQueryGetIntersectionBarycentricsEXT(rq, true), tex);
    vec4 texel = texture(gameTextures, vec3(uv, float(tex - 1u)));
    hit.albedo = mix(hit.albedo, texel.rgb, texel.a);
    if (u.motion.z > 0.0) {
      hit.n = bumpNormal(n, v0, v1, v2, hit.dyn, face, uv, float(tex - 1u), u.motion.z);
    }
  }
  return true;
}

// Scene space has north along +z, east along +x and up along -y.
vec2 skyUv(vec3 d) {
  float az = atan(d.x, d.z) + u.extra.x;
  return vec2(az / TWO_PI + 0.5, acos(clamp(-d.y, -1.0, 1.0)) / 3.14159265359);
}

// The scattered-light sky map is laid out the same way, fixed to north.
vec2 atmosphereUv(vec3 d) {
  return vec2(atan(d.x, d.z) / TWO_PI + 0.5, acos(clamp(-d.y, -1.0, 1.0)) / 3.14159265359);
}

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return fract((p.x + p.y) * p.z);
}

float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

float valueNoise2(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x), mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);
}

float valueNoise3(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float n00 = mix(hash13(i), hash13(i + vec3(1.0, 0.0, 0.0)), f.x);
  float n10 = mix(hash13(i + vec3(0.0, 1.0, 0.0)), hash13(i + vec3(1.0, 1.0, 0.0)), f.x);
  float n01 = mix(hash13(i + vec3(0.0, 0.0, 1.0)), hash13(i + vec3(1.0, 0.0, 1.0)), f.x);
  float n11 = mix(hash13(i + vec3(0.0, 1.0, 1.0)), hash13(i + vec3(1.0, 1.0, 1.0)), f.x);
  return mix(mix(n00, n10, f.y), mix(n01, n11, f.y), f.z);
}

// Base of the cloud layer and its thickness; up is -y and the ground lies near zero.
const float CLOUD_Y = -3200.0;
const float CLOUD_THICKNESS = 1400.0;
const int CLOUD_STEPS = 32;
const float CLOUD_SIGMA = 0.0045;

// Cloud density 0 to 1 over a point of the cloud layer: a drifting noise field thresholded by
// the weather's cloud cover, so more cover means broader, thicker clouds.
float cloudDensity(vec2 xz) {
  float cover = u.weather.x;
  if (cover <= 0.0) {
    return 0.0;
  }
  vec2 q = (xz + vec2(u.weather2.z, u.weather2.w) * 0.6 + u.weather3.x * vec2(9.0, 3.0)) / 2200.0;
  float n = 0.5 * valueNoise2(q) + 0.25 * valueNoise2(q * 2.03 + 3.1) + 0.125 * valueNoise2(q * 4.1 + 7.7) + 0.0625 * valueNoise2(q * 8.3 + 1.3);
  n /= 0.9375;
  float threshold = 1.0 - cover * 0.95;
  return smoothstep(threshold - 0.1, threshold + 0.25, n);
}

float heightAt(int plane, int side, int x, int y) {
  return tileHeights.v[(plane * side + x) * side + y];
}

// Smooth terrain normal at a point: vertex normals from the tile height grid by central
// differences, blended bilinearly. The plane is whichever has its surface nearest the point.
// Up is -y, so the upward normal of the surface y = h(x, z) is (dh/dx, -1, dh/dz).
vec3 smoothTerrainNormal(vec3 p, vec3 fallback) {
  int side = int(u.weather3.z);
  if (side < 3) {
    return fallback;
  }
  vec2 g = p.xz / 128.0 + u.weather3.w;
  if (g.x < 1.0 || g.y < 1.0 || g.x >= float(side - 2) || g.y >= float(side - 2)) {
    return fallback;
  }
  ivec2 i = ivec2(g);
  vec2 f = g - vec2(i);
  int plane = 0;
  float best = 1e9;
  for (int c = 0; c < 4; ++c) {
    float h = mix(mix(heightAt(c, side, i.x, i.y), heightAt(c, side, i.x + 1, i.y), f.x),
                  mix(heightAt(c, side, i.x, i.y + 1), heightAt(c, side, i.x + 1, i.y + 1), f.x), f.y);
    float d = abs(h - p.y);
    if (d < best) {
      best = d;
      plane = c;
    }
  }
  if (best > 64.0) {
    return fallback;
  }
  vec3 n[4];
  for (int k = 0; k < 4; ++k) {
    int x = i.x + (k & 1);
    int y = i.y + (k >> 1);
    float dx = (heightAt(plane, side, x + 1, y) - heightAt(plane, side, x - 1, y)) / 256.0;
    float dz = (heightAt(plane, side, x, y + 1) - heightAt(plane, side, x, y - 1)) / 256.0;
    n[k] = normalize(vec3(dx, -1.0, dz));
  }
  return normalize(mix(mix(n[0], n[1], f.x), mix(n[2], n[3], f.x), f.y));
}

// Puddle coverage of the ground under a world position, from the per-scene grid.
float puddleAt(vec2 xz) {
  int side = int(u.weather3.z);
  if (side < 2) {
    return 0.0;
  }
  vec2 g = xz / 128.0 + u.weather3.w;
  if (g.x < 0.0 || g.y < 0.0 || g.x >= float(side - 1) || g.y >= float(side - 1)) {
    return 0.0;
  }
  ivec2 i = ivec2(g);
  vec2 f = g - vec2(i);
  float a = groundGrid.v[i.x * side + i.y].z;
  float b = groundGrid.v[(i.x + 1) * side + i.y].z;
  float c = groundGrid.v[i.x * side + i.y + 1].z;
  float d = groundGrid.v[(i.x + 1) * side + i.y + 1].z;
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Standing and flowing rainwater under a world position: depth and flow, bilinear over the grid.
vec4 runoffAt(vec2 xz) {
  int side = int(u.weather3.z);
  if (side < 2) {
    return vec4(0.0);
  }
  vec2 g = xz / 128.0 + u.weather3.w;
  if (g.x < 0.0 || g.y < 0.0 || g.x >= float(side - 1) || g.y >= float(side - 1)) {
    return vec4(0.0);
  }
  ivec2 i = ivec2(g);
  vec2 f = g - vec2(i);
  vec4 a = runoff.v[i.x * side + i.y];
  vec4 b = runoff.v[(i.x + 1) * side + i.y];
  vec4 c = runoff.v[i.x * side + i.y + 1];
  vec4 d = runoff.v[(i.x + 1) * side + i.y + 1];
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Footprints pressed into snow and wet ground: each an oval turned along the step, darkening the
// ground and tilting the normal into a shallow hollow, fading as the minutes pass.
void footprint(inout Hit hit, float snow) {
  int count = int(u.ground.x);
  float t = u.weather3.x;
  float life = snow > 0.05 ? 300.0 : 60.0;
  for (int i = 0; i < count; ++i) {
    vec4 a = prints.v[i * 2];
    vec2 d = hit.surface.xz - a.xz;
    if (abs(d.x) > 20.0 || abs(d.y) > 20.0 || abs(hit.surface.y - a.y) > 40.0) {
      continue;
    }
    float age = t - a.w;
    if (age < 0.0 || age > life) {
      continue;
    }
    vec2 heading = prints.v[i * 2 + 1].xy;
    vec2 local = vec2(dot(d, heading), dot(d, vec2(-heading.y, heading.x)));
    // A foot: longer along the step than across, a little wider at the toe.
    vec2 radii = vec2(13.0, 6.5 + 1.5 * smoothstep(-10.0, 10.0, local.x));
    float r = length(local / radii);
    if (r > 1.2) {
      continue;
    }
    float press = (1.0 - smoothstep(0.7, 1.2, r)) * (1.0 - age / life) * u.ground.y;
    vec2 lean = -normalize(d + 1e-4) * smoothstep(0.2, 1.0, r) * (1.0 - smoothstep(0.9, 1.2, r));
    hit.n = normalize(hit.n + vec3(lean.x, 0.0, lean.y) * (0.6 * press));
    hit.albedo *= 1.0 - (snow > 0.05 ? 0.25 : 0.35) * press;
  }
}

// Sunlight reaching a point under the cloud layer, 1 in the open.
float cloudShadow(vec3 p) {
  if ((u.misc.y & FLAG_CLOUD_SHADOWS) == 0u || u.weather.x <= 0.0 || u.sun.y >= 0.0) {
    return 1.0;
  }
  float t = (CLOUD_Y - p.y) / u.sun.y;
  return 1.0 - 0.85 * cloudDensity(p.xz + u.sun.xz * t);
}

// Undoes the final pass's filmic curve: the pre-exposure radiance that maps to a display colour.
vec3 inverseTonemap(vec3 y) {
  y = min(y, vec3(0.999));
  vec3 a = 2.51 - 2.43 * y;
  vec3 b = 0.03 - 0.59 * y;
  vec3 c = -0.14 * y;
  return (-b + sqrt(b * b - 4.0 * a * c)) / (2.0 * a) / u.params.y;
}

// Analytic sky: a zenith-to-horizon gradient following the real sun through the day, warmth
// near a low sun, a glow and disc around the light, and stars at night. Up is -y.
vec3 proceduralSky(vec3 d, bool withDisc) {
  float up = clamp(-d.y, 0.0, 1.0);
  float sunUp = u.post2.w;
  float day = smoothstep(-0.12, 0.15, sunUp);
  float cosS = dot(d, u.sun.xyz);
  vec3 sky;
  if ((u.misc.y & FLAG_PHYSICAL_SKY) != 0u) {
    // Sunlight scattered in the air, computed on the CPU into a map; the sun's own glow is in
    // it. A faint floor stands in for starlight and airglow once the light has gone. Below the
    // horizon the map holds only the short path to the ground, so the horizon's own colour is
    // carried down, dimming with depression.
    vec3 level = d.y > 0.0 ? normalize(vec3(d.x, 0.0, d.z) + vec3(0.0, 0.0, 1e-5)) : d;
    sky = texture(skyLut, atmosphereUv(level)).rgb * (1.0 - 0.4 * smoothstep(0.0, 0.5, d.y)) + vec3(0.0025, 0.003, 0.006) * (1.0 - day);
  } else {
    float low = (1.0 - smoothstep(0.0, 0.35, abs(sunUp))) * day;
    float horizonWeight = pow(1.0 - up, 2.5);
    vec3 zenith = mix(vec3(0.004, 0.006, 0.014), vec3(0.16, 0.36, 0.78), day);
    vec3 horizon = mix(vec3(0.012, 0.014, 0.024), vec3(0.62, 0.74, 0.90), day);
    sky = mix(zenith, horizon, horizonWeight);
    vec2 flatDir = normalize(d.xz + 1e-5);
    vec2 flatSun = normalize(u.sun.xz + 1e-5);
    float towardSun = pow(max(dot(flatDir, flatSun), 0.0), 3.0);
    sky = mix(sky, vec3(0.95, 0.45, 0.2), low * horizonWeight * (0.4 + 0.6 * towardSun));
    // A tight glow around the light with a faint wide halo, both stronger near the horizon.
    float glow = pow(max(cosS, 0.0), 48.0) + 0.2 * pow(max(cosS, 0.0), 6.0);
    sky += u.sunColor.rgb * (0.05 * mix(0.15, 1.0, day) * (1.0 + 4.0 * low)) * glow;
  }
  if (day < 0.5) {
    float nightly = 1.0 - day * 2.0;
    if (u.star0.w > 0.0) {
      // The real sky: the view direction taken back to equatorial coordinates and looked up.
      vec3 e = vec3(dot(u.star0.xyz, d), dot(u.star1.xyz, d), dot(u.star2.xyz, d));
      vec2 uv = vec2(fract(atan(e.y, e.x) / 6.2831853), 0.5 - asin(clamp(e.z, -1.0, 1.0)) / 3.14159265);
      sky += texture(starMap, uv).rgb * (u.star0.w * nightly);
    } else {
      // Sparse stars, fading with dawn.
      float star = step(0.9985, hash13(floor(d * 220.0)));
      sky += vec3(0.6) * star * nightly;
    }
  }
  if (withDisc) {
    // The disc's size is its own setting, independent of the shadow softness.
    float r = max(u.wind.z, 0.001);
    float disc = smoothstep(cos(r * 1.6), cos(r), cosS);
    if (disc > 0.0 && day < 0.5 && u.night.w >= 0.0) {
      // The moon: its sphere shaded by the sun's direction, so the disc shows the phase.
      vec3 side = normalize(cross(u.sun.xyz, abs(u.sun.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
      vec3 upDir = cross(side, u.sun.xyz);
      vec3 across = d - u.sun.xyz * cosS;
      vec2 offset = vec2(dot(across, side), dot(across, upDir)) / sin(r);
      float rr = min(dot(offset, offset), 1.0);
      vec3 n = normalize(side * offset.x + upDir * offset.y - u.sun.xyz * sqrt(1.0 - rr));
      float lit = smoothstep(-0.03, 0.12, dot(n, u.night.xyz));
      disc *= mix(0.03, 1.0, lit);
    }
    sky += u.sunColor.rgb * mix(2.0, 30.0, day) * disc;
  }
  return sky;
}

// Cloud density inside the layer: the weather's coverage field shaped into flat-bottomed heaps
// by a height profile and eroded at its edges by three-dimensional noise drifting with the wind.
float cloudVolume(vec3 p, float t) {
  float cover = cloudDensity(p.xz);
  if (cover <= 0.0) {
    return 0.0;
  }
  float h = (CLOUD_Y - p.y) / CLOUD_THICKNESS;
  float profile = smoothstep(0.0, 0.12, h) * (1.0 - smoothstep(0.5, 1.0, h));
  float base = cover * profile;
  if (base <= 0.0) {
    return 0.0;
  }
  vec3 q = (p + vec3(u.weather2.z, 0.0, u.weather2.w) * 0.6 + vec3(9.0, 0.0, 3.0) * t) / 420.0;
  float n = 0.65 * valueNoise3(q) + 0.35 * valueNoise3(q * 2.7 + 5.0);
  return smoothstep(0.0, 0.55, base - 0.5 * (1.0 - base) * n) * 0.9;
}

vec3 skyRadiance(vec3 d);

float henyeyGreenstein(float cosTheta, float g) {
  float gg = g * g;
  return (1.0 - gg) / pow(1.0 + gg - 2.0 * g * cosTheta, 1.5);
}

// Volumetric clouds for the camera: the view ray is marched through the layer, each sample lit
// by sunlight that has itself been marched toward the sun through the cloud, with forward
// scattering, a powder darkening of dense cores and ambient light from the sky above. Sky pixels
// keep no history, so the march is dithered rather than jittered.
vec3 withClouds(vec3 sky, vec3 d) {
  if ((u.misc.y & FLAG_CLOUDS) == 0u || d.y >= -0.02 || u.weather.x <= 0.0) {
    return sky;
  }
  float tA = (CLOUD_Y - u.cam.y) / d.y;
  float tB = (CLOUD_Y - CLOUD_THICKNESS - u.cam.y) / d.y;
  float tMin = max(min(tA, tB), 0.0);
  float tMax = min(max(tA, tB), tMin + 40000.0);
  if (tMax <= tMin) {
    return sky;
  }
  float t = u.weather3.x;
  float dt = (tMax - tMin) / float(CLOUD_STEPS);
  vec2 px = vec2(gl_GlobalInvocationID.xy);
  float dither = fract(52.9829189 * fract(0.06711056 * px.x + 0.00583715 * px.y));
  vec3 sunDir = u.sun.xyz;
  float cosTheta = dot(d, sunDir);
  float phase = 0.75 * henyeyGreenstein(cosTheta, 0.3) + 0.25 * henyeyGreenstein(cosTheta, -0.15);
  vec3 sunLight = u.sunColor.rgb * u.sun.w;
  vec3 ambient = skyRadiance(vec3(0.0, -1.0, 0.0)) * 0.5;
  bool lit = u.sun.w > 0.0 && sunDir.y < 0.0;
  float transmittance = 1.0;
  vec3 scattered = vec3(0.0);
  for (int i = 0; i < CLOUD_STEPS && transmittance > 0.02; ++i) {
    vec3 p = u.cam.xyz + d * (tMin + dt * (float(i) + dither));
    float density = cloudVolume(p, t);
    if (density <= 0.0) {
      continue;
    }
    float shade = 0.0;
    if (lit) {
      vec3 lp = p;
      float step_ = 160.0;
      for (int k = 0; k < 3; ++k) {
        lp += sunDir * step_;
        if (lp.y < CLOUD_Y - CLOUD_THICKNESS || lp.y > CLOUD_Y) {
          break;
        }
        shade += cloudVolume(lp, t) * step_;
        step_ *= 1.7;
      }
    }
    float h = (CLOUD_Y - p.y) / CLOUD_THICKNESS;
    float sunlit = exp(-shade * CLOUD_SIGMA) * (1.0 - 0.6 * exp(-density * 4.0));
    vec3 light = sunLight * (phase * sunlit * 1.6) + ambient * (0.35 + 0.65 * h);
    float alpha = 1.0 - exp(-density * dt * CLOUD_SIGMA);
    scattered += transmittance * alpha * light;
    transmittance *= 1.0 - alpha;
  }
  float fade = smoothstep(0.02, 0.18, -d.y);
  return sky * mix(1.0, transmittance, fade) + scattered * fade;
}

// Cloud cover greys and dims the sky towards a uniform overcast.
vec3 overcast(vec3 c) {
  float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
  return mix(c, vec3(l), 0.85 * u.weather.x) * (1.0 - 0.45 * u.weather.x);
}

// Sky radiance used to light surfaces: the skybox or flat colour, scaled by the sky intensity.
vec3 skyRadiance(vec3 d) {
  vec3 c;
  if ((u.misc.y & FLAG_PROCEDURAL_SKY) != 0u) {
    c = proceduralSky(d, false) * u.sky.rgb;
  } else {
    c = (u.misc.y & FLAG_SKYBOX) == 0u ? u.sky.rgb : texture(skybox, skyUv(d)).rgb * u.sky.rgb;
  }
  return overcast(c) + vec3(2.0 * u.fog.w);
}

vec3 spectrum(float t) {
  vec3 a = mix(vec3(0.55, 0.0, 1.0), vec3(0.0, 0.4, 1.0), smoothstep(0.0, 0.25, t));
  a = mix(a, vec3(0.0, 1.0, 0.3), smoothstep(0.25, 0.5, t));
  a = mix(a, vec3(1.0, 1.0, 0.0), smoothstep(0.5, 0.75, t));
  return mix(a, vec3(1.0, 0.05, 0.0), smoothstep(0.75, 1.0, t));
}

// A rainbow when the sun is low behind the viewer and rain is falling or has just fallen: the
// primary bow forty-two degrees from the point opposite the sun with red outside, and the
// fainter secondary at fifty-two with its colours reversed.
vec3 rainbow(vec3 d) {
  if ((u.misc.y & FLAG_RAINBOWS) == 0u || u.sun.w <= 0.0 || u.sun.y >= 0.0 || u.post2.w > 0.66 || d.y > 0.0) {
    return vec3(0.0);
  }
  float wet = max(u.weather.z, smoothstep(0.35, 0.8, u.weather2.x)) * (1.0 - 0.8 * u.weather.x);
  if (wet <= 0.0) {
    return vec3(0.0);
  }
  float angle = degrees(acos(clamp(dot(d, -u.sun.xyz), -1.0, 1.0)));
  vec3 bow = vec3(0.0);
  float t1 = (angle - 40.6) / 1.8;
  if (t1 > 0.0 && t1 < 1.0) {
    bow += spectrum(t1) * sin(3.14159265 * t1);
  }
  float t2 = (53.6 - angle) / 3.2;
  if (t2 > 0.0 && t2 < 1.0) {
    bow += spectrum(t2) * (0.35 * sin(3.14159265 * t2));
  }
  return bow * (0.28 * wet * min(u.sun.w, 1.0) * smoothstep(0.0, -0.05, d.y));
}

// Curtains of aurora on clear nights: a thin layer far above the clouds, to the north, marched
// along the view ray; green low and violet high, folding and rippling slowly with time.
vec3 aurora(vec3 d) {
  float weight = u.star1.w * (1.0 - smoothstep(-0.2, -0.05, u.post2.w)) * (1.0 - u.weather.x);
  if (weight <= 0.001 || d.y > -0.03) {
    return vec3(0.0);
  }
  const float BOTTOM = -9000.0;
  const float TOP = -16000.0;
  const int STEPS = 14;
  float t0 = (BOTTOM - u.cam.y) / d.y;
  float t1 = (TOP - u.cam.y) / d.y;
  float dt = (t1 - t0) / float(STEPS);
  float t = u.weather3.x;
  vec3 sum = vec3(0.0);
  for (int i = 0; i < STEPS; ++i) {
    vec3 q = d * (t0 + dt * (float(i) + 0.5));
    float h = (BOTTOM - (u.cam.y + q.y)) / (BOTTOM - TOP);
    float fold = valueNoise2(vec2(q.x / 2600.0 + t * 0.02, t * 0.05)) * 2600.0;
    float across = (q.z - (6000.0 + fold)) / 1500.0;
    float second = (q.z - (9500.0 - fold * 0.6)) / 1100.0;
    float curtain = exp(-across * across) + 0.6 * exp(-second * second);
    float ripple = 0.55 + 0.45 * valueNoise2(vec2(q.x / 380.0 - t * 0.15, h * 3.0 + t * 0.1));
    float vertical = smoothstep(0.0, 0.15, h) * exp(-h * 2.2);
    sum += mix(vec3(0.15, 1.0, 0.35), vec3(0.65, 0.2, 1.0), smoothstep(0.2, 0.9, h)) * (curtain * ripple * vertical);
  }
  return sum * (0.0045 * weight);
}

// The fog colour in a direction: the sky's own horizon colour there, so far scenery and the
// void beyond the loaded scene meet the sky they stand against.
vec3 horizonAt(vec3 d) {
  // The skybox turns with its rotation setting; the procedural sky does not.
  float turn = (u.misc.y & FLAG_PROCEDURAL_SKY) != 0u ? 0.0 : u.extra.x;
  float f = fract((atan(d.x, d.z) + turn) / TWO_PI + 0.5) * 8.0 - 0.5;
  int i = int(floor(f + 8.0)) & 7;
  return mix(u.horizon[i].rgb, u.horizon[(i + 1) & 7].rgb, fract(f));
}

// What the camera sees where no geometry is: the sky at its painted colours, shown as-is,
// under the cloud cover, with fog thickening towards the horizon and lightning whitening it.
vec3 skyBackground(vec3 d) {
  vec3 c;
  if ((u.misc.y & FLAG_PROCEDURAL_SKY) != 0u) {
    c = withClouds(proceduralSky(d, true) + aurora(d), d);
  } else {
    c = withClouds(overcast((u.misc.y & FLAG_SKYBOX) == 0u ? u.extra.yzw : texture(skybox, skyUv(d)).rgb) + aurora(d), d);
  }
  c += rainbow(d);
  float horizon = 1.0 - clamp(-d.y * 4.0, 0.0, 1.0);
  c = mix(c, u.fog.rgb, clamp(u.weather.y, 0.0, 1.0) * horizon);
  return c + vec3(0.8 * u.fog.w);
}

// Slope of the rings spreading from raindrops: one drop per cell of forty units, each ring
// restarting at its own phase, scaled by how hard it rains.
vec2 rainRippleGradient(vec2 xz) {
  vec2 cell = floor(xz / 40.0);
  vec2 centre = (cell + 0.5 + 0.3 * (vec2(hash12(cell), hash12(cell + 19.0)) - 0.5)) * 40.0;
  float phase = fract(u.weather3.x * 1.3 + hash12(cell + 7.0));
  vec2 d = xz - centre;
  float dist = length(d) + 1e-3;
  float ring = sin((dist - phase * 26.0) * 0.5) * exp(-dist * 0.08) * (1.0 - phase);
  return (d / dist) * (ring * 1.5 * u.weather.z);
}

// Animated wave normal for a water surface; up is -y. Strength scales the slopes and
// duration stretches the animation, as 117 HD's water types define them.
// Water waves as a spectrum of many directional waves rather than a few sines: wavelengths
// spread from a hand to a few tiles with a Phillips-like falloff, directions scatter about the
// wind with short chop scattering widest, each travels at the speed deep-water dispersion gives
// its length, and crests are sharpened as Gerstner waves are. Two octaves of warped noise ride
// on top, so no interference pattern stays fixed long enough to read as one.
vec3 waterNormal(vec3 p, float strength, float duration) {
  // Real time, so the waves move the same at any frame rate; a type's duration slows them.
  float t = u.weather3.x * 0.9 / max(duration, 0.05);
  vec2 windDir = dot(u.wind.xy, u.wind.xy) > 1.0 ? normalize(u.wind.xy) : vec2(0.62, 0.78);
  float windAngle = atan(windDir.y, windDir.x);
  vec2 grad = vec2(0.0);
  for (int i = 0; i < 24; ++i) {
    float fi = float(i);
    float h1 = fract(sin(fi * 12.9898) * 43758.5453);
    float h2 = fract(sin(fi * 78.233 + 1.0) * 43758.5453);
    float h3 = fract(sin(fi * 37.719 + 2.0) * 43758.5453);
    float wavelength = 15.0 * pow(400.0 / 15.0, (fi + h1) / 24.0);
    float k = 6.2831853 / wavelength;
    float spread = mix(0.35, 1.2, 1.0 - fi / 24.0);
    float a = windAngle + (h2 - 0.5) * 2.0 * spread;
    vec2 d = vec2(cos(a), sin(a));
    // A tile is taken as a metre, so gravity is 9.8 metres of 128 units per second squared.
    float omega = sqrt(9.8 * 128.0 * k);
    float phase = dot(d, p.xz) * k - omega * t + h3 * 6.2831853;
    float s = sin(phase);
    // The sharpened crest's slope: the derivative of a raised, narrowed sine.
    float dh = 0.8 * pow(0.5 + 0.5 * s, 0.6) * cos(phase);
    float slope = 0.22 * pow(wavelength / 400.0, 0.25);
    grad += d * (slope * dh);
  }
  grad *= 2.0;
  vec2 q = p.xz / 42.0 + vec2(t * 0.15, -t * 0.11);
  vec2 warp = vec2(valueNoise2(q + 3.1), valueNoise2(q - 2.7)) - 0.5;
  grad += (vec2(valueNoise2(q * 2.0 + warp * 0.8), valueNoise2(q * 2.0 + warp * 0.8 + 5.3)) - 0.5) * 0.35;
  if ((u.misc.y & FLAG_RAIN_RIPPLES) != 0u && u.weather.z > 0.0) {
    grad += rainRippleGradient(p.xz) / max(strength, 0.02);
  }
  return normalize(vec3(-grad.x * strength, -1.0, -grad.y * strength));
}

vec3 directSun(Hit hit, vec3 sunDir, bool shadows, inout uint seed);

// 117 HD's water adapted to traced reflections. The surface is its type's own colour under
// the scene light plus a specular sun highlight and foam along the shore, shown over the bed
// seen through the surface at an opacity that rises with Fresnel and foam. The reflection of
// the scene stands in for 117 HD's sky gradient, and flat types hide the bed entirely.
// The surface seen from beneath: beyond the critical angle it mirrors the underwater scene, and
// within it the sky shows through, bent by refraction and dimmed by Fresnel.
vec3 shadeWaterFromBelow(Hit hit, vec3 dir, vec3 sunDir, bool shadows, inout uint seed) {
  WaterType wt = waterType(hit.waterType);
  vec3 wn = -waterNormal(hit.surface, wt.normalStrength * u.path.w, wt.duration);
  float cosI = clamp(dot(-dir, wn), 0.0, 1.0);
  vec3 reflectDir = reflect(dir, wn);
  vec3 reflection = vec3(0.02, 0.10, 0.12);
  Hit mirror;
  if (trace(hit.surface + wn * RAY_EPS, reflectDir, RAY_EPS, FAR, gl_RayFlagsNoneEXT, MASK_OPAQUE, seed, mirror)) {
    reflection = mirror.albedo * (vec3(u.sky.w) + 0.3 * directSun(mirror, sunDir, shadows, seed) + directLocal(mirror));
  }
  vec3 refracted = refract(dir, wn, 1.33);
  if (dot(refracted, refracted) == 0.0) {
    return reflection;
  }
  float fresnel = 0.02 + 0.98 * pow(1.0 - cosI, 5.0);
  return mix(skyBackground(refracted) * 0.9, reflection, fresnel);
}

vec3 shadeWater(Hit hit, vec3 dir, vec3 sunDir, bool shadows, inout uint seed) {
  WaterType wt = waterType(hit.waterType);
  vec3 wn = waterNormal(hit.surface, wt.normalStrength * u.path.w, wt.duration);
  float viewDot = clamp(dot(-dir, wn), 0.0, 1.0);
  float finalFresnel = clamp(mix(0.4, 1.0, (1.0 - viewDot) * 1.2), 0.0, 1.0);

  float ndl = max(dot(wn, sunDir), 0.0);
  float lit = (shadows && ndl > 0.0 && occluded(hit.p, sunDir, seed)) ? 0.0 : cloudShadow(hit.p);
  vec3 reflectDir = reflect(dir, wn);
  if (dot(reflectDir, hit.gn) < 0.0) {
    reflectDir = reflect(reflectDir, hit.gn);
  }
  float spec = pow(clamp(dot(reflectDir, sunDir), 1e-10, 1.0), wt.specularGloss) * wt.specularStrength;
  vec3 specular = u.sunColor.rgb * (u.sun.w * lit * spec);
  // The whole sky dome lights the surface, standing in for the bounce light the ground gets.
  vec3 composite = vec3(u.sky.w) + u.sunColor.rgb * (u.sun.w * ndl * lit) + skyRadiance(wn) * max(-wn.y, 0.0) + vec3(2.0 * u.fog.w) + directLocal(hit);

  vec3 reflection;
  Hit mirror;
  if (trace(hit.p, reflectDir, RAY_EPS, FAR, gl_RayFlagsNoneEXT, MASK_ALL, seed, mirror)) {
    reflection = mirror.albedo * (vec3(u.sky.w) + directSun(mirror, sunDir, shadows, seed) + 0.5 * skyRadiance(mirror.n));
  } else {
    reflection = skyBackground(reflectDir);
  }
  // 117 HD's light terms sum to about half again what ours do for the same scene, and its
  // colours were tuned against that.
  vec3 base = wt.surface * (composite * 1.5 + reflection * max(wt.specularStrength, 0.2));
  base = mix(base, reflection, wt.fresnelAmount * finalFresnel);

  // The bed through the surface, tinted towards the depth colour and then to black as it deepens.
  vec3 under = vec3(0.0);
  float bedDepth = 0.0;
  bool sawBed = false;
  if (!wt.isFlat) {
    vec3 refracted = refract(dir, wn, 1.0 / 1.33);
    Hit bed;
    if (dot(refracted, refracted) > 0.0 && trace(hit.surface - hit.gn * RAY_EPS, refracted, RAY_EPS, FAR, gl_RayFlagsNoneEXT, MASK_OPAQUE, seed, bed)) {
      sawBed = true;
      bedDepth = max(bed.surface.y - hit.surface.y, 0.0);
      vec3 bedSun = directSun(bed, sunDir, shadows, seed);
      if ((u.misc.y & FLAG_CAUSTICS) != 0u) {
        // Light focused by the waves: a web where two drifting noise fields both run high,
        // fading with depth.
        float t = u.weather3.x;
        float n1 = valueNoise2(bed.surface.xz / 56.0 + vec2(t * 0.21, -t * 0.13));
        float n2 = valueNoise2(bed.surface.xz / 44.0 + vec2(-t * 0.17, t * 0.11) + 7.3);
        float web = pow(n1 * n2, 3.0) * 7.0;
        float fade = 1.0 - clamp(bedDepth / 400.0, 0.0, 1.0);
        bedSun *= 1.0 + (web - 0.25) * fade;
      }
      under = bed.albedo * (vec3(u.sky.w) + bedSun + directLocal(bed));
      if (bedDepth < 150.0) {
        under *= mix(vec3(1.0), wt.depth, bedDepth / 150.0);
      } else if (bedDepth < 500.0) {
        under *= mix(wt.depth, vec3(0.0), (bedDepth - 150.0) / 350.0);
      } else {
        under = vec3(0.0);
      }
    }
  }

  // Foam where the bed is shallow, broken up by a slow ripple.
  float foamAmount = 0.0;
  if (wt.foam && sawBed) {
    float t = u.weather3.x * 2.2 / wt.duration;
    float ripple = 0.55 + 0.25 * sin(hit.surface.x * 0.11 + t) + 0.2 * sin(hit.surface.z * 0.13 - t * 0.7);
    float shore = min(1.0 - clamp(bedDepth / 70.0, 0.0, 1.0), 0.8);
    foamAmount = clamp(pow(1.0 - (1.0 - shore) / 0.7, 3.0), 0.0, 1.0) * ripple;
  }
  base = mix(base, wt.foamColor * composite, foamAmount) + specular / 3.0;

  float alpha = max(wt.opacity, max(foamAmount, max(finalFresnel, length(specular) / 3.0)));
  if (wt.isFlat || !sawBed) {
    return mix(wt.depth * composite, base, alpha);
  }
  return mix(under, base, alpha);
}

// Irradiance from the sun at a hit, before the albedo.
vec3 directSun(Hit hit, vec3 sunDir, bool shadows, inout uint seed) {
  float ndl = max(dot(hit.n, sunDir), 0.0);
  if (ndl <= 0.0 || u.sun.w <= 0.0) {
    return vec3(0.0);
  }
  if (shadows && occluded(hit.p, sunDir, seed)) {
    return vec3(0.0);
  }
  return u.sunColor.rgb * (u.sun.w * ndl * cloudShadow(hit.p));
}

void main() {
  uvec2 px = gl_GlobalInvocationID.xy;
  uint w = u.misc.z;
  uint h = u.misc.w;
  if (px.x >= w || px.y >= h) {
    return;
  }

  uint flags = u.misc.y;
  if ((flags & FLAG_PATTERN) != 0u) {
    float phase = 0.5 + 0.5 * sin(float(u.misc.x) * 0.05);
    float checker = (((px.x >> 5) + (px.y >> 5)) & 1u) == 0u ? 1.0 : 0.6;
    imageStore(outImage, ivec2(px), vec4(vec3(float(px.x) / float(w), float(px.y) / float(h), phase) * checker, 1.0));
    return;
  }

  uint seed = pcgHash(px.x * 1973u + px.y * 9277u + u.misc.x * 26699u);

  // Motion blur: each ray uses the camera at a random moment inside the shutter interval,
  // interpolated between the previous and current frame.
  vec3 camPos = u.cam.xyz;
  float zoom = u.cam.w;
  vec3 row0 = u.r0.xyz;
  vec3 row1 = u.r1.xyz;
  vec3 row2 = u.r2.xyz;
  if (u.motion.x > 0.0 && (flags & FLAG_RESET_HISTORY) == 0u) {
    float tau = 1.0 - rand(seed) * u.motion.x;
    camPos = mix(u.prevCam.xyz, camPos, tau);
    zoom = mix(u.prevCam.w, zoom, tau);
    // The previous inverse rotation is the transpose of the stored forward rotation.
    row0 = normalize(mix(vec3(u.p0.x, u.p1.x, u.p2.x), row0, tau));
    row1 = normalize(mix(vec3(u.p0.y, u.p1.y, u.p2.y), row1, tau));
    row2 = normalize(mix(vec3(u.p0.z, u.p1.z, u.p2.z), row2, tau));
  }
  // Antialiasing: a random point in the pixel each frame, averaged by the accumulation.
  vec2 jitter = (flags & FLAG_ANTIALIAS) != 0u ? vec2(rand(seed), rand(seed)) : vec2(0.5);
  vec3 viewDir = vec3((float(px.x) + jitter.x - float(w) * 0.5) / zoom, (float(px.y) + jitter.y - float(h) * 0.5) / zoom, 1.0);
  vec3 dir = normalize(vec3(dot(row0, viewDir), dot(row1, viewDir), dot(row2, viewDir)));
  vec3 origin = camPos;
  if ((flags & FLAG_UNDERWATER) != 0u) {
    // Under water the view sways a little with the waves overhead.
    float t = u.weather3.x;
    dir = normalize(dir + 0.012 * vec3(sin(t * 1.7 + viewDir.y * 6.0), sin(t * 1.3 + viewDir.x * 5.0), cos(t * 1.1 + viewDir.x * 4.0 + viewDir.y * 3.0)));
  }
  if ((flags & FLAG_THIN_LENS) != 0u && u.path.y > 0.0) {
    // Thin lens: the ray leaves a random point on the aperture and passes through the point
    // where the pinhole ray meets the plane of focus, so depths out of focus blur for real.
    vec3 focal = camPos + vec3(dot(row0, viewDir), dot(row1, viewDir), dot(row2, viewDir)) * max(u.path.z, 1.0);
    float radius = sqrt(rand(seed)) * u.path.y;
    float angle = 6.2831853 * rand(seed);
    vec3 lens = vec3(cos(angle), sin(angle), 0.0) * radius;
    origin = camPos + vec3(dot(row0, lens), dot(row1, lens), dot(row2, lens));
    dir = normalize(focal - origin);
  }

  uint primaryFlags = (flags & FLAG_CULL) != 0u ? gl_RayFlagsCullBackFacingTrianglesEXT : gl_RayFlagsNoneEXT;

  Hit hit;
  if (!trace(origin, dir, 1.0, u.post.z, primaryFlags, MASK_ALL, seed, hit)) {
    // A ray heading downward ran out of loaded scene. The sky carries on below the horizon for
    // a while, then gives way to the fog colour of that direction, as the distance fade does.
    vec3 background = dir.y > 0.02 ? mix(skyBackground(dir), horizonAt(dir), smoothstep(0.15, 0.6, dir.y)) : skyBackground(dir);
    if ((flags & FLAG_STILL) != 0u) {
      // Held frames accumulate the sky like everything else, so it is stored as the radiance
      // the final tone curve maps back to its painted colour.
      background = inverseTonemap(background);
    }
    imageStore(sampleImage, ivec2(px), vec4(background, 0.0));
    imageStore(albedoImage, ivec2(px), vec4(1.0));
    imageStore(normalImage, ivec2(px), vec4(0.0));
    imageStore(currPos, ivec2(px), vec4(0.0, 0.0, 0.0, -1.0));
    return;
  }

  bool shadows = (flags & FLAG_SHADOWS) != 0u;
  vec3 sunDir = u.params.x > 0.0 ? coneDirection(u.sun.xyz, u.params.x, seed) : u.sun.xyz;

  // Weather settles on static, up-facing surfaces: snow whitens them, rain darkens them and
  // adds a sheen once it has soaked in.
  float upFacing = smoothstep(0.3, 0.8, -hit.gn.y);
  bool wetPixel = false;
  bool wetRippling = false;
  float puddle = 0.0;
  vec3 puddleNormal = hit.gn;
  if (!hit.dyn && !hit.water && !hit.translucent && upFacing > 0.0) {
    if (u.weather2.y > 0.0) {
      hit.albedo = mix(hit.albedo, vec3(0.85), u.weather2.y * upFacing);
    }
    vec4 water = (flags & FLAG_RUNOFF) != 0u ? runoffAt(hit.surface.xz) : vec4(0.0);
    float standing = smoothstep(0.4, 4.0, water.x);
    float wetness = max(u.weather2.x, smoothstep(0.0, 1.0, water.x));
    if (wetness > 0.0 && u.weather2.y < 0.5) {
      wetPixel = true;
      // Simulated water where it has gathered, or the fixed dips when the simulation is off.
      puddle = (flags & FLAG_RUNOFF) != 0u ? standing : (flags & FLAG_PUDDLES) != 0u ? puddleAt(hit.surface.xz) * u.weather2.x : 0.0;
      float wet = wetness * upFacing;
      hit.albedo *= 1.0 - mix(0.45, 0.75, puddle) * wet;
      // The film of water turns the surface glossy: the sun, local lights and the reflection ray
      // all see a strong, fairly sharp specular against the darkened ground.
      // Sharp enough that the ripples, not the roughness, shape what the film reflects.
      hit.material.x = max(hit.material.x, 0.45 * wet);
      hit.material.y = mix(hit.material.y, 180.0, wet);
      vec2 ripple = vec2(0.0);
      if ((flags & FLAG_RAIN_RIPPLES) != 0u && u.weather.z > 0.0) {
        // Landing drops ring the film and countless smaller ones shiver it, so highlights and
        // reflections break up and dance with the rain.
        ripple += rainRippleGradient(hit.surface.xz) * wet;
        float t = u.weather3.x;
        vec2 shiver = vec2(valueNoise2(hit.surface.xz / 18.0 + vec2(t * 3.1, -t * 2.3)), valueNoise2(hit.surface.xz / 18.0 + vec2(7.7 - t * 2.6, t * 3.7))) - 0.5;
        ripple += shiver * (0.5 * u.weather.z * wet);
        wetRippling = true;
      }
      float speed = length(water.yz);
      if (speed > 0.05) {
        // Running water carries waves along its flow, steeper the faster it runs.
        vec2 flowDir = water.yz / speed;
        float phase = dot(hit.surface.xz, flowDir) * 0.25 - u.weather3.x * speed * 0.5;
        ripple += flowDir * (cos(phase) * min(speed * 0.02, 0.35)) * standing;
      }
      hit.n = normalize(hit.n + vec3(-ripple.x, 0.0, -ripple.y) * 0.75);
      puddleNormal = normalize(hit.gn + vec3(-ripple.x, 0.0, -ripple.y));
    }
    if (u.ground.x > 0.0 && (u.weather2.y > 0.05 || wetness > 0.2)) {
      footprint(hit, u.weather2.y);
    }
  }
  // Radiance that does not scale with the albedo: highlights, reflections and glow.
  vec3 specular = vec3(0.0);
  vec3 toEye = -dir;
  float sunNdl = max(dot(hit.n, sunDir), 0.0);
  float sunVisible = sunNdl > 0.0 && u.sun.w > 0.0 && !(shadows && occluded(hit.p, sunDir, seed)) ? cloudShadow(hit.p) : 0.0;
  vec3 sunLight = u.sunColor.rgb * (u.sun.w * sunVisible);
  if ((flags & FLAG_UNDERWATER) != 0u && !hit.water) {
    // Sunlight under water: dimmed by its passage and focused by the waves into a dancing web.
    float t = u.weather3.x;
    float n1 = valueNoise2(hit.surface.xz / 56.0 + vec2(t * 0.21, -t * 0.13));
    float n2 = valueNoise2(hit.surface.xz / 44.0 + vec2(-t * 0.17, t * 0.11) + 7.3);
    sunLight *= 0.45 + pow(n1 * n2, 3.0) * 6.0;
  }
  specular += specularOf(hit.material, hit.n, toEye, sunDir, sunLight);
  vec3 light = vec3(u.sky.w) + sunLight * sunNdl + directLocalSpecular(hit, toEye, specular);
  if (hit.flame && u.material.x > 0.0) {
    // Flames glow with their own colour and flicker, brightest at the top of the fire.
    float t = u.weather3.x;
    float flicker = 0.7 + 0.6 * valueNoise2(vec2(t * 9.0 + hit.surface.x * 0.02, t * 7.0 + hit.surface.z * 0.02));
    light += vec3(6.0 * u.material.x * flicker);
  } else if (hit.material.z > 0.0 && u.material.x > 0.0) {
    // Unlit textures glow with their own colour, four times white at full strength.
    light += vec3(4.0 * u.material.x * hit.material.z);
  }
  if (u.material.y > 0.0 && hit.material.x > 0.0 && !hit.water && !hit.translucent) {
    // Glossy reflection: one ray around the mirror direction, spread by the roughness the gloss
    // exponent implies, weighted by Schlick's Fresnel with the specular strength as F0.
    float rough = 1.0 / sqrt(max(hit.material.y, 1.0));
    vec3 reflected = reflect(dir, hit.n);
    vec3 jittered = normalize(reflected + rough * 1.5 * (2.0 * vec3(rand(seed), rand(seed), rand(seed)) - 1.0));
    if (dot(jittered, hit.gn) < 0.0) {
      jittered = reflect(jittered, hit.gn);
    }
    float cosI = clamp(dot(toEye, hit.n), 0.0, 1.0);
    float fresnel = hit.material.x + (1.0 - hit.material.x) * pow(1.0 - cosI, 5.0);
    Hit mirror;
    vec3 seen;
    if (trace(hit.p, jittered, RAY_EPS, FAR, gl_RayFlagsNoneEXT, MASK_ALL, seed, mirror)) {
      seen = mirror.albedo * (vec3(u.sky.w) + directSun(mirror, sunDir, shadows, seed) + directLocal(mirror));
    } else {
      seen = skyBackground(jittered);
    }
    specular += seen * (fresnel * 0.5);
  }

  // Diffuse path: cosine-weighted bounces, each attenuated by the albedo it passed through,
  // gathering direct light at every vertex and sky light where the path escapes.
  int bounces = int(u.path.x);
  vec3 throughput = vec3(1.0);
  Hit current = hit;
  for (int b = 0; b < bounces; ++b) {
    vec3 bounceDir = cosineDirection(current.n, seed);
    // A relief-tilted normal can send the bounce under the real surface.
    if (dot(bounceDir, current.gn) < 0.0) {
      bounceDir = reflect(bounceDir, current.gn);
    }
    Hit next;
    if (!trace(current.p, bounceDir, RAY_EPS, FAR, gl_RayFlagsNoneEXT, MASK_ALL, seed, next)) {
      light += throughput * skyRadiance(bounceDir);
      break;
    }
    throughput *= next.albedo;
    light += throughput * (vec3(u.sky.w) + directSun(next, sunDir, shadows, seed) + directLocal(next));
    current = next;
  }
  // Water: a Fresnel blend of the lit body colour and a mirror reflection off animated waves,
  // plus the sun's glint. Stored like a translucent pixel and with a short history.
  bool waterPixel = false;
  if (hit.water) {
    light = (flags & FLAG_UNDERWATER) != 0u && dir.y < 0.0 ? shadeWaterFromBelow(hit, dir, sunDir, shadows, seed) : shadeWater(hit, dir, sunDir, shadows, seed);
    hit.albedo = vec3(1.0);
    waterPixel = true;
  } else if (wetPixel && puddle > 0.3) {
    // Standing water is a flat mirror rippled by the rain; plain wet ground is handled by its glossy material.
    vec3 wn = puddleNormal;
    float cosI = clamp(dot(-dir, wn), 0.0, 1.0);
    float fresnel = (0.02 + 0.98 * pow(1.0 - cosI, 5.0)) * mix(0.5, 1.0, puddle) * u.weather2.x * upFacing;
    vec3 reflectDir = reflect(dir, wn);
    if (dot(reflectDir, hit.gn) < 0.0) {
      reflectDir = reflect(reflectDir, hit.gn);
    }
    vec3 reflection;
    Hit mirror;
    if (trace(hit.p, reflectDir, RAY_EPS, FAR, gl_RayFlagsNoneEXT, MASK_ALL, seed, mirror)) {
      reflection = mirror.albedo * (vec3(u.sky.w) + directSun(mirror, sunDir, shadows, seed) + 0.5 * skyRadiance(mirror.n));
    } else {
      reflection = skyBackground(reflectDir);
    }
    float glint = pow(max(dot(reflectDir, u.sun.xyz), 0.0), 600.0);
    light = mix(hit.albedo * light, reflection, fresnel) + u.sunColor.rgb * (u.sun.w * fresnel * glint * 4.0);
    hit.albedo = vec3(1.0);
  }

  // The G-buffer for reprojection and denoising describes a stable surface. A pixel whose
  // stochastic primary hit landed on translucent geometry uses the opaque surface behind it
  // instead, and stores its full colour with a unit albedo so the blend is filtered as a whole.
  if (u.eye.w > 0.0) {
    // What the character could not see from their own eyes is darkened; the ground around
    // their feet counts as seen so their own body does not shadow it.
    vec3 toPoint = hit.surface - u.eye.xyz;
    float dist = length(toPoint);
    bool seen = dist < 192.0 || !occludedWithin(u.eye.xyz, toPoint / dist, dist - 4.0);
    float keep = seen ? 1.0 : 1.0 - u.eye.w;
    light *= keep;
    specular *= keep;
  }

  // Highlighted NPCs wear a rim of their highlight colour, brightest where the surface turns away.
  if (hit.highlight != 0u && u.marks.z > 0.0) {
    float rim = pow(1.0 - max(dot(hit.n, -dir), 0.0), 2.5);
    hit.albedo = mix(hit.albedo, u.highlight[hit.highlight].rgb, rim);
    light += vec3(rim * 3.0 * u.marks.z / u.params.y);
  }

  Hit stable = hit;
  // Specular radiance is stored divided by the albedo the final pass will multiply back.
  vec3 sample_ = light + specular / max(hit.albedo, vec3(0.05));
  if (hit.covered && !waterPixel) {
    if (hit.translucent) {
      Hit solid;
      if (trace(origin, dir, 1.0, u.post.z, primaryFlags, MASK_OPAQUE, seed, solid)) {
        stable = solid;
      }
    }
    sample_ = hit.albedo * light + specular;
    hit.albedo = vec3(1.0);
  }
  // w of the position is the hit distance; the sign of the sample's alpha marks dynamic geometry
  // and its magnitude is the view angle cosine, both used by the later passes.
  float cosine = max(abs(dot(stable.n, dir)), 0.01);
  if ((flags & FLAG_STILL) != 0u) {
    // Held frames accumulate the lit colour itself: the lens jitter changes what a pixel sees
    // from sample to sample, so no single albedo could be divided back out afterwards.
    sample_ *= hit.albedo;
    hit.albedo = vec3(1.0);
  }
  // Rippling wet ground keeps the short history too, so its reflections move with the rain
  // instead of averaging into a blur.
  imageStore(sampleImage, ivec2(px), vec4(sample_, (stable.dyn || waterPixel || wetRippling) ? -cosine : cosine));
  imageStore(albedoImage, ivec2(px), vec4(hit.albedo, 1.0));
  imageStore(normalImage, ivec2(px), vec4(stable.gn, 0.0));
  imageStore(currPos, ivec2(px), vec4(stable.surface, stable.t));
}
