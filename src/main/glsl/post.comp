#version 460

// Final post-processing over the finished image: depth of field as a gather where each pixel
// collects neighbours whose circle of confusion, from a thin lens focused at the focus
// distance, reaches it; bloom added from the blurred bright pass; and the vignette. Running
// after the denoiser keeps the blur free of the sampling noise a jittered lens would add.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;
layout(std140, set = 0, binding = 6) uniform Frame {
  vec4 cam;     // camera position, zoom
  vec4 r0;
  vec4 r1;
  vec4 r2;
  vec4 prevCam;
  vec4 p0;
  vec4 p1;
  vec4 p2;
  vec4 sun;
  vec4 sky;
  vec4 params;
  uvec4 misc;   // frame, flags, width, height
  vec4 extra;
  vec4 denoise;
  vec4 sunColor;
  vec4 path;    // diffuse bounce count, lens aperture radius, focus distance, wave strength
  vec4 motion;
  vec4 weather;
  vec4 weather2;
  vec4 fog;
  vec4 weather3;
  vec4 mistColor; // display-space colour of lit mist, light shaft strength
  vec4 post;      // vignette strength, bloom strength, render distance, fade share
  vec4 post2;     // film grain, chromatic aberration, aerial perspective, sine of the real sun's elevation
  vec4 lights;
  vec4 material;
  vec4 post3;     // contrast, saturation, colour temperature, soft glow opacity
  vec4 wind;
  vec4 skyAmbient;
  vec4 eye;
  vec4 guide;
  vec4 marks;     // ground marker count, marker glow scale, NPC rim glow scale, lens flare strength
} u;
layout(push_constant) uniform Push {
  int pass;
  int step;
  int last;
  int passes;
} pc;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D currPos;
layout(set = 0, binding = 17, rgba16f) uniform readonly image2D filterA;
layout(set = 0, binding = 18, rgba16f) uniform readonly image2D filterB;
layout(set = 0, binding = 30, rgba16f) uniform readonly image2D bloomBlur;
layout(set = 0, binding = 35, rgba16f) uniform readonly image2D diffuseBlur;

const float MAX_COC = 20.0;
const uint FLAG_THIN_LENS = 2097152u;
const int TAPS = 48;
const float GOLDEN_ANGLE = 2.39996323;

// The last denoiser pass wrote the display colour to the filter image it would have read next.
vec3 readColor(ivec2 q) {
  return ((pc.pass & 1) == 0 ? imageLoad(filterA, q) : imageLoad(filterB, q)).rgb;
}

// Blur radius in pixels of a point at this distance; sky pixels count as infinitely far.
float coc(float depth) {
  float focus = max(u.path.z, 1.0);
  float d = depth > 0.0 ? depth : 1e9;
  return min(u.cam.w * u.path.y * abs(d - focus) / (focus * d), MAX_COC);
}

// A quarter-resolution image sampled bilinearly at a full-resolution pixel.
vec3 upsample(ivec2 p, bool bright) {
  ivec2 quarter = (ivec2(u.misc.zw) + 3) / 4;
  vec2 q = (vec2(p) + 0.5) / 4.0 - 0.5;
  ivec2 i = ivec2(floor(q));
  vec2 f = q - vec2(i);
  ivec2 i0 = clamp(i, ivec2(0), quarter - 1);
  ivec2 i1 = clamp(i + 1, ivec2(0), quarter - 1);
  vec3 a = bright ? imageLoad(bloomBlur, ivec2(i0.x, i0.y)).rgb : imageLoad(diffuseBlur, ivec2(i0.x, i0.y)).rgb;
  vec3 b = bright ? imageLoad(bloomBlur, ivec2(i1.x, i0.y)).rgb : imageLoad(diffuseBlur, ivec2(i1.x, i0.y)).rgb;
  vec3 c = bright ? imageLoad(bloomBlur, ivec2(i0.x, i1.y)).rgb : imageLoad(diffuseBlur, ivec2(i0.x, i1.y)).rgb;
  vec3 d = bright ? imageLoad(bloomBlur, ivec2(i1.x, i1.y)).rgb : imageLoad(diffuseBlur, ivec2(i1.x, i1.y)).rgb;
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// The blurred bright pass, softened so a very bright source glows without whiting out.
vec3 bloom(ivec2 p) {
  vec3 v = upsample(p, true);
  return v / (1.0 + v);
}

// Bilinear read of the finished image at a fractional position.
vec3 readColorAt(vec2 pos, ivec2 size) {
  vec2 q = pos - 0.5;
  ivec2 i = ivec2(floor(q));
  vec2 f = q - vec2(i);
  ivec2 i0 = clamp(i, ivec2(0), size - 1);
  ivec2 i1 = clamp(i + 1, ivec2(0), size - 1);
  vec3 a = readColor(ivec2(i0.x, i0.y));
  vec3 b = readColor(ivec2(i1.x, i0.y));
  vec3 c = readColor(ivec2(i0.x, i1.y));
  vec3 d = readColor(ivec2(i1.x, i1.y));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Radial colour fringing: red is read a little outward and blue a little inward, by an
// amount that grows with the square of the distance from the centre and reaches about
// twenty pixels in the corners at full strength.
vec3 aberrated(ivec2 p, ivec2 size) {
  vec2 centre = vec2(size) * 0.5;
  vec2 pos = vec2(p) + 0.5;
  vec2 d = (pos - centre) / centre;
  vec2 offset = d * dot(d, d) * 0.5 * 20.0 * u.post2.y;
  return vec3(readColorAt(pos + offset, size).r, readColor(p).g, readColorAt(pos - offset, size).b);
}

// Grain that changes every frame, heaviest in the shadows and fading out in the highlights.
vec3 grain(ivec2 p, vec3 c) {
  vec3 seed = vec3(vec2(p), float(u.misc.x & 1023u));
  seed = fract(seed * 0.1031);
  seed += dot(seed, seed.zyx + 31.32);
  float n = fract((seed.x + seed.y) * seed.z) - 0.5;
  float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
  return c + n * u.post2.x * 0.18 * (1.0 - 0.6 * lum);
}

// Colour grading after tone mapping: saturation about the luminance, contrast about mid grey,
// and a warm or cool tilt of the channels.
vec3 graded(vec3 c) {
  float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
  c = mix(vec3(lum), c, u.post3.y);
  c = (c - 0.5) * u.post3.x + 0.5;
  c *= vec3(1.0 + 0.12 * u.post3.z, 1.0 + 0.02 * u.post3.z, 1.0 - 0.12 * u.post3.z);
  return clamp(c, 0.0, 1.0);
}

// Corner darkening, measured so the very corners reach the full strength at any aspect ratio.
vec3 vignette(ivec2 p, vec3 c) {
  vec2 size = vec2(u.misc.zw);
  vec2 uv = ((vec2(p) + 0.5) / size - 0.5) * vec2(size.x / size.y, 1.0);
  float r = length(uv) / length(vec2(size.x / size.y, 1.0) * 0.5);
  return c * (1.0 - u.post.x * pow(smoothstep(0.3, 1.0, r), 1.5));
}

// Lens flare from the sun or moon when it is in frame and unhidden: a glow about it, a
// six-pointed starburst, a horizontal streak, and a string of ghost discs mirrored through
// the frame centre as a lens's internal reflections make them.
vec3 lensFlare(ivec2 p, ivec2 size) {
  float strength = u.marks.w;
  if (strength <= 0.0 || u.sun.w <= 0.0) {
    return vec3(0.0);
  }
  // The camera rows map view space to the world, so their columns map it back.
  vec3 s = u.sun.xyz;
  vec3 v = vec3(dot(vec3(u.r0.x, u.r1.x, u.r2.x), s), dot(vec3(u.r0.y, u.r1.y, u.r2.y), s), dot(vec3(u.r0.z, u.r1.z, u.r2.z), s));
  if (v.z <= 0.05) {
    return vec3(0.0);
  }
  vec2 centre = vec2(size) * 0.5;
  vec2 sunPx = centre + v.xy / v.z * u.cam.w;
  float diagonal = length(vec2(size));
  // Fades as the source leaves the frame, and with how much of the sky around it is hidden.
  vec2 outside = max(abs(sunPx - centre) - centre, 0.0);
  float inFrame = 1.0 - smoothstep(0.0, 0.15 * diagonal, length(outside));
  if (inFrame <= 0.0) {
    return vec3(0.0);
  }
  float open = 0.0;
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      ivec2 q = clamp(ivec2(sunPx) + ivec2(dx, dy) * 6, ivec2(0), size - 1);
      open += imageLoad(currPos, q).w < 0.0 ? 1.0 / 9.0 : 0.0;
    }
  }
  if (open <= 0.0) {
    return vec3(0.0);
  }
  vec2 pos = vec2(p) + 0.5;
  vec2 d = (pos - sunPx) / diagonal;
  float r = length(d);
  vec3 tint = normalize(u.sunColor.rgb + vec3(0.2)) * 1.2;
  // Glow and a soft six-pointed star, both about the source itself.
  float glow = exp(-r * 18.0) * 0.5;
  float angle = atan(d.y, d.x);
  float star = pow(abs(cos(angle * 3.0 + 0.35)), 30.0) * exp(-r * 4.0) * 0.35;
  // A horizontal streak, a few pixels tall, in the cool cast of an anamorphic lens.
  float streak = exp(-abs(d.y) * diagonal / 3.0) * exp(-abs(d.x) * 5.0) * 0.5;
  vec3 flare = tint * (glow + star) + vec3(0.55, 0.7, 1.0) * streak;
  // Ghosts along the line through the frame centre, opposite the source and beyond it.
  vec2 axis = (centre - sunPx) / diagonal;
  const float places[6] = float[](-0.55, -0.25, 0.35, 0.7, 1.1, 1.6);
  const float radii[6] = float[](0.05, 0.03, 0.045, 0.08, 0.035, 0.11);
  for (int i = 0; i < 6; ++i) {
    vec2 ghost = axis * (1.0 + places[i]);
    float g = length(d - ghost) / radii[i];
    float disc = (1.0 - smoothstep(0.6, 1.0, g)) * (0.4 + 0.6 * g);
    // A hue per ghost, as the coatings colour each reflection differently.
    vec3 hue = 0.6 + 0.4 * cos(6.2832 * (float(i) * 0.17 + vec3(0.0, 0.33, 0.67)));
    flare += hue * tint * (disc * 0.05);
  }
  float bright = clamp(dot(u.sunColor.rgb, vec3(0.33)) * u.sun.w * u.params.y * 0.5, 0.0, 1.0);
  return flare * (strength * inFrame * open * bright);
}

vec3 depthOfField(ivec2 p, ivec2 size, vec3 centre) {
  float depth = imageLoad(currPos, p).w;
  float own = coc(depth);
  if (own < 0.5) {
    return centre;
  }
  // Taps fill this pixel's own blur disc, turned per pixel so the sparse spiral reads as
  // fine grain rather than as repeated copies.
  float rotation = 6.2831853 * fract(52.9829189 * fract(0.06711056 * float(p.x) + 0.00583715 * float(p.y)));
  vec3 sum = centre;
  float weight = 1.0;
  for (int i = 0; i < TAPS; ++i) {
    float radius = sqrt((float(i) + 0.5) / float(TAPS)) * own;
    float angle = float(i) * GOLDEN_ANGLE + rotation;
    vec2 offset = vec2(cos(angle), sin(angle)) * radius;
    ivec2 q = clamp(p + ivec2(round(offset)), ivec2(0), size - 1);
    // A neighbour contributes where its own blur disc reaches this pixel, so a sharp object
    // inside the disc stays crisp against the blurred surroundings.
    float w = clamp(coc(imageLoad(currPos, q).w) + 0.5 - radius, 0.0, 1.0);
    sum += readColor(q) * w;
    weight += w;
  }
  return sum / weight;
}

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = ivec2(u.misc.zw);
  if (p.x >= size.x || p.y >= size.y) {
    return;
  }
  vec3 c = u.post2.y > 0.0 ? aberrated(p, size) : readColor(p);
  // A held frame traced through a real lens has its blur already.
  if (u.path.y > 0.0 && (u.misc.y & FLAG_THIN_LENS) == 0u) {
    c = depthOfField(p, size, c);
  }
  if (u.post3.w > 0.0) {
    // Soft glow: the blurred whole frame laid back over itself.
    c = mix(c, upsample(p, false), u.post3.w);
  }
  if (u.post.y > 0.0) {
    c += u.post.y * bloom(p);
  }
  c += lensFlare(p, size);
  c = graded(c);
  if (u.post2.x > 0.0) {
    c = grain(p, c);
  }
  if (u.post.x > 0.0) {
    c = vignette(p, c);
  }
  imageStore(outImage, p, vec4(c, 1.0));
}
