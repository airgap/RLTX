#version 460
#extension GL_EXT_ray_query : require

// One à-trous wavelet iteration of the SVGF filter over accumulated irradiance. Weights stop
// at normal and position discontinuities and scale with the estimated variance, so noisy
// regions are smoothed widely while converged regions are left alone. The last pass applies
// the albedo, exposure and tone mapping.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;
layout(std140, set = 0, binding = 6) uniform Frame {
  vec4 cam;
  vec4 r0;
  vec4 r1;
  vec4 r2;
  vec4 prevCam;
  vec4 p0;
  vec4 p1;
  vec4 p2;
  vec4 sun;
  vec4 sky;
  vec4 params;  // sun angular radius (radians), exposure, history frames, dynamic history frames
  uvec4 misc;   // frame, flags, width, height
  vec4 extra;
  vec4 denoise; // luminance, normal and position sigmas, unused
  vec4 sunColor;
  vec4 path;
  vec4 motion;
  vec4 weather;  // cloud cover, fog amount, rain, snow
  vec4 weather2; // ground wetness, snow cover, accumulated wind displacement x and z in world units
  vec4 fog;      // fog colour in display space, lightning flash
  vec4 weather3; // seconds, swamp mist density, mist grid side length, mist grid tile offset
  vec4 mistColor; // display-space colour of lit mist, light shaft strength
  vec4 post;      // vignette strength, bloom strength, render distance in world units, fade share
  vec4 post2;     // film grain, chromatic aberration, aerial perspective, sine of the real sun's elevation
  vec4 lights;    // local light count, local light strength scale
  vec4 material;
  vec4 post3;
  vec4 wind;      // wind velocity x and z in world units per second, light disc radius, rain streak length scale
  vec4 skyAmbient; // linear sky light on things in the open, rain speed scale
  vec4 eye;
  vec4 guide;      // display-space colour of the route glow, and the number of guide entries
} u;
layout(push_constant) uniform Push {
  int pass;
  int step;
  int last;
  int passes;
} pc;
layout(set = 0, binding = 8, rgba16f) uniform image2D currColor;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D currPos;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D sampleImage;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D albedoImage;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D normalImage;
// Ping-pong buffers: even passes read A and write B, odd passes the reverse.
layout(set = 0, binding = 17, rgba16f) uniform image2D filterA;
layout(set = 0, binding = 18, rgba16f) uniform image2D filterB;
layout(std430, set = 0, binding = 26) readonly buffer MistGrid { vec4 v[]; } mistGrid;
layout(set = 0, binding = 27, rgba16f) uniform readonly image2D shaftImage;
layout(std430, set = 0, binding = 32) readonly buffer Lights { vec4 v[]; } localLights;
layout(std430, set = 0, binding = 38) readonly buffer Guide { vec4 v[]; } guidePath;
layout(set = 0, binding = 28, rgba16f) uniform writeonly image2D bloomSource;

const float KERNEL[5] = float[5](1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

float luminance(vec3 c) {
  return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Filmic curve (Narkowicz's ACES fit): near-linear midtones with a soft shoulder.
vec3 tonemap(vec3 c) {
  c *= u.params.y;
  return clamp((c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14), 0.0, 1.0);
}

float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return fract((p.x + p.y) * p.z);
}

// Fog per world unit of depth: at full amount, scenery four tiles away is two thirds hidden.
const float FOG_EXTINCTION = 2.5 / 1280.0;

// Sunlight scattered by the air along the view ray, from the shafts pass; a 3x3 average hides
// its per-pixel sample jitter.
vec3 lightShafts(ivec2 p) {
  if (u.mistColor.w <= 0.0) {
    return vec3(0.0);
  }
  ivec2 size = ivec2(u.misc.zw);
  vec3 sum = vec3(0.0);
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      sum += imageLoad(shaftImage, clamp(p + ivec2(dx, dy), ivec2(0), size - 1)).rgb;
    }
  }
  return sum / 9.0;
}

// The camera ray through a pixel, as the trace pass builds it.
vec3 cameraRay(ivec2 px) {
  float zoom = u.cam.w;
  vec3 v = vec3((float(px.x) + 0.5 - float(u.misc.z) * 0.5) / zoom, (float(px.y) + 0.5 - float(u.misc.w) * 0.5) / zoom, 1.0);
  return normalize(vec3(dot(u.r0.xyz, v), dot(u.r1.xyz, v), dot(u.r2.xyz, v)));
}

float valueNoise(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float n000 = hash13(i);
  float n100 = hash13(i + vec3(1.0, 0.0, 0.0));
  float n010 = hash13(i + vec3(0.0, 1.0, 0.0));
  float n110 = hash13(i + vec3(1.0, 1.0, 0.0));
  float n001 = hash13(i + vec3(0.0, 0.0, 1.0));
  float n101 = hash13(i + vec3(1.0, 0.0, 1.0));
  float n011 = hash13(i + vec3(0.0, 1.0, 1.0));
  float n111 = hash13(i + vec3(1.0, 1.0, 1.0));
  return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y), mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}

// Ground height and mist coverage under a world position, from the per-scene grid.
vec2 mistAt(vec2 xz) {
  int side = int(u.weather3.z);
  vec2 g = xz / 128.0 + u.weather3.w;
  if (g.x < 0.0 || g.y < 0.0 || g.x >= float(side - 1) || g.y >= float(side - 1)) {
    return vec2(0.0, 0.0);
  }
  ivec2 i = ivec2(g);
  vec2 f = g - vec2(i);
  vec2 a = mistGrid.v[i.x * side + i.y].xy;
  vec2 b = mistGrid.v[(i.x + 1) * side + i.y].xy;
  vec2 c = mistGrid.v[i.x * side + i.y + 1].xy;
  vec2 d = mistGrid.v[(i.x + 1) * side + i.y + 1].xy;
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

const float MIST_HEIGHT = 110.0;
const int MIST_STEPS = 40;
const float MIST_RANGE = 3600.0;
// Extinction per world unit at full density: a look straight down through the layer loses
// about half the scene behind it.
const float MIST_EXTINCTION = 1.0 / 48.0;

// Low mist over the swamps: a layer hugging the ground wherever the grid allows it, its
// density a drifting noise field carried by the wind, integrated along the camera ray up to
// the scene surface. Its colour is the sun and sky light it scatters, tone mapped on the CPU.
vec3 swampMist(vec3 c, ivec2 px, vec3 dir, float depth) {
  float amount = u.weather3.y;
  if (amount <= 0.0 || u.weather3.z < 2.0) {
    return c;
  }
  float tMax = min(depth > 0.0 ? depth : MIST_RANGE, MIST_RANGE);
  float dt = tMax / float(MIST_STEPS);
  // Interleaved gradient noise staggers the sample positions so the layer shows no bands.
  float jitter = fract(52.9829189 * fract(0.06711056 * float(px.x) + 0.00583715 * float(px.y)));
  float t = u.weather3.x;
  vec3 drift = vec3(u.weather2.z * 0.4 + 12.0 * t, 0.0, u.weather2.w * 0.4 + 5.0 * t);
  float transmittance = 1.0;
  for (int i = 0; i < MIST_STEPS && transmittance > 0.01; ++i) {
    vec3 p = u.cam.xyz + dir * (dt * (float(i) + jitter));
    vec2 ground = mistAt(p.xz);
    // The whole scene may be misted; otherwise only where the grid's coverage allows.
    float cover = (u.misc.y & 131072u) != 0u ? 1.0 : ground.y;
    if (cover <= 0.0) {
      continue;
    }
    // Up is -y: the layer spans from the ground to MIST_HEIGHT above it.
    float height = (ground.x - p.y) / MIST_HEIGHT;
    if (height < -0.1 || height > 1.0) {
      continue;
    }
    float vertical = 1.0 - clamp(height, 0.0, 1.0);
    vec3 q = p + drift;
    float n = 0.65 * valueNoise(q / 360.0) + 0.35 * valueNoise(q / 130.0 + vec3(0.0, t * 0.05, 0.0));
    float density = cover * vertical * vertical * smoothstep(0.3, 0.75, n) * amount;
    transmittance *= exp(-density * dt * MIST_EXTINCTION);
  }
  return mix(u.mistColor.rgb, c, transmittance);
}

// Splash rings where raindrops land: each patch of upward-facing ground takes a drop every so
// often, and for a quarter second afterwards a small faint ring spreads from it and fades. They
// fade out with distance, where they would only read as noise.
vec3 splashes(vec3 c, vec3 p, vec3 n, float depth) {
  float rain = u.weather.z;
  float near = 1.0 - clamp(depth / 1200.0, 0.0, 1.0);
  if (rain <= 0.0 || -n.y < 0.6 || near <= 0.0) {
    return c;
  }
  float t = u.weather3.x;
  vec2 cell = floor(p.xz / 20.0);
  float h = hash12(cell);
  float period = 1.5 / max(rain, 0.05);
  float since = fract(t / period + h) * period;
  if (since > 0.25) {
    return c;
  }
  vec2 centre = (cell + 0.5 + 0.4 * (vec2(hash12(cell + 3.1), hash12(cell + 7.7)) - 0.5)) * 20.0;
  float d = length(p.xz - centre);
  float radius = since * 24.0;
  float ring = 1.0 - smoothstep(0.0, 1.2, abs(d - radius));
  float fade = 1.0 - since / 0.25;
  return c + vec3(0.12) * ring * fade * fade * near;
}

// Falling rain and snow traced through world-anchored three-dimensional grids. Each view ray
// walks a grid cell by cell up to the surface it hits; every cell holds at most one drop, a
// streak along the fall direction, or one flake, and the ray's closest approach to it gives its
// coverage. Drops therefore fall through the scene at their own depth, hidden by whatever stands
// in front, and never alias into points. Rain uses three interleaved grids falling at different
// speeds, as drops of different sizes do, so the field never moves as one sheet. A drop is a
// transparent sphere: the background shows through and what you see is the light it redirects,
// sky and lights reflected and refracted with a strong lobe when the source is behind it.
const float RAIN_CELL = 48.0;
const float RAIN_BASE_LENGTH = 110.0;
const float RAIN_RANGE = 3000.0;
const float SNOW_CELL = 44.0;
const float SNOW_SPEED = 90.0;
const int PRECIPITATION_STEPS = 80;
const uint MASK_SHADOW = 0x3u;

// Integer hash: a fractional hash of whole numbers repeats every few cells and lines drops up.
uint hashCell(ivec3 c) {
  uvec3 v = uvec3(c + 0x40000000) * 1664525u + 1013904223u;
  v.x += v.y * v.z;
  v.y += v.z * v.x;
  v.z += v.x * v.y;
  v ^= v >> 16u;
  v.x += v.y * v.z;
  v.y += v.z * v.x;
  v.z += v.x * v.y;
  return v.x;
}

float unitFrom(uint h) {
  return float(h & 0xFFFFFFu) / 16777216.0;
}

bool sunReaches(vec3 p) {
  if (u.sun.w <= 0.0) {
    return false;
  }
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT, MASK_SHADOW, p, 1.0, u.sun.xyz, 1e6);
  rayQueryProceedEXT(rq);
  return rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

// Light the nearest local lights throw at a point, with a lobe toward the viewer when the
// light is behind the drop; no shadow rays, a drop is too small to shadow accurately.
vec3 localScatter(vec3 p, vec3 dir) {
  int count = min(int(u.lights.x), 64);
  vec3 sum = vec3(0.0);
  for (int i = 0; i < count; ++i) {
    vec4 pr = localLights.v[i * 2];
    vec3 toLight = pr.xyz - p;
    float d2 = dot(toLight, toLight);
    if (d2 >= pr.w * pr.w) {
      continue;
    }
    float d = sqrt(d2);
    float falloff = 1.0 - d / pr.w;
    float forward = pow(max(dot(dir, toLight / d), 0.0), 6.0);
    sum += localLights.v[i * 2 + 1].rgb * (falloff * falloff * (0.15 + 1.2 * forward));
  }
  return sum * u.lights.y;
}

// Light a drop at a world position redirects toward the viewer, in linear radiance.
vec3 dropScatter(vec3 world, vec3 dir) {
  float narrow = pow(max(dot(dir, u.sun.xyz), 0.0), 24.0);
  float broad = pow(max(dot(dir, u.sun.xyz), 0.0), 3.0);
  vec3 scatter = 0.25 * (vec3(u.sky.w) + u.skyAmbient.rgb) + localScatter(world, dir);
  if (sunReaches(world)) {
    scatter += u.sunColor.rgb * (u.sun.w * (0.06 + 0.25 * broad + 1.2 * narrow));
  }
  return scatter;
}

// Walks one grid along the ray and composites the drops or flakes it meets.
vec3 traceParticles(vec3 c, vec3 dir, float tMax, float zoom, bool raining, float speed, float presence, int salt, float t) {
  // Cells are taller than the streak so one always fits with room to sit at a random height.
  float streak = RAIN_BASE_LENGTH * max(u.wind.w, 0.1);
  float cellHeight = streak + 90.0;
  vec3 cellSize = raining ? vec3(RAIN_CELL, cellHeight, RAIN_CELL) : vec3(SNOW_CELL);
  float driftScale = raining ? 0.6 : 0.4;
  // Scrolled space: the grid falls with the drops and drifts with the wind, so a drop is a fixed
  // segment of its cell there. Streaks lie along the velocity so they slant with the wind.
  vec3 scroll = vec3(u.weather2.z * driftScale, speed * t, u.weather2.w * driftScale);
  vec3 o = u.cam.xyz - scroll;
  vec3 fall = normalize(vec3(u.wind.x * driftScale, speed, u.wind.y * driftScale));
  vec3 pos = o / cellSize;
  ivec3 cell = ivec3(floor(pos));
  vec3 stepSign = sign(dir);
  vec3 safeDir = vec3(abs(dir.x) < 1e-5 ? 1e-5 : dir.x, abs(dir.y) < 1e-5 ? 1e-5 : dir.y, abs(dir.z) < 1e-5 ? 1e-5 : dir.z);
  vec3 tDelta = abs(cellSize / safeDir);
  vec3 tNext = ((floor(pos) + max(stepSign, 0.0)) * cellSize - o) / safeDir;
  float tCur = 0.0;
  for (int i = 0; i < PRECIPITATION_STEPS && tCur < tMax; ++i) {
    ivec3 salted = cell + ivec3(salt * 977, salt * 131, salt * 419);
    uint h = hashCell(salted);
    if (unitFrom(h) < presence) {
      vec3 base = vec3(cell) * cellSize;
      float rx = unitFrom(hashCell(salted + ivec3(7, 0, 0)));
      float rz = unitFrom(hashCell(salted + ivec3(0, 0, 11)));
      float ry = unitFrom(hashCell(salted + ivec3(0, 5, 0)));
      vec3 q;
      float along = 1.0;
      if (raining) {
        vec3 head = base + vec3((0.15 + 0.7 * rx) * RAIN_CELL, ry * (cellHeight - streak), (0.15 + 0.7 * rz) * RAIN_CELL);
        // Closest points between the ray and the streak's line, the streak's clamped to its length.
        vec3 w = o - head;
        float b = dot(dir, fall);
        float dd = dot(dir, w);
        float dv = dot(fall, w);
        float denom = 1.0 - b * b;
        float uSeg = denom < 1e-4 ? -dv : (dv - b * dd) / denom;
        uSeg = clamp(uSeg, 0.0, streak);
        q = head + fall * uSeg;
        along = uSeg / streak;
      } else {
        vec2 wobble = 0.3 * vec2(sin(t * 1.7 + rx * 6.2832), cos(t * 1.1 + rz * 6.2832));
        q = base + (vec3(0.5 + wobble.x, 0.5, 0.5 + wobble.y) + 0.3 * (vec3(rx, ry, rz) - 0.5)) * cellSize;
      }
      float tQ = dot(q - o, dir);
      if (tQ > 0.0 && tQ < tMax) {
        float dist = length(cross(q - o, dir));
        float pixel = tQ / zoom;
        // Streaks a pixel wide with a soft edge; flakes a little rounder.
        float width = raining ? max(1.1 * pixel, 1.1) : max(2.6 * pixel, 2.0);
        float cover = 1.0 - smoothstep(0.4 * width, 1.2 * width, dist);
        if (cover > 0.01) {
          vec3 world = q + scroll;
          float fade = exp(-tQ / 2200.0);
          float alpha = cover * fade * (raining ? 0.7 * (0.3 + 0.7 * along) : 0.85);
          if (raining) {
            // The background stays; the drop adds the light it bends toward the eye.
            vec3 light = tonemap(dropScatter(world, dir)) * vec3(0.85, 0.9, 1.0);
            c = c * (1.0 - 0.25 * alpha) + light * alpha;
          } else {
            // Flakes are white bodies lit like the mist.
            c = mix(c, u.mistColor.rgb, alpha);
          }
        }
      }
    }
    if (tNext.x < tNext.y && tNext.x < tNext.z) {
      cell.x += int(stepSign.x);
      tCur = tNext.x;
      tNext.x += tDelta.x;
    } else if (tNext.y < tNext.z) {
      cell.y += int(stepSign.y);
      tCur = tNext.y;
      tNext.y += tDelta.y;
    } else {
      cell.z += int(stepSign.z);
      tCur = tNext.z;
      tNext.z += tDelta.z;
    }
  }
  return c;
}

vec3 precipitation(vec3 c, ivec2 px, float depth) {
  float rain = u.weather.z;
  float snow = u.weather.w;
  if (rain <= 0.0 && snow <= 0.0) {
    return c;
  }
  float t = u.weather3.x;
  float zoom = u.cam.w;
  vec3 dir = cameraRay(px);
  float tMax = min(depth > 0.0 ? depth : RAIN_RANGE, RAIN_RANGE);
  if (rain > 0.0) {
    // Three populations: small slow drops, medium, and large fast ones.
    float speed = max(u.skyAmbient.w, 0.1);
    c = traceParticles(c, dir, tMax, zoom, true, 700.0 * speed, 0.2 * rain, 0, t);
    c = traceParticles(c, dir, tMax, zoom, true, 850.0 * speed, 0.2 * rain, 1, t);
    c = traceParticles(c, dir, tMax, zoom, true, 1000.0 * speed, 0.15 * rain, 2, t);
  } else {
    c = traceParticles(c, dir, tMax, zoom, false, SNOW_SPEED, 0.7 * snow, 0, t);
  }
  return c;
}

// The finished pixel goes to the output, or to the filter image when the post pass follows
// and gathers from it.
void writeOutput(ivec2 p, vec3 c);

vec4 readFilter(ivec2 q) {
  return (pc.pass & 1) == 0 ? imageLoad(filterA, q) : imageLoad(filterB, q);
}

void writeFilter(ivec2 q, vec4 v) {
  if ((pc.pass & 1) == 0) {
    imageStore(filterB, q, v);
  } else {
    imageStore(filterA, q, v);
  }
}

// What exceeds white after exposure feeds the bloom blur; the alpha carries the luminance
// before exposure for the auto exposure meter.
void writeBright(ivec2 p, vec3 exposed, float luminanceBefore) {
  imageStore(bloomSource, p, vec4(max(exposed - 1.0, 0.0), luminanceBefore));
}

// Aerial perspective in linear light: Rayleigh scattering takes blue out of far scenery and
// puts sky light in its place, Mie haze adds a forward glow around the sun, and both lift
// far shadows before anything is hidden. Fog and rain thicken the haze.
vec3 aerialPerspective(vec3 hdr, vec3 dir, float depth) {
  float k = u.post2.z;
  if (k <= 0.0 || depth <= 0.0) {
    return hdr;
  }
  vec3 betaR = vec3(1.4e-5, 3.2e-5, 7.9e-5) * k;
  float betaM = (2.0e-5 + 6.0e-5 * u.weather.y) * k;
  vec3 beta = betaR + betaM;
  vec3 transmittance = exp(-beta * depth);
  float cosS = dot(dir, u.sun.xyz);
  float rayleigh = 0.75 * (1.0 + cosS * cosS);
  const float g = 0.76;
  float mie = (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * cosS, 1.5) * 0.25;
  vec3 sun = u.sunColor.rgb * u.sun.w;
  vec3 inscatter = sun * (betaR * rayleigh + betaM * mie) / beta * 0.6 + u.sky.rgb * 0.35;
  return hdr * transmittance + inscatter * (1.0 - transmittance);
}

void writeOutput(ivec2 p, vec3 c) {
  if (pc.last == 2) {
    writeFilter(p, vec4(c, 1.0));
  } else {
    imageStore(outImage, p, vec4(c, 1.0));
  }
}

// The Shortest Path plugin's route as a ribbon of light on the ground, with pulses running along
// it toward the destination. Entry 0 is the route's bounding box in x and z; the rest are tile
// centres with their distance along the route in w, and a negative w marks a break in the route.
vec3 pathGlow(vec3 pos, vec3 n) {
  int count = int(u.guide.w);
  float up = max(-n.y, 0.0);
  if (count < 2 || up <= 0.0) {
    return vec3(0.0);
  }
  vec4 box = guidePath.v[0];
  if (pos.x < box.x - 64.0 || pos.z < box.y - 64.0 || pos.x > box.z + 64.0 || pos.z > box.w + 64.0) {
    return vec3(0.0);
  }
  float best = 1e30;
  float along = 0.0;
  for (int i = 1; i < count; ++i) {
    vec4 a = guidePath.v[i];
    vec4 b = guidePath.v[i + 1];
    if (a.w < 0.0 || b.w < 0.0) {
      continue;
    }
    vec3 ab = b.xyz - a.xyz;
    float t = clamp(dot(pos - a.xyz, ab) / max(dot(ab, ab), 1.0), 0.0, 1.0);
    vec3 d = pos - (a.xyz + ab * t);
    d.y *= 0.5;
    float d2 = dot(d, d);
    if (d2 < best) {
      best = d2;
      along = mix(a.w, b.w, t);
    }
  }
  float dist = sqrt(best);
  float ribbon = 1.0 - smoothstep(16.0, 56.0, dist);
  float core = 1.0 - smoothstep(0.0, 20.0, dist);
  // A comet every three tiles, its tail trailing back toward the character.
  float tail = fract((u.weather3.x * 320.0 - along) / 384.0);
  float pulse = exp(-tail * 5.0);
  return u.guide.rgb * up * (0.3 * ribbon + 0.7 * core) * (0.55 + 0.9 * pulse);
}

void main() {
  uvec2 px = gl_GlobalInvocationID.xy;
  int w = int(u.misc.z);
  int h = int(u.misc.w);
  if (px.x >= uint(w) || px.y >= uint(h)) {
    return;
  }
  ivec2 p = ivec2(px);
  vec4 position = imageLoad(currPos, p);
  vec4 center = readFilter(p);
  if (position.w < 0.0) {
    writeFilter(p, center);
    if (pc.last != 0) {
      vec3 sky = imageLoad(sampleImage, p).rgb + lightShafts(p) * u.params.y;
      writeBright(p, sky, luminance(sky) / u.params.y);
      writeOutput(p, precipitation(swampMist(sky, p, cameraRay(p), -1.0), p, -1.0));
    }
    return;
  }

  vec3 normal = imageLoad(normalImage, p).xyz;
  float lum = luminance(center.rgb);
  vec4 sample_ = imageLoad(sampleImage, p);
  float footprint = position.w / u.cam.w / max(abs(sample_.a), 0.1);

  // A small blur of the variance stabilises the luminance weight.
  float variance = 0.0;
  float varianceWeight = 0.0;
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      ivec2 q = p + ivec2(dx, dy);
      if (q.x < 0 || q.y < 0 || q.x >= w || q.y >= h || imageLoad(currPos, q).w < 0.0) {
        continue;
      }
      float k = (dx == 0 ? 0.5 : 0.25) * (dy == 0 ? 0.5 : 0.25);
      variance += readFilter(q).a * k;
      varianceWeight += k;
    }
  }
  variance /= max(varianceWeight, 1e-4);
  float lumDenom = u.denoise.x * sqrt(max(variance, 0.0)) + 1e-4;

  float centerKernel = KERNEL[2] * KERNEL[2];
  vec3 sum = center.rgb * centerKernel;
  float sumVariance = center.a * centerKernel * centerKernel;
  float sumWeight = centerKernel;
  for (int dy = -2; dy <= 2; ++dy) {
    for (int dx = -2; dx <= 2; ++dx) {
      if (dx == 0 && dy == 0) {
        continue;
      }
      ivec2 q = p + ivec2(dx, dy) * pc.step;
      if (q.x < 0 || q.y < 0 || q.x >= w || q.y >= h) {
        continue;
      }
      vec4 qPosition = imageLoad(currPos, q);
      if (qPosition.w < 0.0) {
        continue;
      }
      vec4 qValue = readFilter(q);
      vec3 qNormal = imageLoad(normalImage, q).xyz;

      float wNormal = pow(max(dot(normal, qNormal), 0.0), u.denoise.y);
      float expected = length(vec2(dx, dy)) * float(pc.step) * footprint;
      float wPosition = exp(-distance(position.xyz, qPosition.xyz) / (u.denoise.z * expected + 1e-3));
      float wLuminance = exp(-abs(lum - luminance(qValue.rgb)) / lumDenom);
      float weight = KERNEL[dx + 2] * KERNEL[dy + 2] * wNormal * wPosition * wLuminance;

      sum += qValue.rgb * weight;
      sumVariance += qValue.a * weight * weight;
      sumWeight += weight;
    }
  }
  vec4 result = vec4(sum / sumWeight, sumVariance / (sumWeight * sumWeight));
  writeFilter(p, result);
  // Feeding the first filtered level back into the history converges dark regions faster.
  if (pc.pass == 0) {
    vec4 history = imageLoad(currColor, p);
    imageStore(currColor, p, vec4(result.rgb, history.a));
  }

  if (pc.last != 0) {
    vec3 albedo = imageLoad(albedoImage, p).rgb;
    float depth = imageLoad(currPos, p).w;
    vec3 hdr = aerialPerspective(albedo * result.rgb + lightShafts(p) + pathGlow(position.xyz, normal) / u.params.y, cameraRay(p), depth);
    writeBright(p, hdr * u.params.y, luminance(hdr));
    vec3 c = tonemap(hdr);
    // Sky pixels carry a negative depth; they are fogged in the trace pass instead.
    if (u.weather.y > 0.0 && depth > 0.0) {
      c = mix(c, u.fog.rgb, 1.0 - exp(-depth * u.weather.y * FOG_EXTINCTION));
    }
    // The last stretch before the render distance fades into the horizon, where the cut-off
    // rays beyond it show the same colour; the eased curve keeps the onset gentle.
    if (depth > 0.0 && u.post.z > 0.0) {
      float fade = smoothstep(u.post.z * (1.0 - u.post.w), u.post.z, depth);
      c = mix(c, u.fog.rgb, fade * fade * (3.0 - 2.0 * fade));
    }
    c = splashes(c, imageLoad(currPos, p).xyz, imageLoad(normalImage, p).xyz, depth);
    c = swampMist(c, p, cameraRay(p), depth);
    writeOutput(p, precipitation(c, p, depth));
  }
}
