#version 460

// One à-trous wavelet iteration of the SVGF filter over accumulated irradiance. Weights stop
// at normal and position discontinuities and scale with the estimated variance, so noisy
// regions are smoothed widely while converged regions are left alone. The last pass applies
// the albedo, exposure and tone mapping.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;
layout(std140, set = 0, binding = 6) uniform Frame {
  vec4 cam;
  vec4 r0;
  vec4 r1;
  vec4 r2;
  vec4 prevCam;
  vec4 p0;
  vec4 p1;
  vec4 p2;
  vec4 sun;
  vec4 sky;
  vec4 params;  // sun angular radius (radians), exposure, history frames, dynamic history frames
  uvec4 misc;   // frame, flags, width, height
  vec4 extra;
  vec4 denoise; // luminance, normal and position sigmas, unused
  vec4 sunColor;
  vec4 path;
  vec4 motion;
  vec4 weather;  // cloud cover, fog amount, rain, snow
  vec4 weather2; // ground wetness, snow cover, wind velocity x and z in world units per second
  vec4 fog;      // fog colour in display space, lightning flash
  vec4 weather3; // seconds, unused
} u;
layout(push_constant) uniform Push {
  int pass;
  int step;
  int last;
  int passes;
} pc;
layout(set = 0, binding = 8, rgba16f) uniform image2D currColor;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D currPos;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D sampleImage;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D albedoImage;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D normalImage;
// Ping-pong buffers: even passes read A and write B, odd passes the reverse.
layout(set = 0, binding = 17, rgba16f) uniform image2D filterA;
layout(set = 0, binding = 18, rgba16f) uniform image2D filterB;

const float KERNEL[5] = float[5](1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

float luminance(vec3 c) {
  return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Filmic curve (Narkowicz's ACES fit): near-linear midtones with a soft shoulder.
vec3 tonemap(vec3 c) {
  c *= u.params.y;
  return clamp((c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14), 0.0, 1.0);
}

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return fract((p.x + p.y) * p.z);
}

// Fog per world unit of depth: at full amount, scenery four tiles away is two thirds hidden.
const float FOG_EXTINCTION = 2.5 / 1280.0;

// Falling rain and snow. Particles live on three shells around the camera, anchored to the
// world so they parallax with the view, and a shell is hidden wherever the scene is nearer.
// Rain falls fast as streaks, snow slowly as drifting flakes; both are carried by the wind.
vec3 precipitation(vec3 c, ivec2 px, float depth) {
  float rain = u.weather.z;
  float snow = u.weather.w;
  if (rain <= 0.0 && snow <= 0.0) {
    return c;
  }
  float t = u.weather3.x;
  float zoom = u.cam.w;
  // The camera ray through the pixel, as the trace pass builds it.
  vec3 v = vec3((float(px.x) + 0.5 - float(u.misc.z) * 0.5) / zoom, (float(px.y) + 0.5 - float(u.misc.w) * 0.5) / zoom, 1.0);
  vec3 dir = normalize(vec3(dot(u.r0.xyz, v), dot(u.r1.xyz, v), dot(u.r2.xyz, v)));
  vec3 wind = vec3(u.weather2.z, 0.0, u.weather2.w);
  for (int layer = 0; layer < 3; ++layer) {
    float shell = 200.0 * pow(2.5, float(layer));
    if (depth > 0.0 && depth < shell) {
      continue;
    }
    vec3 world = u.cam.xyz + dir * shell;
    float fade = 1.0 / pow(1.5, float(layer));
    // World units per pixel at this distance.
    float pixel = shell / zoom;
    if (rain > 0.0) {
      // Down is +y; a drop's motion is undone so the pattern is fixed in the moving frame.
      vec3 r = world - vec3(wind.x, 700.0, wind.z) * t;
      float cell = shell * 0.05;
      vec3 q = r / vec3(cell, cell * 2.0, cell);
      vec3 id = floor(q);
      vec3 f = fract(q);
      float h = hash13(id + float(layer) * 17.0);
      float present = step(h, 0.6 * rain);
      vec2 drop = vec2(fract(h * 7.31), fract(h * 13.7));
      float top = fract(h * 3.7) * 0.6;
      float width = 1.2 * pixel / cell;
      float streak = (1.0 - smoothstep(width, width * 2.0, length(f.xz - drop))) * step(top, f.y) * step(f.y, top + 0.4);
      c += vec3(0.4) * present * streak * fade;
    }
    if (snow > 0.0) {
      vec3 r = world - vec3(wind.x * 0.5, 90.0, wind.z * 0.5) * t;
      float cell = shell * 0.06;
      vec3 q = r / cell;
      vec3 id = floor(q);
      vec3 f = fract(q);
      float h = hash13(id + 101.0 + float(layer) * 17.0);
      float present = step(h, 0.7 * snow);
      vec3 centre = 0.5 + 0.3 * vec3(sin(t * 1.7 + h * 6.2832), 0.0, cos(t * 1.1 + h * 12.566));
      float radius = 3.0 * pixel / cell;
      float flake = 1.0 - smoothstep(radius, radius * 2.0, length(f - centre));
      c = mix(c, vec3(0.9), present * flake * 0.85 * fade);
    }
  }
  return c;
}

// The finished pixel goes to the output, or to the filter image when a depth of field pass
// follows and gathers from it.
void writeOutput(ivec2 p, vec3 c);

vec4 readFilter(ivec2 q) {
  return (pc.pass & 1) == 0 ? imageLoad(filterA, q) : imageLoad(filterB, q);
}

void writeFilter(ivec2 q, vec4 v) {
  if ((pc.pass & 1) == 0) {
    imageStore(filterB, q, v);
  } else {
    imageStore(filterA, q, v);
  }
}

void writeOutput(ivec2 p, vec3 c) {
  if (pc.last == 2) {
    writeFilter(p, vec4(c, 1.0));
  } else {
    imageStore(outImage, p, vec4(c, 1.0));
  }
}

void main() {
  uvec2 px = gl_GlobalInvocationID.xy;
  int w = int(u.misc.z);
  int h = int(u.misc.w);
  if (px.x >= uint(w) || px.y >= uint(h)) {
    return;
  }
  ivec2 p = ivec2(px);
  vec4 position = imageLoad(currPos, p);
  vec4 center = readFilter(p);
  if (position.w < 0.0) {
    writeFilter(p, center);
    if (pc.last != 0) {
      writeOutput(p, precipitation(imageLoad(sampleImage, p).rgb, p, -1.0));
    }
    return;
  }

  vec3 normal = imageLoad(normalImage, p).xyz;
  float lum = luminance(center.rgb);
  vec4 sample_ = imageLoad(sampleImage, p);
  float footprint = position.w / u.cam.w / max(abs(sample_.a), 0.1);

  // A small blur of the variance stabilises the luminance weight.
  float variance = 0.0;
  float varianceWeight = 0.0;
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      ivec2 q = p + ivec2(dx, dy);
      if (q.x < 0 || q.y < 0 || q.x >= w || q.y >= h || imageLoad(currPos, q).w < 0.0) {
        continue;
      }
      float k = (dx == 0 ? 0.5 : 0.25) * (dy == 0 ? 0.5 : 0.25);
      variance += readFilter(q).a * k;
      varianceWeight += k;
    }
  }
  variance /= max(varianceWeight, 1e-4);
  float lumDenom = u.denoise.x * sqrt(max(variance, 0.0)) + 1e-4;

  float centerKernel = KERNEL[2] * KERNEL[2];
  vec3 sum = center.rgb * centerKernel;
  float sumVariance = center.a * centerKernel * centerKernel;
  float sumWeight = centerKernel;
  for (int dy = -2; dy <= 2; ++dy) {
    for (int dx = -2; dx <= 2; ++dx) {
      if (dx == 0 && dy == 0) {
        continue;
      }
      ivec2 q = p + ivec2(dx, dy) * pc.step;
      if (q.x < 0 || q.y < 0 || q.x >= w || q.y >= h) {
        continue;
      }
      vec4 qPosition = imageLoad(currPos, q);
      if (qPosition.w < 0.0) {
        continue;
      }
      vec4 qValue = readFilter(q);
      vec3 qNormal = imageLoad(normalImage, q).xyz;

      float wNormal = pow(max(dot(normal, qNormal), 0.0), u.denoise.y);
      float expected = length(vec2(dx, dy)) * float(pc.step) * footprint;
      float wPosition = exp(-distance(position.xyz, qPosition.xyz) / (u.denoise.z * expected + 1e-3));
      float wLuminance = exp(-abs(lum - luminance(qValue.rgb)) / lumDenom);
      float weight = KERNEL[dx + 2] * KERNEL[dy + 2] * wNormal * wPosition * wLuminance;

      sum += qValue.rgb * weight;
      sumVariance += qValue.a * weight * weight;
      sumWeight += weight;
    }
  }
  vec4 result = vec4(sum / sumWeight, sumVariance / (sumWeight * sumWeight));
  writeFilter(p, result);
  // Feeding the first filtered level back into the history converges dark regions faster.
  if (pc.pass == 0) {
    vec4 history = imageLoad(currColor, p);
    imageStore(currColor, p, vec4(result.rgb, history.a));
  }

  if (pc.last != 0) {
    vec3 albedo = imageLoad(albedoImage, p).rgb;
    vec3 c = tonemap(albedo * result.rgb);
    // Sky pixels carry a negative depth; they are fogged in the trace pass instead.
    float depth = imageLoad(currPos, p).w;
    if (u.weather.y > 0.0 && depth > 0.0) {
      c = mix(c, u.fog.rgb, 1.0 - exp(-depth * u.weather.y * FOG_EXTINCTION));
    }
    writeOutput(p, precipitation(c, p, depth));
  }
}
