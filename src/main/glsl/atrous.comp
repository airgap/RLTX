#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

// One à-trous wavelet iteration of the SVGF filter over accumulated irradiance. Weights stop
// at normal and position discontinuities and scale with the estimated variance, so noisy
// regions are smoothed widely while converged regions are left alone. The last pass applies
// the albedo, exposure and tone mapping.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;
#include "frame.glsl"
layout(push_constant) uniform Push {
  int pass;
  int step;
  int last;
  int passes;
} pc;
layout(set = 0, binding = 8, rgba16f) uniform image2D currColor;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D currPos;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D sampleImage;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D albedoImage;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D normalImage;
// Ping-pong buffers: even passes read A and write B, odd passes the reverse.
layout(set = 0, binding = 17, rgba16f) uniform image2D filterA;
layout(set = 0, binding = 18, rgba16f) uniform image2D filterB;
layout(std430, set = 0, binding = 26) readonly buffer MistGrid { vec4 v[]; } mistGrid;
layout(set = 0, binding = 27, rgba16f) uniform readonly image2D shaftImage;
layout(std430, set = 0, binding = 32) readonly buffer Lights { vec4 v[]; } localLights;
layout(std430, set = 0, binding = 38) readonly buffer Guide { vec4 v[]; } guidePath;
layout(std430, set = 0, binding = 39) readonly buffer Plumes { vec4 v[]; } plumes;
layout(std430, set = 0, binding = 40) readonly buffer Markers { vec4 v[]; } markers;
layout(std430, set = 0, binding = 43) readonly buffer Prints { vec4 v[]; } prints;
layout(std430, set = 0, binding = 44) readonly buffer Trees { vec4 v[]; } trees;
layout(set = 0, binding = 28, rgba16f) uniform writeonly image2D bloomSource;

const float KERNEL[5] = float[5](1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

float luminance(vec3 c) {
  return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Filmic curve (Narkowicz's ACES fit): near-linear midtones with a soft shoulder.
vec3 tonemap(vec3 c) {
  c *= u.params.y;
  return clamp((c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14), 0.0, 1.0);
}

float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return fract((p.x + p.y) * p.z);
}

// Fog per world unit of depth: at full amount, scenery four tiles away is two thirds hidden.
const float FOG_EXTINCTION = 2.5 / 1280.0;

// Sunlight scattered by the air along the view ray, from the shafts pass; a 3x3 average hides
// its per-pixel sample jitter.
vec3 lightShafts(ivec2 p) {
  if (u.mistColor.w <= 0.0) {
    return vec3(0.0);
  }
  ivec2 size = ivec2(u.misc.zw);
  vec3 sum = vec3(0.0);
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      sum += imageLoad(shaftImage, clamp(p + ivec2(dx, dy), ivec2(0), size - 1)).rgb;
    }
  }
  return sum / 9.0;
}

// The camera ray through a pixel, as the trace pass builds it.
vec3 cameraRay(ivec2 px) {
  float zoom = u.cam.w;
  vec3 v = vec3((float(px.x) + 0.5 - float(u.misc.z) * 0.5) / zoom, (float(px.y) + 0.5 - float(u.misc.w) * 0.5) / zoom, 1.0);
  return normalize(vec3(dot(u.r0.xyz, v), dot(u.r1.xyz, v), dot(u.r2.xyz, v)));
}

float valueNoise(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float n000 = hash13(i);
  float n100 = hash13(i + vec3(1.0, 0.0, 0.0));
  float n010 = hash13(i + vec3(0.0, 1.0, 0.0));
  float n110 = hash13(i + vec3(1.0, 1.0, 0.0));
  float n001 = hash13(i + vec3(0.0, 0.0, 1.0));
  float n101 = hash13(i + vec3(1.0, 0.0, 1.0));
  float n011 = hash13(i + vec3(0.0, 1.0, 1.0));
  float n111 = hash13(i + vec3(1.0, 1.0, 1.0));
  return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y), mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}

// Ground height and mist coverage under a world position, from the per-scene grid.
vec2 mistAt(vec2 xz) {
  int side = int(u.weather3.z);
  vec2 g = xz / 128.0 + u.weather3.w;
  if (g.x < 0.0 || g.y < 0.0 || g.x >= float(side - 1) || g.y >= float(side - 1)) {
    return vec2(0.0, 0.0);
  }
  ivec2 i = ivec2(g);
  vec2 f = g - vec2(i);
  vec2 a = mistGrid.v[i.x * side + i.y].xy;
  vec2 b = mistGrid.v[(i.x + 1) * side + i.y].xy;
  vec2 c = mistGrid.v[i.x * side + i.y + 1].xy;
  vec2 d = mistGrid.v[(i.x + 1) * side + i.y + 1].xy;
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

const float MIST_HEIGHT = 110.0;
const int MIST_STEPS = 40;
const float MIST_RANGE = 3600.0;
// Extinction per world unit at full density: a look straight down through the layer loses
// about half the scene behind it.
const float MIST_EXTINCTION = 1.0 / 48.0;

// Light the nearest local lights throw into the air at a point, scattered evenly, for the mist
// and smoke marches; the lights arrive nearest the camera first, so the first few are the ones
// that can show. Tone mapped here since the volumes composite in display space.
vec3 localGlow(vec3 p) {
  int count = min(int(u.lights.x), 12);
  vec3 sum = vec3(0.0);
  for (int i = 0; i < count; ++i) {
    vec4 pr = localLights.v[i * 2];
    vec3 toLight = pr.xyz - p;
    float d2 = dot(toLight, toLight);
    if (d2 >= pr.w * pr.w) {
      continue;
    }
    float falloff = 1.0 - sqrt(d2) / pr.w;
    sum += localLights.v[i * 2 + 1].rgb * (falloff * falloff);
  }
  return sum * u.lights.y;
}

// Low mist over the swamps: a layer hugging the ground wherever the grid allows it, its
// density a drifting noise field carried by the wind, integrated along the camera ray up to
// the scene surface. Its colour is the sun and sky light it scatters, tone mapped on the CPU.
vec3 swampMist(vec3 c, ivec2 px, vec3 dir, float depth) {
  float amount = u.weather3.y;
  if (amount <= 0.0 || u.weather3.z < 2.0) {
    return c;
  }
  float tMax = min(depth > 0.0 ? depth : MIST_RANGE, MIST_RANGE);
  float dt = tMax / float(MIST_STEPS);
  // Interleaved gradient noise staggers the sample positions so the layer shows no bands.
  float jitter = fract(52.9829189 * fract(0.06711056 * float(px.x) + 0.00583715 * float(px.y)));
  float t = u.weather3.x;
  vec3 drift = vec3(u.weather2.z * 0.4 + 12.0 * t, 0.0, u.weather2.w * 0.4 + 5.0 * t);
  float transmittance = 1.0;
  vec3 lit = vec3(0.0);
  for (int i = 0; i < MIST_STEPS && transmittance > 0.01; ++i) {
    vec3 p = u.cam.xyz + dir * (dt * (float(i) + jitter));
    vec2 ground = mistAt(p.xz);
    // The whole scene may be misted; otherwise only where the grid's coverage allows.
    float cover = (u.misc.y & 131072u) != 0u ? 1.0 : ground.y;
    if (cover <= 0.0) {
      continue;
    }
    // Up is -y: the layer spans from the ground to MIST_HEIGHT above it.
    float height = (ground.x - p.y) / MIST_HEIGHT;
    if (height < -0.1 || height > 1.0) {
      continue;
    }
    float vertical = 1.0 - clamp(height, 0.0, 1.0);
    vec3 q = p + drift;
    float n = 0.65 * valueNoise(q / 360.0) + 0.35 * valueNoise(q / 130.0 + vec3(0.0, t * 0.05, 0.0));
    float density = cover * vertical * vertical * smoothstep(0.3, 0.75, n) * amount;
    float absorb = exp(-density * dt * MIST_EXTINCTION);
    // Torches and lamps standing in the mist light it from within; sampled every few steps.
    if ((i & 3) == 0 && u.lights.x > 0.0) {
      lit += transmittance * (1.0 - absorb) * tonemap(localGlow(p) * 0.6);
    }
    transmittance *= absorb;
  }
  return mix(u.mistColor.rgb, c, transmittance) + lit;
}

// Splash rings where raindrops land: each patch of upward-facing ground takes a drop every so
// often, and for a quarter second afterwards a small faint ring spreads from it and fades. They
// fade out with distance, where they would only read as noise.
vec3 splashes(vec3 c, vec3 p, vec3 n, float depth) {
  float rain = u.weather.z;
  float near = 1.0 - clamp(depth / 1200.0, 0.0, 1.0);
  if (rain <= 0.0 || -n.y < 0.6 || near <= 0.0) {
    return c;
  }
  float t = u.weather3.x;
  vec2 cell = floor(p.xz / 20.0);
  float h = hash12(cell);
  float period = 1.5 / max(rain, 0.05);
  float since = fract(t / period + h) * period;
  if (since > 0.25) {
    return c;
  }
  vec2 centre = (cell + 0.5 + 0.4 * (vec2(hash12(cell + 3.1), hash12(cell + 7.7)) - 0.5)) * 20.0;
  float d = length(p.xz - centre);
  float radius = since * 24.0;
  float ring = 1.0 - smoothstep(0.0, 1.2, abs(d - radius));
  float fade = 1.0 - since / 0.25;
  return c + vec3(0.12) * ring * fade * fade * near;
}

// Rings spreading from fresh footsteps on wet ground, gone within a second and a half.
vec3 footRipples(vec3 c, vec3 p, vec3 n, float depth) {
  int count = int(u.ground.x);
  if (count <= 0 || u.weather2.x < 0.3 || -n.y < 0.6 || depth > 1600.0) {
    return c;
  }
  float t = u.weather3.x;
  for (int i = 0; i < count; ++i) {
    vec4 a = prints.v[i * 2];
    float age = t - a.w;
    if (age < 0.0 || age > 1.5 || abs(p.y - a.y) > 40.0) {
      continue;
    }
    float dist = length(p.xz - a.xz);
    float radius = 6.0 + age * 45.0;
    float ring = 1.0 - smoothstep(0.0, 3.0, abs(dist - radius));
    float fade = 1.0 - age / 1.5;
    c += vec3(0.1) * ring * fade * fade;
  }
  return c;
}

// Falling rain and snow traced through world-anchored three-dimensional grids. Each view ray
// walks a grid cell by cell up to the surface it hits; every cell holds at most one drop, a
// streak along the fall direction, or one flake, and the ray's closest approach to it gives its
// coverage. Drops therefore fall through the scene at their own depth, hidden by whatever stands
// in front, and never alias into points. Rain uses three interleaved grids falling at different
// speeds, as drops of different sizes do, so the field never moves as one sheet. A drop is a
// transparent sphere: the background shows through and what you see is the light it redirects,
// sky and lights reflected and refracted with a strong lobe when the source is behind it.
const float RAIN_CELL = 48.0;
const float RAIN_BASE_LENGTH = 110.0;
const float RAIN_RANGE = 3000.0;
const float SNOW_CELL = 44.0;
const float SNOW_SPEED = 90.0;
const int PRECIPITATION_STEPS = 80;
const uint MASK_SHADOW = 0xBu; // opaque, translucent and hidden roofs

// Integer hash: a fractional hash of whole numbers repeats every few cells and lines drops up.
uint hashCell(ivec3 c) {
  uvec3 v = uvec3(c + 0x40000000) * 1664525u + 1013904223u;
  v.x += v.y * v.z;
  v.y += v.z * v.x;
  v.z += v.x * v.y;
  v ^= v >> 16u;
  v.x += v.y * v.z;
  v.y += v.z * v.x;
  v.z += v.x * v.y;
  return v.x;
}

float unitFrom(uint h) {
  return float(h & 0xFFFFFFu) / 16777216.0;
}

bool sunReaches(vec3 p) {
  if (u.sun.w <= 0.0) {
    return false;
  }
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT, MASK_SHADOW, p, 1.0, u.sun.xyz, 1e6);
  rayQueryProceedEXT(rq);
  return rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

// Light the nearest local lights throw at a point, with a lobe toward the viewer when the
// light is behind the drop; no shadow rays, a drop is too small to shadow accurately.
vec3 localScatter(vec3 p, vec3 dir) {
  int count = min(int(u.lights.x), 64);
  vec3 sum = vec3(0.0);
  for (int i = 0; i < count; ++i) {
    vec4 pr = localLights.v[i * 2];
    vec3 toLight = pr.xyz - p;
    float d2 = dot(toLight, toLight);
    if (d2 >= pr.w * pr.w) {
      continue;
    }
    float d = sqrt(d2);
    float falloff = 1.0 - d / pr.w;
    float forward = pow(max(dot(dir, toLight / d), 0.0), 6.0);
    sum += localLights.v[i * 2 + 1].rgb * (falloff * falloff * (0.15 + 1.2 * forward));
  }
  return sum * u.lights.y;
}

// Light a drop at a world position redirects toward the viewer, in linear radiance.
vec3 dropScatter(vec3 world, vec3 dir) {
  float narrow = pow(max(dot(dir, u.sun.xyz), 0.0), 24.0);
  float broad = pow(max(dot(dir, u.sun.xyz), 0.0), 3.0);
  vec3 scatter = 0.25 * (vec3(u.sky.w) + u.skyAmbient.rgb) + localScatter(world, dir);
  if (sunReaches(world)) {
    scatter += u.sunColor.rgb * (u.sun.w * (0.06 + 0.25 * broad + 1.2 * narrow));
  }
  return scatter;
}

// Walks one grid along the ray and composites the drops or flakes it meets. Kinds: 0 rain,
// 1 snow, 2 autumn leaves, 3 blossom petals; the last three are flakes of different colours.
vec3 traceParticles(vec3 c, vec3 dir, float tMax, float zoom, int kind, float speed, float presence, int salt, float t) {
  bool raining = kind == 0;
  // Cells are taller than the streak so one always fits with room to sit at a random height.
  float streak = RAIN_BASE_LENGTH * max(u.wind.w, 0.1);
  float cellHeight = streak + 90.0;
  vec3 cellSize = raining ? vec3(RAIN_CELL, cellHeight, RAIN_CELL) : vec3(SNOW_CELL);
  float driftScale = raining ? 0.6 : kind == 1 ? 0.4 : 0.9;
  // Scrolled space: the grid falls with the drops and drifts with the wind, so a drop is a fixed
  // segment of its cell there. Streaks lie along the velocity so they slant with the wind.
  vec3 scroll = vec3(u.weather2.z * driftScale, speed * t, u.weather2.w * driftScale);
  vec3 o = u.cam.xyz - scroll;
  vec3 fall = normalize(vec3(u.wind.x * driftScale, speed, u.wind.y * driftScale));
  vec3 pos = o / cellSize;
  ivec3 cell = ivec3(floor(pos));
  vec3 stepSign = sign(dir);
  vec3 safeDir = vec3(abs(dir.x) < 1e-5 ? 1e-5 : dir.x, abs(dir.y) < 1e-5 ? 1e-5 : dir.y, abs(dir.z) < 1e-5 ? 1e-5 : dir.z);
  vec3 tDelta = abs(cellSize / safeDir);
  vec3 tNext = ((floor(pos) + max(stepSign, 0.0)) * cellSize - o) / safeDir;
  float tCur = 0.0;
  for (int i = 0; i < PRECIPITATION_STEPS && tCur < tMax; ++i) {
    ivec3 salted = cell + ivec3(salt * 977, salt * 131, salt * 419);
    uint h = hashCell(salted);
    if (unitFrom(h) < presence) {
      vec3 base = vec3(cell) * cellSize;
      float rx = unitFrom(hashCell(salted + ivec3(7, 0, 0)));
      float rz = unitFrom(hashCell(salted + ivec3(0, 0, 11)));
      float ry = unitFrom(hashCell(salted + ivec3(0, 5, 0)));
      vec3 q;
      float along = 1.0;
      if (raining) {
        vec3 head = base + vec3((0.15 + 0.7 * rx) * RAIN_CELL, ry * (cellHeight - streak), (0.15 + 0.7 * rz) * RAIN_CELL);
        // Closest points between the ray and the streak's line, the streak's clamped to its length.
        vec3 w = o - head;
        float b = dot(dir, fall);
        float dd = dot(dir, w);
        float dv = dot(fall, w);
        float denom = 1.0 - b * b;
        float uSeg = denom < 1e-4 ? -dv : (dv - b * dd) / denom;
        uSeg = clamp(uSeg, 0.0, streak);
        q = head + fall * uSeg;
        along = uSeg / streak;
      } else {
        // Leaves and petals tumble more widely and more slowly than snow.
        float sway = kind == 1 ? 0.3 : 0.45;
        float rate = kind == 1 ? 1.0 : 0.6;
        vec2 wobble = sway * vec2(sin(t * 1.7 * rate + rx * 6.2832), cos(t * 1.1 * rate + rz * 6.2832));
        q = base + (vec3(0.5 + wobble.x, 0.5, 0.5 + wobble.y) + 0.3 * (vec3(rx, ry, rz) - 0.5)) * cellSize;
      }
      float tQ = dot(q - o, dir);
      if (tQ > 0.0 && tQ < tMax) {
        float dist = length(cross(q - o, dir));
        float pixel = tQ / zoom;
        // Streaks a pixel wide with a soft edge; flakes a little rounder.
        float width = raining ? max(1.1 * pixel, 1.1) : max(2.6 * pixel, 2.0);
        float cover = 1.0 - smoothstep(0.4 * width, 1.2 * width, dist);
        if (cover > 0.01) {
          vec3 world = q + scroll;
          float fade = exp(-tQ / 2200.0);
          float alpha = cover * fade * (raining ? 0.7 * (0.3 + 0.7 * along) : 0.85);
          if (raining) {
            // The background stays; the drop adds the light it bends toward the eye.
            vec3 light = tonemap(dropScatter(world, dir)) * vec3(0.85, 0.9, 1.0);
            c = c * (1.0 - 0.25 * alpha) + light * alpha;
          } else {
            // Flakes are bodies lit like the mist: white snow, or a leaf or petal in its own colour.
            vec3 body = vec3(1.0);
            if (kind == 2) {
              float pick = unitFrom(hashCell(salted + ivec3(3, 3, 3)));
              body = pick < 0.35 ? vec3(1.0, 0.45, 0.1) : pick < 0.6 ? vec3(0.75, 0.18, 0.08) : pick < 0.8 ? vec3(0.55, 0.32, 0.12) : vec3(0.95, 0.8, 0.2);
            } else if (kind == 3) {
              body = vec3(1.0, 0.82, 0.86);
            }
            c = mix(c, u.mistColor.rgb * body, alpha);
          }
        }
      }
    }
    if (tNext.x < tNext.y && tNext.x < tNext.z) {
      cell.x += int(stepSign.x);
      tCur = tNext.x;
      tNext.x += tDelta.x;
    } else if (tNext.y < tNext.z) {
      cell.y += int(stepSign.y);
      tCur = tNext.y;
      tNext.y += tDelta.y;
    } else {
      cell.z += int(stepSign.z);
      tCur = tNext.z;
      tNext.z += tDelta.z;
    }
  }
  return c;
}

// Fireflies over misty ground at night and dust motes hanging in daylight: sparse, slow
// particles in a world-anchored grid, each wandering about its cell. Fireflies glow on their
// own in slow pulses; motes show only the sunlight that reaches them, so they sparkle in shafts
// and vanish in shade. Firefly cells are columns, one insect per patch of ground.
const float DRIFT_RANGE = 1400.0;
const int DRIFT_STEPS = 48;

// Kinds: 0 fireflies, 1 dust motes, 2 butterflies.
vec3 drifters(vec3 c, vec3 dir, float tMax, float zoom, float t, int kind, float strength) {
  bool fireflies = kind == 0;
  bool grounded = kind != 1;
  vec3 cellSize = grounded ? vec3(190.0, 1.0e5, 190.0) : vec3(110.0);
  float presence = kind == 0 ? 0.45 : kind == 1 ? 0.3 : 0.16;
  vec3 o = u.cam.xyz;
  vec3 pos = o / cellSize;
  ivec3 cell = ivec3(floor(pos));
  vec3 stepSign = sign(dir);
  vec3 safeDir = vec3(abs(dir.x) < 1e-5 ? 1e-5 : dir.x, abs(dir.y) < 1e-5 ? 1e-5 : dir.y, abs(dir.z) < 1e-5 ? 1e-5 : dir.z);
  vec3 tDelta = abs(cellSize / safeDir);
  vec3 tNext = ((floor(pos) + max(stepSign, 0.0)) * cellSize - o) / safeDir;
  float tCur = 0.0;
  int salt = 5 + kind;
  for (int i = 0; i < DRIFT_STEPS && tCur < tMax; ++i) {
    ivec3 salted = cell + ivec3(salt * 977, salt * 131, salt * 419);
    if (unitFrom(hashCell(salted)) < presence) {
      vec3 r = vec3(unitFrom(hashCell(salted + ivec3(7, 0, 0))), unitFrom(hashCell(salted + ivec3(0, 5, 0))), unitFrom(hashCell(salted + ivec3(0, 0, 11))));
      vec3 phase = r * 6.2832;
      vec3 wander = vec3(sin(t * 0.37 + phase.x), 0.5 * sin(t * 0.23 + phase.y), cos(t * 0.31 + phase.z));
      vec3 q = (vec3(cell) + 0.5 + (r - 0.5) * 0.3) * cellSize + wander * (0.3 * cellSize.x);
      bool present = true;
      if (grounded) {
        vec2 ground = mistAt(q.xz);
        // Fireflies keep to misty ground; butterflies go anywhere the grid knows the ground.
        present = fireflies ? ground.y > 0.0 : ground.x != 0.0;
        // Up is -y: they hover between knee and head height over the ground.
        q.y = ground.x - (30.0 + 120.0 * r.y) - 15.0 * wander.y;
      }
      float tQ = dot(q - o, dir);
      if (present && tQ > 0.0 && tQ < tMax) {
        float dist = length(cross(q - o, dir));
        float pixel = tQ / zoom;
        float fade = strength * exp(-tQ / 1500.0);
        if (kind == 2) {
          // A butterfly: a small flat shape whose width pulses with its wingbeat.
          float beat = abs(cos(t * 9.0 + r.x * 6.2832));
          vec3 off = (o + dir * tQ) - q;
          vec2 span = vec2(6.0 + 8.0 * beat, 7.0);
          float shape = dot(off.xz / span, off.xz / span) + off.y * off.y / 4.0;
          float cover = (1.0 - smoothstep(0.7, 1.3, shape)) * (1.0 - smoothstep(600.0, 1200.0, tQ));
          if (cover > 0.01) {
            vec3 body = r.z < 0.3 ? vec3(1.0, 0.95, 0.85) : r.z < 0.55 ? vec3(1.0, 0.8, 0.15) : r.z < 0.8 ? vec3(1.0, 0.5, 0.1) : vec3(0.35, 0.5, 1.0);
            c = mix(c, u.mistColor.rgb * body, cover * strength);
          }
        } else if (fireflies) {
          // Lit for about a second and a half every few seconds, each on its own clock.
          float period = 3.0 + 3.0 * r.z;
          float cycle = fract(t / period + r.x);
          float pulse = smoothstep(0.0, 0.12, cycle) * (1.0 - smoothstep(0.22, 0.4, cycle));
          float core = 1.0 - smoothstep(0.6 * pixel, 1.8 * pixel, dist);
          float halo = exp(-dist / (5.0 * pixel));
          c += vec3(0.65, 1.0, 0.3) * ((0.9 * core + 0.3 * halo) * pulse * fade);
        } else {
          float width = max(0.9 * pixel, 0.9);
          float cover = 1.0 - smoothstep(0.3 * width, 1.1 * width, dist);
          if (cover > 0.01 && sunReaches(q)) {
            float forward = pow(max(dot(dir, u.sun.xyz), 0.0), 8.0);
            vec3 light = tonemap(u.sunColor.rgb * (u.sun.w * (0.03 + 0.6 * forward)));
            c = mix(c, light, 0.55 * cover * fade);
          }
        }
      }
    }
    if (tNext.x < tNext.y && tNext.x < tNext.z) {
      cell.x += int(stepSign.x);
      tCur = tNext.x;
      tNext.x += tDelta.x;
    } else if (tNext.y < tNext.z) {
      cell.y += int(stepSign.y);
      tCur = tNext.y;
      tNext.y += tDelta.y;
    } else {
      cell.z += int(stepSign.z);
      tCur = tNext.z;
      tNext.z += tDelta.z;
    }
  }
  return c;
}

// Smoke from chimneys and fires: each plume a column of turbulent density rising from its
// source, widening and thinning as it climbs and leaning with the wind. A view ray is marched
// only through the bounding cylinder of each plume it crosses, in a sheared space where the
// leaning plume stands upright. Lit like the mist, with the fire's own glow at the base.
const int PLUME_STEPS = 14;
const float PLUME_HEIGHT = 720.0;
const float PLUME_RISE = 110.0;
const float PLUME_RADIUS = 210.0;

vec3 smokePlumes(vec3 c, ivec2 px, vec3 dir, float depth) {
  int count = int(u.denoise.w);
  if (count <= 0) {
    return c;
  }
  float tMax = depth > 0.0 ? depth : 1.0e9;
  float t = u.weather3.x;
  float jitter = fract(52.9829189 * fract(0.06711056 * float(px.x) + 0.00583715 * float(px.y)));
  // Horizontal displacement per unit of height, from the wind carrying the smoke as it rises.
  vec3 lean = vec3(u.wind.x, 0.0, u.wind.y) / PLUME_RISE;
  float leanLength = length(lean);
  if (leanLength > 0.8) {
    lean *= 0.8 / leanLength;
  }
  vec3 smoke = u.mistColor.rgb * 0.45;
  vec3 ember = vec3(1.0, 0.42, 0.1);
  for (int i = 0; i < count; ++i) {
    vec4 s = plumes.v[i];
    float away = length(s.xyz - u.cam.xyz);
    if (away > 3200.0) {
      continue;
    }
    // Sheared space keeps the ray parameter: p' = p - lean * h, with h = s.y - p.y the height
    // above the source, so the leaning plume becomes a vertical cylinder about s.
    vec3 o = u.cam.xyz - lean * (s.y - u.cam.y);
    vec3 d = dir + lean * dir.y;
    vec2 oc = o.xz - s.xz;
    float a = dot(d.xz, d.xz);
    float b = dot(oc, d.xz);
    float cc = dot(oc, oc) - PLUME_RADIUS * PLUME_RADIUS;
    float t0;
    float t1;
    if (a < 1.0e-6) {
      if (cc > 0.0) {
        continue;
      }
      t0 = 0.0;
      t1 = tMax;
    } else {
      float disc = b * b - a * cc;
      if (disc < 0.0) {
        continue;
      }
      float sq = sqrt(disc);
      t0 = (-b - sq) / a;
      t1 = (-b + sq) / a;
    }
    // Up is -y: the plume lives between s.y and s.y - PLUME_HEIGHT.
    if (abs(d.y) > 1.0e-6) {
      float ty0 = (s.y - PLUME_HEIGHT - o.y) / d.y;
      float ty1 = (s.y - o.y) / d.y;
      t0 = max(t0, min(ty0, ty1));
      t1 = min(t1, max(ty0, ty1));
    } else if (o.y < s.y - PLUME_HEIGHT || o.y > s.y) {
      continue;
    }
    t0 = max(t0, 0.0);
    t1 = min(t1, tMax);
    if (t1 <= t0) {
      continue;
    }
    float dt = (t1 - t0) / float(PLUME_STEPS);
    float transmittance = 1.0;
    vec3 gained = vec3(0.0);
    float strength = s.w * (1.0 - smoothstep(2000.0, 3200.0, away));
    for (int k = 0; k < PLUME_STEPS && transmittance > 0.02; ++k) {
      vec3 p = o + d * (t0 + dt * (float(k) + jitter));
      float h = s.y - p.y;
      float radius = 26.0 + 0.24 * h;
      float radial = 1.0 - smoothstep(0.35, 1.0, length(p.xz - s.xz) / radius);
      float vertical = pow(1.0 - clamp(h / PLUME_HEIGHT, 0.0, 1.0), 1.3) * smoothstep(-10.0, 30.0, h);
      // The noise scrolls upward at the rise speed so the puffs climb.
      vec3 q = vec3(p.x - s.x, p.y + t * PLUME_RISE, p.z - s.z) / 55.0;
      float n = 0.6 * valueNoise(q) + 0.4 * valueNoise(q * 2.3 + 7.0);
      float density = radial * vertical * smoothstep(0.32, 0.72, n) * strength;
      if (density <= 0.0) {
        continue;
      }
      float absorb = exp(-density * dt * 0.02);
      vec3 colour = smoke + ember * (0.9 * exp(-h / 55.0));
      if (u.lights.x > 0.0) {
        // The fire below and any lamps nearby light the smoke from within.
        colour += tonemap(localGlow(p) * 0.5);
      }
      gained += transmittance * (1.0 - absorb) * colour;
      transmittance *= absorb;
    }
    c = c * transmittance + gained;
  }
  return c;
}

// A small flying body seen along the ray: two wings on a heading, beating about the body, drawn
// where the ray passes through the thin shape, its edges softened by about a pixel.
float wingCover(vec3 o, vec3 dir, float zoom, vec3 body, vec3 heading, float span, float flap, float tMax) {
  float tQ = dot(body - o, dir);
  if (tQ < 40.0 || tQ > tMax) {
    return 0.0;
  }
  vec3 off = (o + dir * tQ) - body;
  if (dot(off, off) > span * span) {
    return 0.0;
  }
  vec3 side = normalize(cross(vec3(0.0, 1.0, 0.0), heading));
  float along = dot(off, side);
  float fore = dot(off, heading);
  float rise = -off.y;
  float reach = abs(along) / (0.5 * span);
  if (reach > 1.0) {
    return 0.0;
  }
  float wingRise = flap * pow(reach, 1.3) * 0.25 * span;
  float pixel = tQ / zoom;
  float thickness = max(0.06 * span * (1.0 - 0.6 * reach), 0.6 * pixel);
  float bodyHalf = max(0.08 * span + 0.12 * span * (1.0 - reach), 0.6 * pixel);
  float edge = max(abs(rise - wingRise) - thickness, abs(fore) - bodyHalf);
  return 1.0 - smoothstep(-0.5 * pixel, 0.5 * pixel, edge);
}

// Flocks of birds wheeling in the sky by day and at dusk, and bats over misty ground at night.
// Flocks belong to wide cells of the world, so they stay put as the camera moves.
vec3 fliers(vec3 c, vec3 dir, float tMax, float zoom, float t, float day, float night) {
  vec3 o = u.cam.xyz;
  float birds = smoothstep(-0.2, -0.05, u.post2.w) * (1.0 - u.weather.z) * (1.0 - 0.6 * u.weather.x);
  if (birds > 0.01) {
    vec3 dark = vec3(0.03, 0.03, 0.04) * (0.3 + 0.7 * day);
    ivec2 home = ivec2(floor(o.xz / 2400.0));
    for (int fx = -1; fx <= 1; ++fx) {
      for (int fz = -1; fz <= 1; ++fz) {
        ivec2 cell = home + ivec2(fx, fz);
        uint h = hashCell(ivec3(cell.x, 77, cell.y));
        if (unitFrom(h) > 0.55 * birds) {
          continue;
        }
        vec3 anchor = vec3((float(cell.x) + 0.3 + 0.4 * unitFrom(hashCell(ivec3(cell.x, 1, cell.y)))) * 2400.0,
          -700.0 - 500.0 * unitFrom(hashCell(ivec3(cell.x, 2, cell.y))),
          (float(cell.y) + 0.3 + 0.4 * unitFrom(hashCell(ivec3(cell.x, 3, cell.y)))) * 2400.0);
        float radius = 250.0 + 250.0 * unitFrom(hashCell(ivec3(cell.x, 4, cell.y)));
        float rate = (0.12 + 0.08 * unitFrom(hashCell(ivec3(cell.x, 5, cell.y)))) * (unitFrom(h) < 0.27 ? 1.0 : -1.0);
        float phase0 = t * rate + 6.2832 * unitFrom(hashCell(ivec3(cell.x, 6, cell.y)));
        int flock = 6 + int(6.0 * unitFrom(hashCell(ivec3(cell.x, 7, cell.y))));
        for (int i = 0; i < flock; ++i) {
          ivec3 id = ivec3(cell.x, 100 + i, cell.y);
          vec3 r = vec3(unitFrom(hashCell(id)), unitFrom(hashCell(id + ivec3(0, 31, 0))), unitFrom(hashCell(id + ivec3(0, 63, 0))));
          float phase = phase0 + (r.x - 0.5) * 0.5;
          vec3 body = anchor + vec3(cos(phase) * radius, (r.y - 0.5) * 120.0 + 25.0 * sin(t * 0.7 + r.z * 6.2832), sin(phase) * radius);
          vec3 heading = normalize(vec3(-sin(phase), 0.0, cos(phase)) * sign(rate));
          float flap = sin(t * (6.0 + 2.0 * r.z) + r.x * 6.2832);
          float cover = wingCover(o, dir, zoom, body, heading, 44.0, flap, tMax);
          if (cover > 0.0) {
            c = mix(c, dark, cover * birds);
          }
        }
      }
    }
  }
  if (night > 0.01 && u.weather3.z >= 2.0) {
    // Bats: a few per patch of misty ground, jinking about above it.
    ivec2 home = ivec2(floor(o.xz / 480.0));
    for (int fx = -2; fx <= 2; ++fx) {
      for (int fz = -2; fz <= 2; ++fz) {
        ivec2 cell = home + ivec2(fx, fz);
        vec2 centre = (vec2(cell) + 0.5) * 480.0;
        vec2 ground = mistAt(centre);
        if (ground.y <= 0.0 || unitFrom(hashCell(ivec3(cell.x, 88, cell.y))) > 0.5) {
          continue;
        }
        for (int i = 0; i < 2; ++i) {
          ivec3 id = ivec3(cell.x, 200 + i, cell.y);
          vec3 r = vec3(unitFrom(hashCell(id)), unitFrom(hashCell(id + ivec3(0, 31, 0))), unitFrom(hashCell(id + ivec3(0, 63, 0))));
          vec3 jink = vec3(sin(t * 2.3 + r.x * 6.2832) + 0.5 * sin(t * 5.1 + r.y * 6.2832),
            0.4 * sin(t * 3.7 + r.z * 6.2832),
            cos(t * 1.9 + r.y * 6.2832) + 0.5 * cos(t * 4.3 + r.x * 6.2832));
          vec3 body = vec3(centre.x, ground.x - 90.0 - 140.0 * r.z, centre.y) + jink * vec3(150.0, 60.0, 150.0);
          vec3 velocity = vec3(2.3 * cos(t * 2.3 + r.x * 6.2832) + 2.55 * cos(t * 5.1 + r.y * 6.2832), 0.0,
            -1.9 * sin(t * 1.9 + r.y * 6.2832) - 2.15 * sin(t * 4.3 + r.x * 6.2832));
          vec3 heading = normalize(velocity + vec3(1e-3, 0.0, 0.0));
          float flap = sin(t * 15.0 + r.x * 6.2832);
          float cover = wingCover(o, dir, zoom, body, heading, 26.0, flap, min(tMax, 900.0));
          if (cover > 0.0) {
            c = mix(c, vec3(0.02, 0.02, 0.025), cover * night);
          }
        }
      }
    }
  }
  return c;
}

// Wisps: a few motes of the route's light drifting along it toward the destination, hovering
// above the ground, bobbing and breathing, each with a soft halo, hidden by what stands before.
vec3 wisps(vec3 c, vec3 dir, float tMax, float zoom, float t) {
  int packed = int(u.guide.w);
  int count = packed & 1023;
  int n = (packed >> 10) & 63;
  int style = packed >> 16;
  if (n == 0 || style < 2) {
    return c;
  }
  vec3 o = u.cam.xyz;
  for (int k = 0; k < n; ++k) {
    vec4 w = guidePath.v[count + 1 + k];
    vec3 q = w.xyz + vec3(6.0 * sin(t * 1.3 + w.w), -36.0 - 10.0 * sin(t * 1.9 + w.w * 2.1), 6.0 * cos(t * 1.1 + w.w * 1.7));
    float tQ = dot(q - o, dir);
    if (tQ < 30.0 || tQ > tMax) {
      continue;
    }
    float dist = length(cross(q - o, dir));
    float pixel = tQ / zoom;
    float core = 1.0 - smoothstep(0.8 * pixel, 2.2 * pixel, dist);
    float halo = exp(-dist / (6.0 * pixel));
    float breath = 0.7 + 0.3 * sin(t * 3.0 + w.w * 2.7);
    c += u.guide.rgb * (0.5 * (0.8 * core + 0.25 * halo) * breath);
  }
  return c;
}

vec3 ambientLife(vec3 c, ivec2 px, vec3 dir, float depth) {
  bool fireflies = (u.misc.y & 262144u) != 0u && u.weather3.z >= 2.0;
  bool dust = (u.misc.y & 524288u) != 0u && u.sun.w > 0.0;
  float t = u.weather3.x;
  c = wisps(c, dir, depth > 0.0 ? depth : 1.0e9, u.cam.w, t);
  float tMax = min(depth > 0.0 ? depth : DRIFT_RANGE, DRIFT_RANGE);
  // Fireflies keep to dry nights; motes need daylight to be seen at all.
  float night = (1.0 - smoothstep(-0.08, 0.03, u.post2.w)) * (1.0 - u.weather.z);
  if (fireflies && night > 0.01) {
    c = drifters(c, dir, tMax, u.cam.w, t, 0, night);
  }
  float day = smoothstep(-0.02, 0.08, u.post2.w);
  if (dust && day > 0.01) {
    c = drifters(c, dir, tMax, u.cam.w, t, 1, day);
  }
  bool wildlife = (u.misc.y & 16777216u) != 0u;
  if (wildlife && day > 0.01 && u.weather3.z >= 2.0) {
    // Butterflies keep to fair weather.
    c = drifters(c, dir, tMax, u.cam.w, t, 2, day * (1.0 - u.weather.z) * (1.0 - 0.7 * u.weather.x));
  }
  if (wildlife) {
    c = fliers(c, dir, tMax, u.cam.w, t, day, night);
  }
  return c;
}

// Leaves and petals let go by the trees themselves: each tree sheds a handful from the underside
// of its crown that drift the rest of the way down, fluttering and carried by the wind, then let
// go again. Which leaves fall is decided per drop, so the amount thins them without popping.
vec3 treeLeaves(vec3 c, vec3 dir, float tMax, float zoom, float t, float amount, bool petals) {
  int count = int(u.star2.w);
  vec3 o = u.cam.xyz;
  for (int i = 0; i < count; ++i) {
    vec4 tree = trees.v[i];
    float fallHeight = 2.2 * tree.w;
    vec3 centre = vec3(tree.x, tree.y + 0.5 * fallHeight, tree.z);
    vec3 rel = centre - o;
    float along = dot(rel, dir);
    float bound = 0.5 * fallHeight + tree.w + 60.0;
    if (along < -bound || along > tMax + bound) {
      continue;
    }
    vec3 perp = rel - dir * along;
    if (dot(perp, perp) > bound * bound) {
      continue;
    }
    ivec3 seed = ivec3(int(tree.x), int(tree.z), 0);
    for (int k = 0; k < 8; ++k) {
      ivec3 id = seed + ivec3(k * 7919, 0, k);
      vec3 r = vec3(unitFrom(hashCell(id)), unitFrom(hashCell(id + ivec3(0, 1, 0))), unitFrom(hashCell(id + ivec3(0, 2, 0))));
      float speed = 55.0 + 25.0 * r.z;
      // The crown's underside sits about one radius below its top; the ground is the model's foot.
      float startY = tree.y + tree.w * (0.7 + 0.6 * r.z);
      float drop = max(tree.y + fallHeight - startY, 40.0);
      float period = drop / speed;
      float phase = t / period + r.y * 3.7;
      if (unitFrom(hashCell(id + ivec3(0, 3 + int(floor(phase)), 0))) > amount) {
        continue;
      }
      float cycle = fract(phase);
      float ang = r.x * 6.2832;
      float rad = tree.w * (0.3 + 0.7 * sqrt(r.y));
      vec3 start = vec3(tree.x + cos(ang) * rad, startY, tree.z + sin(ang) * rad);
      vec2 flutter = vec2(sin(t * 2.1 + ang) * 14.0 + cos(t * 3.3 + r.y * 6.2) * 6.0, cos(t * 1.7 + r.z * 6.2832) * 14.0);
      vec3 q = start + vec3(flutter.x, cycle * drop, flutter.y) + vec3(u.wind.x, 0.0, u.wind.y) * (cycle * period * 0.35);
      float tQ = dot(q - o, dir);
      if (tQ < 30.0 || tQ > tMax) {
        continue;
      }
      float dist = length(cross(q - o, dir));
      float size = max(3.0, 1.2 * tQ / zoom);
      float cover = 1.0 - smoothstep(0.5 * size, 1.1 * size, dist);
      if (cover > 0.01) {
        vec3 body = petals ? vec3(1.0, 0.82, 0.86)
          : r.x < 0.35 ? vec3(1.0, 0.45, 0.1) : r.x < 0.6 ? vec3(0.75, 0.18, 0.08) : r.x < 0.8 ? vec3(0.55, 0.32, 0.12) : vec3(0.95, 0.8, 0.2);
        c = mix(c, u.mistColor.rgb * body, cover * 0.9);
      }
    }
  }
  return c;
}

vec3 precipitation(vec3 c, ivec2 px, float depth) {
  float rain = u.weather.z;
  float snow = u.weather.w;
  float leaves = u.season.z;
  float petals = u.season.w;
  if (rain <= 0.0 && snow <= 0.0 && leaves <= 0.0 && petals <= 0.0) {
    return c;
  }
  float t = u.weather3.x;
  float zoom = u.cam.w;
  vec3 dir = cameraRay(px);
  float tMax = min(depth > 0.0 ? depth : RAIN_RANGE, RAIN_RANGE);
  if (rain > 0.0) {
    // Three populations: small slow drops, medium, and large fast ones.
    float speed = max(u.skyAmbient.w, 0.1);
    c = traceParticles(c, dir, tMax, zoom, 0, 700.0 * speed, 0.2 * rain, 0, t);
    c = traceParticles(c, dir, tMax, zoom, 0, 850.0 * speed, 0.2 * rain, 1, t);
    c = traceParticles(c, dir, tMax, zoom, 0, 1000.0 * speed, 0.15 * rain, 2, t);
  } else if (snow > 0.0) {
    c = traceParticles(c, dir, tMax, zoom, 1, SNOW_SPEED, 0.7 * snow, 0, t);
  }
  // Autumn leaves and spring petals fall from the trees, thinning out in rain.
  float dry = 1.0 - clamp(rain, 0.0, 1.0);
  if (leaves > 0.0) {
    c = treeLeaves(c, dir, tMax, zoom, t, 0.7 * leaves * dry, false);
  }
  if (petals > 0.0) {
    c = treeLeaves(c, dir, tMax, zoom, t, 0.5 * petals * dry, true);
  }
  return c;
}

// The finished pixel goes to the output, or to the filter image when the post pass follows
// and gathers from it.
void writeOutput(ivec2 p, vec3 c);

vec4 readFilter(ivec2 q) {
  return (pc.pass & 1) == 0 ? imageLoad(filterA, q) : imageLoad(filterB, q);
}

void writeFilter(ivec2 q, vec4 v) {
  if ((pc.pass & 1) == 0) {
    imageStore(filterB, q, v);
  } else {
    imageStore(filterA, q, v);
  }
}

// What exceeds white after exposure feeds the bloom blur; the alpha carries the luminance
// before exposure for the auto exposure meter.
void writeBright(ivec2 p, vec3 exposed, float luminanceBefore) {
  imageStore(bloomSource, p, vec4(max(exposed - 1.0, 0.0), luminanceBefore));
}

// Aerial perspective in linear light: Rayleigh scattering takes blue out of far scenery and
// puts sky light in its place, Mie haze adds a forward glow around the sun, and both lift
// far shadows before anything is hidden. Fog and rain thicken the haze.
vec3 aerialPerspective(vec3 hdr, vec3 dir, float depth) {
  float k = u.post2.z;
  if (k <= 0.0 || depth <= 0.0) {
    return hdr;
  }
  vec3 betaR = vec3(1.4e-5, 3.2e-5, 7.9e-5) * k;
  float betaM = (2.0e-5 + 6.0e-5 * u.weather.y) * k;
  vec3 beta = betaR + betaM;
  vec3 transmittance = exp(-beta * depth);
  float cosS = dot(dir, u.sun.xyz);
  float rayleigh = 0.75 * (1.0 + cosS * cosS);
  const float g = 0.76;
  float mie = (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * cosS, 1.5) * 0.25;
  vec3 sun = u.sunColor.rgb * u.sun.w;
  vec3 inscatter = sun * (betaR * rayleigh + betaM * mie) / beta * 0.6 + u.sky.rgb * 0.35;
  return hdr * transmittance + inscatter * (1.0 - transmittance);
}

void writeOutput(ivec2 p, vec3 c) {
  if (pc.last == 2) {
    writeFilter(p, vec4(c, 1.0));
  } else {
    imageStore(outImage, p, vec4(c, 1.0));
  }
}

// The Shortest Path plugin's route as a ribbon of light on the ground, with pulses running along
// it toward the destination. Entry 0 is the route's bounding box in x and z; the rest are tile
// centres with their distance along the route in w, and a negative w marks a break in the route.
vec3 pathGlow(vec3 pos, vec3 n) {
  int packed = int(u.guide.w);
  int count = packed & 1023;
  int style = packed >> 16;
  float up = max(-n.y, 0.0);
  if (count < 2 || up <= 0.0 || style != 0) {
    return vec3(0.0);
  }
  vec4 box = guidePath.v[0];
  if (pos.x < box.x - 64.0 || pos.z < box.y - 64.0 || pos.x > box.z + 64.0 || pos.z > box.w + 64.0) {
    return vec3(0.0);
  }
  float best = 1e30;
  float along = 0.0;
  for (int i = 1; i < count; ++i) {
    vec4 a = guidePath.v[i];
    vec4 b = guidePath.v[i + 1];
    if (a.w < 0.0 || b.w < 0.0) {
      continue;
    }
    vec3 ab = b.xyz - a.xyz;
    float t = clamp(dot(pos - a.xyz, ab) / max(dot(ab, ab), 1.0), 0.0, 1.0);
    vec3 d = pos - (a.xyz + ab * t);
    d.y *= 0.5;
    float d2 = dot(d, d);
    if (d2 < best) {
      best = d2;
      along = mix(a.w, b.w, t);
    }
  }
  float dist = sqrt(best);
  float ribbon = 1.0 - smoothstep(16.0, 56.0, dist);
  float core = 1.0 - smoothstep(0.0, 20.0, dist);
  // A comet every three tiles, its tail trailing back toward the character.
  float tail = fract((u.weather3.x * 320.0 - along) / 384.0);
  float pulse = exp(-tail * 5.0);
  return u.guide.rgb * up * (0.3 * ribbon + 0.7 * core) * (0.55 + 0.9 * pulse);
}

// Ground Markers' tiles as pools of their own colour lying on the ground, breathing slowly.
// Entry 0 is the bounding box in x and z; the rest are tile centres with the colour's bits in w.
vec3 markerGlow(vec3 pos, vec3 n) {
  int count = int(u.marks.x);
  float up = max(-n.y, 0.0);
  if (count < 1 || up <= 0.0) {
    return vec3(0.0);
  }
  vec4 box = markers.v[0];
  if (pos.x < box.x - 80.0 || pos.z < box.y - 80.0 || pos.x > box.z + 80.0 || pos.z > box.w + 80.0) {
    return vec3(0.0);
  }
  vec3 glow = vec3(0.0);
  for (int i = 1; i <= count; ++i) {
    vec4 m = markers.v[i];
    vec2 d = abs(pos.xz - m.xz);
    float edge = max(d.x, d.y);
    if (edge > 76.0 || abs(pos.y - m.y) > 90.0) {
      continue;
    }
    uint bits = floatBitsToUint(m.w);
    vec3 colour = vec3(float((bits >> 16u) & 0xFFu), float((bits >> 8u) & 0xFFu), float(bits & 0xFFu)) / 255.0;
    colour *= colour;
    float pool = (1.0 - smoothstep(40.0, 72.0, edge)) * (0.85 + 0.15 * sin(u.weather3.x * 1.7 + float(i)));
    glow += colour * pool;
  }
  return glow * (up * u.marks.y);
}

void main() {
  uvec2 px = gl_GlobalInvocationID.xy;
  int w = int(u.misc.z);
  int h = int(u.misc.w);
  if (px.x >= uint(w) || px.y >= uint(h)) {
    return;
  }
  ivec2 p = ivec2(px);
  vec4 position = imageLoad(currPos, p);
  vec4 center = readFilter(p);
  // Sky pixels are shown as painted, except in a held frame, where they were accumulated as
  // radiance and take the same path as everything else.
  if (position.w < 0.0 && (u.misc.y & 1048576u) == 0u) {
    writeFilter(p, center);
    if (pc.last != 0) {
      vec3 sky = imageLoad(sampleImage, p).rgb + lightShafts(p) * u.params.y;
      writeBright(p, sky, luminance(sky) / u.params.y);
      vec3 dir = cameraRay(p);
      if ((u.misc.y & 33554432u) != 0u) {
        // Under water the open ends in the murk rather than the sky.
        writeOutput(p, mix(sky, tonemap(u.skyAmbient.rgb * vec3(0.12, 0.42, 0.5)), 0.9));
        return;
      }
      writeOutput(p, precipitation(swampMist(smokePlumes(ambientLife(sky, p, dir, -1.0), p, dir, -1.0), p, dir, -1.0), p, -1.0));
    }
    return;
  }

  vec3 normal = imageLoad(normalImage, p).xyz;
  float lum = luminance(center.rgb);
  vec4 sample_ = imageLoad(sampleImage, p);
  float footprint = position.w / u.cam.w / max(abs(sample_.a), 0.1);

  // A small blur of the variance stabilises the luminance weight.
  float variance = 0.0;
  float varianceWeight = 0.0;
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      ivec2 q = p + ivec2(dx, dy);
      if (q.x < 0 || q.y < 0 || q.x >= w || q.y >= h || imageLoad(currPos, q).w < 0.0) {
        continue;
      }
      float k = (dx == 0 ? 0.5 : 0.25) * (dy == 0 ? 0.5 : 0.25);
      variance += readFilter(q).a * k;
      varianceWeight += k;
    }
  }
  variance /= max(varianceWeight, 1e-4);
  float lumDenom = u.denoise.x * sqrt(max(variance, 0.0)) + 1e-4;

  // A held frame that has gathered enough samples is its own average. Its remaining variance is
  // the spread of what the lens and pixel jitter saw, not noise, and filtering on it would only
  // smear texture and bokeh the samples already resolved, so the filter stands down.
  bool converged = (u.misc.y & 1048576u) != 0u && imageLoad(currColor, p).a >= 24.0;
  int reach = converged ? 0 : 2;
  float centerKernel = KERNEL[2] * KERNEL[2];
  vec3 sum = center.rgb * centerKernel;
  float sumVariance = center.a * centerKernel * centerKernel;
  float sumWeight = centerKernel;
  for (int dy = -reach; dy <= reach; ++dy) {
    for (int dx = -reach; dx <= reach; ++dx) {
      if (dx == 0 && dy == 0) {
        continue;
      }
      ivec2 q = p + ivec2(dx, dy) * pc.step;
      if (q.x < 0 || q.y < 0 || q.x >= w || q.y >= h) {
        continue;
      }
      vec4 qPosition = imageLoad(currPos, q);
      if (qPosition.w < 0.0) {
        continue;
      }
      vec4 qValue = readFilter(q);
      vec3 qNormal = imageLoad(normalImage, q).xyz;

      float wNormal = pow(max(dot(normal, qNormal), 0.0), u.denoise.y);
      float expected = length(vec2(dx, dy)) * float(pc.step) * footprint;
      float wPosition = exp(-distance(position.xyz, qPosition.xyz) / (u.denoise.z * expected + 1e-3));
      float wLuminance = exp(-abs(lum - luminance(qValue.rgb)) / lumDenom);
      float weight = KERNEL[dx + 2] * KERNEL[dy + 2] * wNormal * wPosition * wLuminance;

      sum += qValue.rgb * weight;
      sumVariance += qValue.a * weight * weight;
      sumWeight += weight;
    }
  }
  vec4 result = vec4(sum / sumWeight, sumVariance / (sumWeight * sumWeight));
  writeFilter(p, result);
  // Feeding the first filtered level back into the history converges dark regions faster.
  if (pc.pass == 0) {
    vec4 history = imageLoad(currColor, p);
    imageStore(currColor, p, vec4(result.rgb, history.a));
  }

  if (pc.last != 0) {
    vec3 albedo = imageLoad(albedoImage, p).rgb;
    float depth = imageLoad(currPos, p).w;
    vec3 hdr = aerialPerspective(albedo * result.rgb + lightShafts(p) + (pathGlow(position.xyz, normal) + markerGlow(position.xyz, normal)) / u.params.y, cameraRay(p), depth);
    bool underwater = (u.misc.y & 33554432u) != 0u;
    if (underwater) {
      // Under water: red goes first, then green, until only the deep colour is left.
      float reach = depth > 0.0 ? depth : 3000.0;
      vec3 deep = u.skyAmbient.rgb * vec3(0.12, 0.42, 0.5) + vec3(0.002, 0.01, 0.012);
      hdr = mix(deep, hdr, exp(-reach * vec3(0.0022, 0.0012, 0.0009)));
    }
    writeBright(p, hdr * u.params.y, luminance(hdr));
    vec3 c = tonemap(hdr);
    // Sky pixels carry a negative depth; they are fogged in the trace pass instead.
    if (u.weather.y > 0.0 && depth > 0.0) {
      c = mix(c, u.fog.rgb, 1.0 - exp(-depth * u.weather.y * FOG_EXTINCTION));
    }
    // The last stretch before the render distance fades into the horizon colour in that
    // direction, which the cut-off rays beyond it show too; the eased curve keeps the onset gentle.
    if (depth > 0.0 && u.post.z > 0.0) {
      float fade = smoothstep(u.post.z * (1.0 - u.post.w), u.post.z, depth);
      vec3 dir = cameraRay(p);
      float turn = (u.misc.y & 256u) != 0u ? 0.0 : u.extra.x;
      float f = fract((atan(dir.x, dir.z) + turn) / 6.2831853 + 0.5) * 8.0 - 0.5;
      int i = int(floor(f + 8.0)) & 7;
      vec3 target = mix(u.horizon[i].rgb, u.horizon[(i + 1) & 7].rgb, fract(f));
      c = mix(c, target, fade * fade * (3.0 - 2.0 * fade));
    }
    if (underwater) {
      writeOutput(p, c);
      return;
    }
    c = splashes(c, imageLoad(currPos, p).xyz, imageLoad(normalImage, p).xyz, depth);
    c = footRipples(c, imageLoad(currPos, p).xyz, imageLoad(normalImage, p).xyz, depth);
    c = ambientLife(c, p, cameraRay(p), depth);
    c = smokePlumes(c, p, cameraRay(p), depth);
    c = swampMist(c, p, cameraRay(p), depth);
    writeOutput(p, precipitation(c, p, depth));
  }
}
