#version 460

// Bright pass of the Normal-mode bloom: the presented image downscaled by four and reduced to
// what glows, written to scratch A. The image is 8-bit display-space, so "bright" is measured
// against a display threshold rather than true HDR luminance; the glow is therefore modest.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D presented;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D bloomA;

layout(push_constant) uniform Push {
  int width;
  int height;
  int pass;
  float exposure;
  float contrast;
  float saturation;
  float temperature;
  float bloom;
  float vignette;
} pc;

const int DOWN = 4;
const float THRESHOLD = 0.75;

void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = ivec2(pc.width, pc.height);
  ivec2 quarter = (size + DOWN - 1) / DOWN;
  if (q.x >= quarter.x || q.y >= quarter.y) {
    return;
  }
  // Four taps across the source block so thin highlights survive the downscale.
  ivec2 base = q * DOWN;
  vec3 c = imageLoad(presented, clamp(base + ivec2(1, 1), ivec2(0), size - 1)).rgb
         + imageLoad(presented, clamp(base + ivec2(3, 1), ivec2(0), size - 1)).rgb
         + imageLoad(presented, clamp(base + ivec2(1, 3), ivec2(0), size - 1)).rgb
         + imageLoad(presented, clamp(base + ivec2(3, 3), ivec2(0), size - 1)).rgb;
  c *= 0.25;
  float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
  float knee = smoothstep(THRESHOLD, THRESHOLD + 0.1, lum);
  imageStore(bloomA, q, vec4(c * knee, 1.0));
}
