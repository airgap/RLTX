#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;
layout(std140, set = 0, binding = 6) uniform Frame {
  vec4 cam;     // camera position, zoom
  vec4 r0;      // inverse rotation rows: view direction to world direction
  vec4 r1;
  vec4 r2;
  vec4 prevCam; // previous camera position, previous zoom
  vec4 p0;      // previous forward rotation rows: world to view
  vec4 p1;
  vec4 p2;
  vec4 sun;     // unit vector toward the sun, intensity
  vec4 sky;     // sky radiance, ambient floor
  vec4 params;  // sun angular radius (radians), exposure, history frames, dynamic history frames
  uvec4 misc;   // frame, flags, width, height
  vec4 extra;   // skybox rotation (radians), flat background colour rgb
  vec4 denoise; // luminance, normal and position sigmas, unused
  vec4 sunColor;
  vec4 path;
  vec4 motion;
} u;
layout(push_constant) uniform Push {
  int pass;
  int step;
  int last;
  int passes;
} pc;
// History ping-pongs between two image sets; the descriptor set selects which is which.
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D prevColor;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D currColor;
layout(set = 0, binding = 9, rgba32f) uniform readonly image2D prevPos;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D currPos;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D sampleImage;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D albedoImage;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D prevMoments;
layout(set = 0, binding = 16, rgba16f) uniform writeonly image2D currMoments;
layout(set = 0, binding = 17, rgba16f) uniform writeonly image2D filterA;

const uint FLAG_PATTERN = 4u;
const uint FLAG_RESET_HISTORY = 8u;
const float VARIANCE_GAMMA = 1.5;
// Below this many accumulated frames the temporal variance estimate is unreliable and a
// spatial estimate over the neighbourhood is used instead.
const float MOMENT_HISTORY_MIN = 4.0;

float luminance(vec3 c) {
  return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Filmic curve (Narkowicz's ACES fit): near-linear midtones with a soft shoulder.
vec3 tonemap(vec3 c) {
  c *= u.params.y;
  return clamp((c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14), 0.0, 1.0);
}

void main() {
  uvec2 px = gl_GlobalInvocationID.xy;
  int w = int(u.misc.z);
  int h = int(u.misc.w);
  if (px.x >= uint(w) || px.y >= uint(h)) {
    return;
  }
  uint flags = u.misc.y;
  if ((flags & FLAG_PATTERN) != 0u) {
    return;
  }

  ivec2 p = ivec2(px);
  vec4 sample_ = imageLoad(sampleImage, p);
  vec4 position = imageLoad(currPos, p);
  // Sky pixels carry display colours already and bypass exposure and tone mapping.
  if (position.w < 0.0) {
    imageStore(currColor, p, vec4(sample_.rgb, 0.0));
    imageStore(currMoments, p, vec4(0.0));
    imageStore(filterA, p, vec4(0.0));
    if (pc.passes == 0) {
      imageStore(outImage, p, vec4(sample_.rgb, 1.0));
    }
    return;
  }

  // Mean and deviation of the surrounding fresh samples bound what history may contribute,
  // so a stale value cannot be dragged across an edge. The same loop yields a spatial
  // variance estimate for pixels with little history.
  vec3 m1 = vec3(0.0);
  vec3 m2 = vec3(0.0);
  float l1 = 0.0;
  float l2 = 0.0;
  float n = 0.0;
  for (int dy = -3; dy <= 3; ++dy) {
    for (int dx = -3; dx <= 3; ++dx) {
      ivec2 q = p + ivec2(dx, dy);
      if (q.x < 0 || q.y < 0 || q.x >= w || q.y >= h) {
        continue;
      }
      if (imageLoad(currPos, q).w < 0.0) {
        continue;
      }
      vec3 c = imageLoad(sampleImage, q).rgb;
      float l = luminance(c);
      if (abs(dx) <= 1 && abs(dy) <= 1) {
        m1 += c;
        m2 += c * c;
      }
      l1 += l;
      l2 += l * l;
      n += 1.0;
    }
  }
  vec3 m1n = m1 / 9.0;
  vec3 sigma = sqrt(max(m2 / 9.0 - m1n * m1n, vec3(0.0)));
  vec3 boxMin = m1n - VARIANCE_GAMMA * sigma;
  vec3 boxMax = m1n + VARIANCE_GAMMA * sigma;
  float spatialMean = l1 / max(n, 1.0);
  float spatialVariance = max(l2 / max(n, 1.0) - spatialMean * spatialMean, 0.0);

  vec3 irradiance = sample_.rgb;
  float lum = luminance(irradiance);
  float count = 0.0;
  vec2 moments = vec2(lum, lum * lum);
  if ((flags & FLAG_RESET_HISTORY) == 0u) {
    vec3 rel = position.xyz - u.prevCam.xyz;
    vec3 v = vec3(dot(u.p0.xyz, rel), dot(u.p1.xyz, rel), dot(u.p2.xyz, rel));
    if (v.z > 1.0) {
      vec2 sp = vec2(float(w), float(h)) * 0.5 + v.xy * u.prevCam.w / v.z;
      float footprint = position.w / u.cam.w;
      float tolerance = 1.0 + 3.0 * footprint / max(abs(sample_.a), 0.1);

      vec2 base = floor(sp - 0.5);
      vec2 f = sp - 0.5 - base;
      vec3 accum = vec3(0.0);
      vec2 accumMoments = vec2(0.0);
      float accumCount = 0.0;
      float weightSum = 0.0;
      for (int ty = 0; ty <= 1; ++ty) {
        for (int tx = 0; tx <= 1; ++tx) {
          ivec2 tap = ivec2(base) + ivec2(tx, ty);
          if (tap.x < 0 || tap.y < 0 || tap.x >= w || tap.y >= h) {
            continue;
          }
          float weight = (tx == 0 ? 1.0 - f.x : f.x) * (ty == 0 ? 1.0 - f.y : f.y);
          if (weight <= 0.0) {
            continue;
          }
          vec4 pp = imageLoad(prevPos, tap);
          if (pp.w < 0.0 || distance(pp.xyz, position.xyz) > tolerance) {
            continue;
          }
          vec4 hc = imageLoad(prevColor, tap);
          accum += hc.rgb * weight;
          accumMoments += imageLoad(prevMoments, tap).xy * weight;
          accumCount += hc.a * weight;
          weightSum += weight;
        }
      }
      if (weightSum > 0.05) {
        vec3 history = clamp(accum / weightSum, boxMin, boxMax);
        float maxCount = sample_.a < 0.0 ? u.params.w : u.params.z;
        count = min(accumCount / weightSum, maxCount - 1.0);
        float alpha = 1.0 / (count + 1.0);
        irradiance = mix(history, sample_.rgb, alpha);
        moments = mix(accumMoments / weightSum, vec2(lum, lum * lum), alpha);
      }
    }
  }
  count += 1.0;

  float variance = count >= MOMENT_HISTORY_MIN
    ? max(moments.y - moments.x * moments.x, 0.0)
    : spatialVariance;

  imageStore(currColor, p, vec4(irradiance, count));
  imageStore(currMoments, p, vec4(moments, 0.0, 0.0));
  imageStore(filterA, p, vec4(irradiance, variance));
  if (pc.passes == 0) {
    vec3 albedo = imageLoad(albedoImage, p).rgb;
    imageStore(outImage, p, vec4(tonemap(albedo * irradiance), 1.0));
  }
}
